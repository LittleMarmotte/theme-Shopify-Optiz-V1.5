<div class="siwak-product-trust" {{ block.shopify_attributes }}>
  <div class="siwak-product-trust__item">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 5 6v5c0 4.8 2.9 8.2 7 10 4.1-1.8 7-5.2 7-10V6l-7-3Z"/><path d="m9 12 2 2 4-5"/></svg>
    <p><strong>{{ block.settings.guarantee_title | escape }}</strong><span>{{ block.settings.guarantee_text | escape }}</span></p>
  </div>
  <div class="siwak-product-trust__item">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="2"/><circle cx="18" cy="18" r="2"/></svg>
    <p><strong>{{ block.settings.shipping_title | escape }}</strong><span>{{ block.settings.shipping_text | escape }}</span></p>
  </div>
</div>

{% stylesheet %}
  .siwak-product-trust {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    width: 100%;
    margin-top: 8px;
    border: 2px solid #171717;
    border-top: 4px solid #e52219;
    background: #f5f1e9;
    color: #171717;
  }
  .siwak-product-trust__item {
    display: flex;
    gap: 12px;
    align-items: center;
    padding: 16px 14px;
  }
  .siwak-product-trust__item + .siwak-product-trust__item { border-left: 1px solid #171717; }
  .siwak-product-trust svg {
    box-sizing: border-box;
    width: 44px;
    height: 44px;
    flex: 0 0 44px;
    padding: 8px;
    background: #e52219;
    fill: none;
    stroke: #fff;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .siwak-product-trust p { display: grid; gap: 5px; margin: 0; line-height: 1.15; color: #171717; }
  .siwak-product-trust strong {
    color: #171717;
    font-family: var(--font-heading--family);
    font-size: 22px;
    font-weight: 700;
    line-height: 1.05;
    text-transform: uppercase;
  }
  .siwak-product-trust span { font-size: 13px; line-height: 1.3; color: #3b3834; }
  @media (max-width: 599px) {
    .siwak-product-trust { grid-template-columns: 1fr; }
    .siwak-product-trust__item { padding: 12px 14px; }
    .siwak-product-trust__item + .siwak-product-trust__item { border-top: 1px solid #171717; border-left: 0; }
    .siwak-product-trust strong { font-size: 21px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Garanties Siwak",
  "settings": [
    { "type": "text", "id": "guarantee_title", "label": "Titre garantie", "default": "Satisfait ou remboursé" },
    { "type": "text", "id": "guarantee_text", "label": "Détail garantie", "default": "Garantie 30 jours, même après ouverture. Si le produit ne te plaît pas, tu peux demander un remboursement." },
    { "type": "text", "id": "shipping_title", "label": "Titre expédition", "default": "Expédié sous 24 h" },
    { "type": "text", "id": "shipping_text", "label": "Détail expédition", "default": "Livraison sous 2 à 3 jours" }
  ],
  "presets": [{ "name": "Garanties Siwak" }]
}
{% endschema %}
