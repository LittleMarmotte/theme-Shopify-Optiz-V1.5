{% liquid
  assign product_resource = closest.product | default: product
  assign subscription_plan = product_resource.selling_plan_groups.first.selling_plans.first
  assign selected_plan_id = block.settings.selling_plan_id | default: subscription_plan.id
  assign case_product = all_products['etui-a-siwak']
  assign case_variant = case_product.variants | where: 'sku', 'OPT-SIW-HLD' | first
  assign unit_price = 12
  if selected_plan_id != blank
    assign unit_price = 10
  endif
%}
<siwak-product-offers class="siwak-product-offers" data-plan="{{ selected_plan_id }}" data-case-available="{{ case_variant.available | default: false }}" {{ block.shopify_attributes }}>
  <fieldset class="siwak-product-offers__fieldset">
    <legend class="siwak-product-offers__legend"><span>{{ block.settings.kicker | escape }}</span><strong>{{ block.settings.heading | escape }}</strong></legend>
    <div class="siwak-product-offers__modes">
      <label><input type="radio" name="siwak-mode-{{ block.id }}" value="subscription" {% if selected_plan_id == blank %}disabled{% else %}checked{% endif %}><strong>Abonnement</strong><span>10 € / boîte à chaque envoi</span></label>
      <label><input type="radio" name="siwak-mode-{{ block.id }}" value="once" {% if selected_plan_id == blank %}checked{% endif %}><strong>Achat unique</strong><span>12 € / boîte</span></label>
    </div>
    <div class="siwak-product-offers__list">
      {% assign quantities = '1,2,4' | split: ',' %}
      {% for count in quantities %}
        {% liquid
          assign quantity = count | plus: 0
          assign sticks = quantity | times: 5
          assign bonus_value = 0
          if quantity >= 2
            assign bonus_value = 8
          endif
          if quantity == 4
            assign bonus_value = bonus_value | plus: 4
          endif
          assign offer_image = block.settings.trial_image | default: product_resource.featured_image
          if quantity == 4
            assign offer_image = block.settings.pack_image | default: offer_image
          endif
        %}
        <article class="siwak-product-offers__ticket" data-ticket="{{ quantity }}">
          <label class="siwak-product-offers__card">
            <input type="radio" name="siwak-quantity-{{ block.id }}" value="{{ quantity }}" aria-labelledby="siwak-title-{{ block.id }}-{{ quantity }} siwak-price-{{ block.id }}-{{ quantity }}" aria-describedby="siwak-teaser-{{ block.id }}-{{ quantity }}" aria-controls="siwak-panel-{{ block.id }}-{{ quantity }}" {% if quantity == 2 %}checked{% endif %}>
            <span class="siwak-product-offers__check" aria-hidden="true"></span>
            {% if offer_image != blank %}
              <span class="siwak-product-offers__box-image{% if quantity == 2 %} siwak-product-offers__box-image--duo{% endif %}" aria-hidden="true">
                {{ offer_image | image_url: width: 180 | image_tag: loading: 'lazy', alt: '' }}
                {% if quantity == 2 %}{{ offer_image | image_url: width: 180 | image_tag: loading: 'lazy', alt: '' }}{% endif %}
              </span>
            {% endif %}
            <span class="siwak-product-offers__copy"><strong id="siwak-title-{{ block.id }}-{{ quantity }}">{{ 'siwak_offer.boxes' | t: count: quantity }}</strong><span>{{ 'siwak_offer.sticks' | t: count: sticks }}</span></span>
            <span class="siwak-product-offers__price">
              {% if bonus_value > 0 %}
                <span class="siwak-product-offers__value-line" title="{{ 'siwak_offer.first_delivery_value' | t | escape }}"><span>{{ 'siwak_offer.total_value' | t }}</span><s data-value-quantity="{{ quantity }}" data-bonus-value="{{ bonus_value }}">{{ quantity | times: unit_price | plus: bonus_value }} €</s></span>
              {% endif %}
              <span class="siwak-product-offers__price-line"><strong id="siwak-price-{{ block.id }}-{{ quantity }}" data-price="{{ quantity }}">{{ quantity | times: unit_price }} €</strong>{% if quantity == 4 %}<span class="siwak-product-offers__extra-gift">{{ 'siwak_offer.extra_gift' | t }}</span>{% endif %}</span>
              <small data-unit>{{ unit_price }} € / boîte</small>
            </span>
            <span class="siwak-product-offers__teaser" id="siwak-teaser-{{ block.id }}-{{ quantity }}">
              {% if quantity == 1 %}
                <span class="siwak-product-offers__teaser-note">{{ 'siwak_offer.no_gift' | t }}</span>
              {% else %}
                <span>✓ {{ 'siwak_offer.case_teaser' | t }}</span>
                {% if quantity == 4 %}<span>✓ {{ 'siwak_offer.choice_teaser' | t }}</span><span>✓ {{ 'siwak_offer.shipping_title' | t }}</span>{% endif %}
              {% endif %}
            </span>
            <span class="siwak-product-offers__expand" aria-hidden="true">⌄</span>
          </label>
          <div class="siwak-product-offers__panel" id="siwak-panel-{{ block.id }}-{{ quantity }}" data-panel {% unless quantity == 2 %}hidden{% endunless %}>
            <ul class="siwak-product-offers__reassurance">
              {% if quantity == 4 %}<li>{{ 'siwak_offer.shipping_and_gifts' | t }}</li>{% endif %}
              <li>{{ 'siwak_offer.guarantee' | t }}</li>
              <li data-subscription-only {% if selected_plan_id == blank %}hidden{% endif %}>{{ 'siwak_offer.subscription_flexibility' | t }}</li>
            </ul>
            <h3 class="siwak-product-offers__panel-title">{{ 'siwak_offer.your_benefits' | t }}</h3>
            {% render 'siwak-offer-rewards', quantity: quantity, block: block %}
            {% if quantity == 4 %}
              <button type="button" class="siwak-product-offers__gift-open">+ {{ 'siwak_offer.choose_gift' | t }} → <span data-gift-summary></span></button>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  </fieldset>
  <p data-renewal hidden>Renouvellement à 10 € par boîte. {{ subscription_plan.name | escape }}. Les conditions s’affichent au paiement.</p>
  {% if selected_plan_id == blank %}<p class="siwak-product-offers__setup-note">Abonnement bientôt disponible.</p>{% endif %}
  <dialog class="siwak-product-offers__dialog" aria-labelledby="gift-title-{{ block.id }}">
    <header><h2 id="gift-title-{{ block.id }}">Choisis ton cadeau Optiz</h2><button type="button" data-close aria-label="Fermer">×</button></header>
    <div class="siwak-product-offers__gifts">
      {% for i in (1..6) %}
        {% liquid
          assign gift_key = 'gift_' | append: i
          assign gift = block.settings[gift_key]
          assign image_key = gift_key | append: '_image'
          assign gift_image = block.settings[image_key] | default: gift.featured_image
          assign sku_key = gift_key | append: '_sku'
          assign gift_variant = gift.selected_or_first_available_variant
          if block.settings[sku_key] != blank
            assign gift_variant = gift.variants | where: 'sku', block.settings[sku_key] | first
          endif
          assign gift_available = gift_variant.available
          if gift_variant == blank
            assign gift_available = false
          elsif gift_variant.inventory_management != blank and gift_variant.inventory_quantity <= 0
            assign gift_available = false
          endif
        %}
        {% if gift != blank %}
          <label class="siwak-product-offers__gift"><span class="siwak-product-offers__visual">{% if gift_image != blank %}{{ gift_image | image_url: width: 240 | image_tag: widths: '80, 160, 240', sizes: '80px', loading: 'lazy', alt: gift.title }}{% else %}<span aria-hidden="true">Image<br>cadeau</span>{% endif %}</span><span><strong>{{ gift.title | escape }}{% unless gift_variant.title == 'Default Title' %} {{ gift_variant.title | escape }}{% endunless %}</strong><br>OFFERT <s>{{ gift_variant.price | money }}</s></span><input type="radio" name="siwak-gift-{{ block.id }}" value="{{ gift_variant.id }}" data-title="{{ gift.title | escape }}" {% unless gift_available %}disabled{% endunless %}><span>{% if gift_available %}Choisir{% else %}Épuisé{% endif %}</span></label>
        {% endif %}
      {% endfor %}
      {% if block.settings.gift_1 == blank and block.settings.gift_2 == blank and block.settings.gift_3 == blank and block.settings.gift_4 == blank and block.settings.gift_5 == blank and block.settings.gift_6 == blank %}<p>La sélection de cadeaux arrive bientôt.</p>{% endif %}
    </div>
    <footer><span data-gift-count>0 / 1 cadeau sélectionné</span><button type="button" data-close>Annuler</button><button type="button" data-confirm>Confirmer</button></footer>
  </dialog>
</siwak-product-offers>
{% stylesheet %}
  .siwak-product-offers {
    --offer-red: #e52219;
    --offer-ink: #171717;
    --offer-paper: #f5f1e9;
    display: block;
    width: 100%;
  }

  .siwak-product-offers__fieldset {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .siwak-product-offers__legend {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    width: 100%;
    margin: 0 0 12px;
    padding: 0;
    background: var(--offer-ink);
    color: #fff;
  }

  .siwak-product-offers__legend span {
    align-self: stretch;
    display: grid;
    place-items: center;
    padding: 8px 10px;
    background: var(--offer-red);
    font-size: 0.68rem;
    font-weight: 850;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .siwak-product-offers__legend strong {
    padding: 8px 12px;
    font-family: var(--font-heading--family);
    font-size: 1.08rem;
    letter-spacing: 0.02em;
    line-height: 1;
    text-transform: uppercase;
  }

  .siwak-product-offers__list {
    display: grid;
    gap: 10px;
  }

  .siwak-product-offers__card {
    position: relative;
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr) auto;
    gap: 12px;
    align-items: center;
    min-height: 86px;
    padding: 13px 14px;
    border: 2px solid var(--offer-ink);
    background: #fff;
    color: var(--offer-ink);
    box-shadow: 4px 4px 0 var(--offer-ink);
    cursor: pointer;
    transition: transform 120ms ease, box-shadow 120ms ease, background-color 120ms ease;
  }

  .siwak-product-offers__card:hover {
    transform: translate(-1px, -1px);
    box-shadow: 6px 6px 0 var(--offer-ink);
  }

  .siwak-product-offers__card:has(input:checked) {
    background: var(--offer-paper);
    box-shadow: 7px 7px 0 var(--offer-red);
    transform: translate(-2px, -2px);
  }

  .siwak-product-offers__card:has(input:focus-visible) {
    outline: 3px solid var(--offer-red);
    outline-offset: 3px;
  }

  .siwak-product-offers__card > input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .siwak-product-offers__check {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border: 2px solid currentcolor;
    background: transparent;
  }

  .siwak-product-offers__card:has(input:checked) .siwak-product-offers__check {
    border-color: var(--offer-red);
    background: var(--offer-red);
    color: #fff;
  }

  .siwak-product-offers__card:has(input:checked) .siwak-product-offers__check::after {
    content: '✓';
    font-size: 1rem;
    font-weight: 900;
    line-height: 1;
  }

  .siwak-product-offers__copy,
  .siwak-product-offers__price {
    display: grid;
    min-width: 0;
  }

  .siwak-product-offers__copy small {
    margin-bottom: 2px;
    color: var(--offer-red);
    font-size: 0.65rem;
    font-weight: 850;
    letter-spacing: 0.09em;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .siwak-product-offers__copy > strong {
    font-family: var(--font-heading--family);
    font-size: 1.27rem;
    letter-spacing: 0.01em;
    line-height: 1;
    text-transform: uppercase;
  }

  .siwak-product-offers__copy > span {
    margin-top: 4px;
    font-size: 0.78rem;
    line-height: 1.25;
    opacity: 0.72;
  }

  .siwak-product-offers__copy em {
    justify-self: start;
    margin-top: 6px;
    padding: 3px 6px;
    background: var(--offer-ink);
    color: #fff;
    font-size: 0.65rem;
    font-style: normal;
    font-weight: 800;
    letter-spacing: 0.04em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .siwak-product-offers__price {
    justify-items: end;
    text-align: right;
  }

  .siwak-product-offers__price strong {
    font-family: var(--font-heading--family);
    font-size: 1.9rem;
    line-height: 0.9;
  }

  .siwak-product-offers__price small {
    max-width: 90px;
    margin-top: 5px;
    font-size: 0.66rem;
    font-weight: 750;
    line-height: 1.15;
  }

  .siwak-product-offers__card--subscription {
    margin-top: 8px;
    background: var(--offer-paper);
    color: var(--offer-ink);
  }

  .siwak-product-offers__card--subscription:has(input:checked) {
    border-color: var(--offer-red);
    background: var(--offer-paper);
    box-shadow: 5px 5px 0 var(--offer-ink);
  }

  .siwak-product-offers__card--subscription .siwak-product-offers__copy em {
    background: var(--offer-ink);
    color: #fff;
  }

  .siwak-product-offers__badge {
    position: absolute;
    top: -10px;
    right: 12px;
    padding: 4px 8px;
    border: 2px solid var(--offer-ink);
    background: var(--offer-paper);
    color: var(--offer-ink);
    font-size: 0.62rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    line-height: 1;
    text-transform: uppercase;
    transform: rotate(1.5deg);
  }

  .siwak-product-offers__card--disabled {
    cursor: not-allowed;
    filter: grayscale(0.2);
    opacity: 0.58;
  }

  .siwak-product-offers__card--disabled:hover {
    box-shadow: 4px 4px 0 var(--offer-ink);
    transform: none;
  }

  .siwak-product-offers__setup-note {
    margin: 11px 0 0;
    padding-left: 10px;
    border-left: 3px solid var(--offer-red);
    font-size: 0.72rem;
    line-height: 1.35;
    opacity: 0.72;
  }

  /* Reserve the strong red surface for the action beneath the offer cards. */
  .product-details:has(.siwak-product-offers) .product-form-buttons {
    margin-block-start: 12px;
    padding-inline: 6px;
    padding-block: 8px 12px;
  }

  .product-details:has(.siwak-product-offers) .product-form-buttons .add-to-cart-button {
    --button-background: #e52219;
    --button-color: #f5f1e9;
    --button-border-color: transparent;
    --button-hover-background: #c51b14;
    --button-hover-color: #f5f1e9;
    width: 100%;
    min-height: 60px;
    height: auto;
    padding: 16px 18px;
    border: 0;
    border-radius: 0;
    background: #e52219;
    box-shadow: 0 6px 0 #000;
    rotate: 0deg;
    font-family: var(--font-heading--family);
    font-size: clamp(1.2rem, 5.4vw, 1.65rem);
    font-weight: 700;
    line-height: 1.1;
    text-transform: uppercase;
    transition: background-color 120ms ease, box-shadow 120ms ease, translate 120ms ease;
  }

  .product-details:has(.siwak-product-offers) .product-form-buttons .add-to-cart-button:not([data-added='true']):not(:disabled) {
    color: #f5f1e9;
  }

  .product-details:has(.siwak-product-offers) .product-form-buttons .add-to-cart-button:not(:disabled):hover {
    background: #c51b14;
  }

  .product-details:has(.siwak-product-offers) .product-form-buttons .add-to-cart-button:not(:disabled):active {
    translate: 0 3px;
    box-shadow: 0 3px 0 #000;
  }

  .product-details:has(.siwak-product-offers) .product-form-buttons .add-to-cart-button:focus-visible {
    outline: 3px solid #171717;
    outline-offset: 5px;
  }

  .product-details:has(.siwak-product-offers) .product-form-buttons .add-to-cart-button:disabled {
    background: #dedbd5;
    color: #65615a;
    box-shadow: 3px 3px 0 #aaa;
    cursor: not-allowed;
  }

  @media (max-width: 749px) {
    .product-details:has(.siwak-product-offers) .product-form-buttons > span:has(add-to-cart-component) {
      flex: 1 1 100%;
      min-width: 0;
    }

    .product-details:has(.siwak-product-offers) .product-form-buttons > .quantity-selector-wrapper {
      margin-block-end: 6px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .product-details:has(.siwak-product-offers) .product-form-buttons .add-to-cart-button {
      transition: none;
    }
  }

  @media (max-width: 420px) {
    .siwak-product-offers__card {
      grid-template-columns: 22px minmax(0, 1fr) auto;
      gap: 9px;
      padding: 12px 10px;
    }

    .siwak-product-offers__copy > strong { font-size: 1.12rem; }
    .siwak-product-offers__price strong { font-size: 1.62rem; }
    .siwak-product-offers__price small { max-width: 72px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .siwak-product-offers__card { transition: none; }
  }

.product-details:has(.siwak-product-offers) .quantity-selector-wrapper, .product-details:has(.siwak-product-offers) .accelerated-checkout-block {display:none}
.siwak-product-offers__modes {display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:16px}
.siwak-product-offers__modes label {border:2px solid #171717;padding:12px;display:grid;gap:5px;cursor:pointer}
.siwak-product-offers__modes label:has(:checked) {background:#171717;color:white;box-shadow:4px 4px 0 #e52219}
.siwak-product-offers__modes label:has(:disabled) {opacity:.5;cursor:not-allowed}
.siwak-product-offers__modes strong {font-family:var(--font-heading--family);font-size:1.3rem;text-transform:uppercase}
.siwak-product-offers__modes span {font-size:.75rem}
.siwak-product-offers__card {grid-template-columns:22px 60px minmax(0,1fr) auto;box-shadow:none!important;transform:none!important}
.siwak-product-offers__ticket {border:2px solid #171717}
.siwak-product-offers__ticket .siwak-product-offers__card {border:0}
.siwak-product-offers__ticket:has(.siwak-product-offers__card input:checked) {box-shadow:5px 5px 0 #e52219}
.siwak-product-offers__visual {width:60px;aspect-ratio:1;display:grid;place-items:center;background:#f5f1e9;border:1px dashed #171717;font-size:.65rem;text-align:center;overflow:hidden}
.siwak-product-offers__visual img {width:100%;height:100%;object-fit:contain}
.siwak-product-offers__benefits {padding:12px 16px;font-size:.8rem;line-height:1.8;display:none}
.siwak-product-offers__gift-open {width:100%;padding:14px;background:#171717;color:white;border:0;text-align:left;font-family:var(--font-heading--family);font-size:1.2rem;cursor:pointer;display:none}
.siwak-product-offers__ticket:has(input:checked) .siwak-product-offers__benefits,.siwak-product-offers__ticket:has(input:checked) .siwak-product-offers__gift-open {display:block}
.siwak-product-offers__dialog {width:min(800px,calc(100% - 24px));max-height:85dvh;padding:0;background:white;color:#171717;border:2px solid #171717}
.siwak-product-offers__dialog[open] {display:flex;flex-direction:column}
.siwak-product-offers__dialog::backdrop {background:rgb(0 0 0 / .6)}
.siwak-product-offers__dialog header,.siwak-product-offers__dialog footer {display:flex;align-items:center;gap:12px;padding:16px;border-bottom:1px solid #171717}
.siwak-product-offers__dialog h2 {margin:0;flex:1;font-size:1.6rem}
.siwak-product-offers__dialog button {padding:10px 16px;border:1px solid #171717;background:#171717;color:white;cursor:pointer}
.siwak-product-offers__dialog footer {border-top:1px solid #171717;flex-wrap:wrap}
.siwak-product-offers__dialog footer>span {flex:1;font-size:.8rem}
.siwak-product-offers__gifts {overflow:auto;padding:16px}
.siwak-product-offers__gift {display:flex;align-items:center;gap:16px;padding:16px 0;border-bottom:1px solid #ddd;cursor:pointer}
.siwak-product-offers__gift>span:nth-child(2) {flex:1}
.siwak-product-offers__gift:has(:checked) {color:#b51c15}
.siwak-product-offers button:focus-visible,.siwak-product-offers label:has(:focus-visible) {outline:3px solid #e52219;outline-offset:3px}
@media(max-width:420px) {.siwak-product-offers__ticket .siwak-product-offers__card {grid-template-columns:18px 40px minmax(0,1fr) auto;gap:8px}.siwak-product-offers__card .siwak-product-offers__visual {width:40px}.siwak-product-offers__gift {gap:8px;font-size:.8rem}}

.siwak-product-offers [hidden] {display:none !important}
.siwak-product-offers__list {display:grid;grid-template-columns:minmax(0,1fr);gap:16px}
.siwak-product-offers__ticket {min-width:0;background:#fff}
.siwak-product-offers__ticket:has(.siwak-product-offers__card input:checked) {background:var(--offer-paper);box-shadow:5px 5px 0 var(--offer-red)}
.siwak-product-offers__ticket .siwak-product-offers__card {grid-template-columns:22px 64px minmax(0,1fr) auto;gap:9px 12px;padding:16px;min-height:96px;background:transparent}
.siwak-product-offers__ticket .siwak-product-offers__card:not(:has(.siwak-product-offers__box-image)) {grid-template-columns:22px minmax(0,1fr) auto}
.siwak-product-offers__ticket .siwak-product-offers__check {grid-column:1;grid-row:1}
.siwak-product-offers__ticket .siwak-product-offers__copy {grid-column:3;grid-row:1}
.siwak-product-offers__ticket .siwak-product-offers__price {grid-column:4;grid-row:1}
.siwak-product-offers__card:not(:has(.siwak-product-offers__box-image)) .siwak-product-offers__copy {grid-column:2}
.siwak-product-offers__card:not(:has(.siwak-product-offers__box-image)) .siwak-product-offers__price {grid-column:3}
.siwak-product-offers__box-image {grid-column:2;display:flex;align-items:center;justify-content:center;width:64px;height:72px;grid-row:1}
.siwak-product-offers__box-image img {width:100%;height:100%;object-fit:contain}
.siwak-product-offers__box-image--duo img {width:55%;margin-inline:-3px}
.siwak-product-offers__ticket .siwak-product-offers__copy>strong {font-size:1.55rem}
.siwak-product-offers__ticket .siwak-product-offers__price strong {font-size:2rem}
.siwak-product-offers__ticket .siwak-product-offers__price {max-width:135px;gap:5px}
.siwak-product-offers__value-line {display:flex;flex-wrap:wrap;justify-content:flex-end;align-items:baseline;gap:3px 5px;color:#65615a;font-size:.65rem;line-height:1.2}
.siwak-product-offers__value-line s {font-size:.95rem;font-weight:700;white-space:nowrap}
.siwak-product-offers__price-line {display:flex;flex-wrap:wrap;justify-content:flex-end;align-items:baseline;gap:5px}
.siwak-product-offers__extra-gift {font-size:.72rem;font-weight:800;white-space:nowrap;color:var(--offer-red)}
.siwak-product-offers__teaser {grid-column:2/-1;display:flex;flex-direction:column;align-items:flex-start;gap:5px;padding-right:18px;font-size:.73rem;line-height:1.35;font-weight:700}
.siwak-product-offers__teaser>span {display:inline-flex;align-items:center;gap:6px}
.siwak-product-offers__teaser-note {color:#65615a;font-weight:400}
.siwak-product-offers__expand {position:absolute;right:14px;bottom:12px;font-size:1.15rem;line-height:1;transition:rotate 150ms ease}
.siwak-product-offers__ticket:has(.siwak-product-offers__card input:checked) .siwak-product-offers__expand {rotate:180deg}
.siwak-product-offers__panel {border-top:1px solid #d0cbc2}
.siwak-product-offers__reassurance {list-style:none;margin:0;padding:16px 16px 0;display:grid;gap:10px;font-size:.85rem;line-height:1.4}
.siwak-product-offers__reassurance li {display:flex;align-items:baseline;gap:9px}
.siwak-product-offers__reassurance li::before {content:'✓';color:var(--offer-red);font-weight:900}
.siwak-product-offers__panel-title {margin:0;padding:20px 16px 0;font-family:var(--font-heading--family);font-size:1.15rem;text-transform:uppercase}
.siwak-product-offers__rewards {display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;padding:24px 16px 18px}
.siwak-product-offers__reward {position:relative;min-width:0;margin:0;display:flex;flex-direction:column}
.siwak-product-offers__reward-media {width:100%;aspect-ratio:1;border:2px solid var(--offer-ink);background:#fff;display:grid;place-items:center;overflow:hidden}
.siwak-product-offers__reward-media>img {width:100%;height:100%;object-fit:cover;object-position:50% 35%}
.siwak-product-offers__reward figcaption {padding-top:9px;font-weight:800;font-size:.82rem;line-height:1.3}
.siwak-product-offers__reward figcaption small {display:block;margin-top:5px;font-size:.67rem;font-weight:400;line-height:1.35}
.siwak-product-offers__stamp {position:absolute;z-index:1;top:-10px;left:5px;padding:4px 6px;background:var(--offer-ink);color:#fff;font-size:.61rem;font-weight:800;line-height:1.2}
.siwak-product-offers__reward--locked .siwak-product-offers__reward-media {filter:grayscale(1);opacity:.45;border-color:#777}
.siwak-product-offers__reward--locked .siwak-product-offers__stamp {background:#dedbd5;color:#444}
.siwak-product-offers__reward--locked figcaption {color:#65615a}
.siwak-product-offers__unlock {font-weight:700 !important;color:#57534e}
.siwak-product-offers__gift-preview {width:100%;height:100%;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));align-content:center;gap:4px;padding:6px}
.siwak-product-offers__gift-preview img {width:100%;height:auto;aspect-ratio:1;object-fit:contain}
.siwak-product-offers__gift-preview img:nth-child(n+5) {display:none}
.siwak-product-offers__shipping-art {width:80%;height:auto;color:var(--offer-ink)}
.siwak-product-offers__panel .siwak-product-offers__gift-open {display:block;line-height:1.25}
.siwak-product-offers__modes {grid-template-columns:repeat(2,minmax(0,1fr))}
.siwak-product-offers__modes label {min-width:0}
@media(max-width:420px) {
  .siwak-product-offers__ticket .siwak-product-offers__card {grid-template-columns:18px 42px minmax(0,1fr) auto;gap:8px;padding:14px 10px}
  .siwak-product-offers__box-image {width:42px;height:56px}
  .siwak-product-offers__ticket .siwak-product-offers__copy>strong {font-size:1.3rem}
  .siwak-product-offers__ticket .siwak-product-offers__price strong {font-size:1.8rem}
  .siwak-product-offers__ticket .siwak-product-offers__price {max-width:105px}
  .siwak-product-offers__extra-gift {font-size:.65rem}
  .siwak-product-offers__price small {max-width:none;font-size:.6rem}
  .siwak-product-offers__teaser {font-size:.67rem;gap:5px 8px}
  .siwak-product-offers__rewards {padding:24px 10px 16px;gap:7px}
  .siwak-product-offers__reward figcaption {font-size:.74rem}
  .siwak-product-offers__reward figcaption small {font-size:.63rem}
  .siwak-product-offers__stamp {font-size:.54rem;left:2px;padding:4px}
}
@media(prefers-reduced-motion:reduce) {.siwak-product-offers__expand {transition:none}}
{% endstylesheet %}

{% javascript %}
class SiwakProductOffers extends HTMLElement {
  connectedCallback() {
    this.initFrame = requestAnimationFrame(() => this.initialize());
  }
  initialize() {
    if (!this.isConnected) return;
    this.controller = new AbortController();
    const options = {signal:this.controller.signal};
    this.dialog = this.querySelector('dialog');
    this.gift = null;
    this.addEventListener('change', () => {
      this.syncForm();
      this.querySelector('[data-gift-count]').textContent = `${this.querySelector('.siwak-product-offers__gift input:checked') ? 1 : 0} / 1 cadeau sélectionné`;
    }, options);
    this.querySelector('.siwak-product-offers__gift-open').addEventListener('click', () => {
      this.querySelectorAll('.siwak-product-offers__gift input').forEach(input => input.checked = input.value === this.gift?.value);
      this.querySelector('[data-gift-count]').textContent = `${this.gift ? 1 : 0} / 1 cadeau sélectionné`;
      this.dialog.showModal();
    }, options);
    this.querySelectorAll('[data-close]').forEach(button => button.addEventListener('click',()=>this.dialog.close(),options));
    this.querySelector('[data-confirm]').addEventListener('click', () => {
      const input = this.querySelector('.siwak-product-offers__gift input:checked');
      this.gift = input ? {value:input.value,title:input.dataset.title} : null;
      this.querySelector('[data-gift-summary]').textContent = this.gift?.title || '';
      this.syncForm();
      this.dialog.close();
    }, options);
    this.form = this.closest('.shopify-section')?.querySelector('product-form-component form');
    this.form?.addEventListener('submit', (event) => {
      this.syncForm();
      if (this.querySelector('input[name^="siwak-quantity"]:checked')?.value === '4' && !this.gift) {
        event.preventDefault();
        event.stopImmediatePropagation();
        this.dialog.showModal();
      }
    }, {...options,capture:true});
    this.observer = new MutationObserver(()=>this.syncForm());
    if (this.form) this.observer.observe(this.form,{childList:true,subtree:true});
    this.syncForm();
  }
  disconnectedCallback() {cancelAnimationFrame(this.initFrame);this.controller?.abort();this.observer?.disconnect();}
  syncForm() {
    if (!this.form) return;
    const quantity = this.querySelector('input[name^="siwak-quantity"]:checked')?.value || '2';
    const subscription = this.querySelector('input[name^="siwak-mode"]:checked')?.value === 'subscription';
    let input = this.form.querySelector('[name="quantity"]');
    if (!input) {input=document.createElement('input');input.type='hidden';input.name='quantity';this.form.append(input);}
    input.value=quantity;
    const setHidden = (name,value) => {
      let field = Array.from(this.form.elements).find(el=>el.name===name);
      if (!value) {field?.remove();return;}
      if (!field) {field=document.createElement('input');field.type='hidden';field.name=name;this.form.append(field);}
      field.value=value;
    };
    setHidden('selling_plan',subscription ? this.dataset.plan : '');
    // The form adds the chosen gift without a selling plan; eligibility is enforced by Shopify.
    setHidden('properties[Cadeau choisi]',quantity==='4' ? this.gift?.title : '');
    setHidden('properties[_optiz_gift_variant]',quantity==='4' ? this.gift?.value : '');
    this.querySelectorAll('[data-price]').forEach(el=>el.textContent=`${Number(el.dataset.price)*(subscription?10:12)} €`);
    this.querySelectorAll('[data-value-quantity]').forEach(element => {
      const value = Number(element.dataset.valueQuantity) * (subscription ? 10 : 12) + Number(element.dataset.bonusValue);
      element.textContent = `${value} €`;
    });
    this.querySelectorAll('[data-unit]').forEach(el=>el.textContent=`${subscription?10:12} € / boîte`);
    this.querySelector('[data-renewal]').hidden=!subscription;
    this.querySelectorAll('[data-subscription-only]').forEach(element => element.hidden = !subscription);
    this.querySelectorAll('[data-ticket]').forEach(ticket => {
      ticket.querySelector('[data-panel]').hidden = ticket.dataset.ticket !== quantity;
    });
  }
}
if (!customElements.get('siwak-product-offers')) customElements.define('siwak-product-offers',SiwakProductOffers);
{% endjavascript %}
