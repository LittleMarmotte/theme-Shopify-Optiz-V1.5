{% liquid
  assign product_resource = closest.product | default: product
  assign subscription_plan = product_resource.selling_plan_groups.first.selling_plans.first
  assign selected_plan_id = block.settings.selling_plan_id | default: subscription_plan.id
%}
<siwak-product-offers class="siwak-product-offers" data-plan="{{ selected_plan_id }}" {{ block.shopify_attributes }}>
  <fieldset class="siwak-product-offers__fieldset">
    <legend class="siwak-product-offers__legend"><span>{{ block.settings.kicker | escape }}</span><strong>{{ block.settings.heading | escape }}</strong></legend>
    <div class="siwak-product-offers__modes">
      <label><input type="radio" name="siwak-mode-{{ block.id }}" value="subscription" {% if selected_plan_id == blank %}disabled{% endif %}><strong>Abonnement</strong><span>10 € / boîte à chaque envoi</span></label>
      <label><input type="radio" name="siwak-mode-{{ block.id }}" value="once" checked><strong>Achat unique</strong><span>12 € / boîte</span></label>
    </div>
    <div class="siwak-product-offers__list">
      {% for count in (1..2) %}
        {% liquid
          assign quantity = 1
          assign image = block.settings.trial_image
          if count == 2
            assign quantity = 4
            assign image = block.settings.pack_image
          endif
        %}
        <article class="siwak-product-offers__ticket" data-ticket="{{ quantity }}">
          <label class="siwak-product-offers__card">
            <input type="radio" name="siwak-quantity-{{ block.id }}" value="{{ quantity }}" {% if quantity == 4 %}checked{% endif %}>
            <span class="siwak-product-offers__check" aria-hidden="true"></span>
            <span class="siwak-product-offers__visual">
              {% if image != blank %}{{ image | image_url: width: 160 | image_tag: loading: 'lazy', alt: 'Boîtes de Siwak Optiz' }}{% else %}<span aria-hidden="true">Image<br>{{ quantity }} boîte{% if quantity == 4 %}s{% endif %}</span>{% endif %}
            </span>
            <span class="siwak-product-offers__copy"><strong>{{ quantity }} boîte{% if quantity == 4 %}s{% endif %}</strong><span>{% if quantity == 4 %}20{% else %}5{% endif %} siwaks</span>{% if quantity == 4 %}<em>1 cadeau au choix</em>{% endif %}</span>
            <span class="siwak-product-offers__price"><strong data-price="{{ quantity }}">{% if quantity == 4 %}48{% else %}12{% endif %} €</strong><small data-unit>12 € / boîte</small></span>
          </label>
          {% if quantity == 4 %}
            <div class="siwak-product-offers__benefits">✓ Livraison à moitié prix<br>✓ 1 produit Optiz offert au premier envoi</div>
            <button type="button" class="siwak-product-offers__gift-open">+ Choisir mon cadeau → <span data-gift-summary></span></button>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </fieldset>
  <p data-renewal hidden>Renouvellement à 10 € par boîte. {{ subscription_plan.name | escape }}. Les conditions s’affichent au paiement.</p>
  {% if selected_plan_id == blank %}<p class="siwak-product-offers__setup-note">Abonnement bientôt disponible.</p>{% endif %}
  <dialog class="siwak-product-offers__dialog" aria-labelledby="gift-title-{{ block.id }}">
    <header><h2 id="gift-title-{{ block.id }}">Choisis ton cadeau Optiz</h2><button type="button" data-close aria-label="Fermer">×</button></header>
    <div class="siwak-product-offers__gifts">
      {% for i in (1..6) %}
        {% liquid
          assign gift_key = 'gift_' | append: i
          assign gift = block.settings[gift_key]
          assign sku_key = gift_key | append: '_sku'
          assign gift_variant = gift.selected_or_first_available_variant
          if block.settings[sku_key] != blank
            assign gift_variant = gift.variants | where: 'sku', block.settings[sku_key] | first
          endif
          assign gift_available = gift_variant.available
          if gift_variant == blank
            assign gift_available = false
          elsif gift_variant.inventory_management != blank and gift_variant.inventory_quantity <= 0
            assign gift_available = false
          endif
        %}
        {% if gift != blank %}
          <label class="siwak-product-offers__gift"><span class="siwak-product-offers__visual" aria-hidden="true">Image<br>cadeau</span><span><strong>{{ gift.title | escape }}{% unless gift_variant.title == 'Default Title' %} {{ gift_variant.title | escape }}{% endunless %}</strong><br>OFFERT <s>{{ gift_variant.price | money }}</s></span><input type="radio" name="siwak-gift-{{ block.id }}" value="{{ gift_variant.id }}" data-title="{{ gift.title | escape }}" {% unless gift_available %}disabled{% endunless %}><span>{% if gift_available %}Choisir{% else %}Épuisé{% endif %}</span></label>
        {% endif %}
      {% endfor %}
      {% if block.settings.gift_1 == blank and block.settings.gift_2 == blank and block.settings.gift_3 == blank and block.settings.gift_4 == blank and block.settings.gift_5 == blank and block.settings.gift_6 == blank %}<p>La sélection de cadeaux arrive bientôt.</p>{% endif %}
    </div>
    <footer><span data-gift-count>0 / 1 cadeau sélectionné</span><button type="button" data-close>Annuler</button><button type="button" data-confirm>Confirmer</button></footer>
  </dialog>
</siwak-product-offers>
{% stylesheet %}
  .siwak-product-offers {
    --offer-red: #e52219;
    --offer-ink: #171717;
    --offer-paper: #f5f1e9;
    display: block;
    width: 100%;
  }

  .siwak-product-offers__fieldset {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .siwak-product-offers__legend {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    width: 100%;
    margin: 0 0 12px;
    padding: 0;
    background: var(--offer-ink);
    color: #fff;
  }

  .siwak-product-offers__legend span {
    align-self: stretch;
    display: grid;
    place-items: center;
    padding: 8px 10px;
    background: var(--offer-red);
    font-size: 0.68rem;
    font-weight: 850;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .siwak-product-offers__legend strong {
    padding: 8px 12px;
    font-family: var(--font-heading--family);
    font-size: 1.08rem;
    letter-spacing: 0.02em;
    line-height: 1;
    text-transform: uppercase;
  }

  .siwak-product-offers__list {
    display: grid;
    gap: 10px;
  }

  .siwak-product-offers__card {
    position: relative;
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr) auto;
    gap: 12px;
    align-items: center;
    min-height: 86px;
    padding: 13px 14px;
    border: 2px solid var(--offer-ink);
    background: #fff;
    color: var(--offer-ink);
    box-shadow: 4px 4px 0 var(--offer-ink);
    cursor: pointer;
    transition: transform 120ms ease, box-shadow 120ms ease, background-color 120ms ease;
  }

  .siwak-product-offers__card:hover {
    transform: translate(-1px, -1px);
    box-shadow: 6px 6px 0 var(--offer-ink);
  }

  .siwak-product-offers__card:has(input:checked) {
    background: var(--offer-paper);
    box-shadow: 7px 7px 0 var(--offer-red);
    transform: translate(-2px, -2px);
  }

  .siwak-product-offers__card:has(input:focus-visible) {
    outline: 3px solid var(--offer-red);
    outline-offset: 3px;
  }

  .siwak-product-offers__card > input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .siwak-product-offers__check {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border: 2px solid currentcolor;
    background: transparent;
  }

  .siwak-product-offers__card:has(input:checked) .siwak-product-offers__check {
    border-color: var(--offer-red);
    background: var(--offer-red);
    color: #fff;
  }

  .siwak-product-offers__card:has(input:checked) .siwak-product-offers__check::after {
    content: '✓';
    font-size: 1rem;
    font-weight: 900;
    line-height: 1;
  }

  .siwak-product-offers__copy,
  .siwak-product-offers__price {
    display: grid;
    min-width: 0;
  }

  .siwak-product-offers__copy small {
    margin-bottom: 2px;
    color: var(--offer-red);
    font-size: 0.65rem;
    font-weight: 850;
    letter-spacing: 0.09em;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .siwak-product-offers__copy > strong {
    font-family: var(--font-heading--family);
    font-size: 1.27rem;
    letter-spacing: 0.01em;
    line-height: 1;
    text-transform: uppercase;
  }

  .siwak-product-offers__copy > span {
    margin-top: 4px;
    font-size: 0.78rem;
    line-height: 1.25;
    opacity: 0.72;
  }

  .siwak-product-offers__copy em {
    justify-self: start;
    margin-top: 6px;
    padding: 3px 6px;
    background: var(--offer-ink);
    color: #fff;
    font-size: 0.65rem;
    font-style: normal;
    font-weight: 800;
    letter-spacing: 0.04em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .siwak-product-offers__price {
    justify-items: end;
    text-align: right;
  }

  .siwak-product-offers__price strong {
    font-family: var(--font-heading--family);
    font-size: 1.9rem;
    line-height: 0.9;
  }

  .siwak-product-offers__price small {
    max-width: 90px;
    margin-top: 5px;
    font-size: 0.66rem;
    font-weight: 750;
    line-height: 1.15;
  }

  .siwak-product-offers__card--subscription {
    margin-top: 8px;
    background: var(--offer-paper);
    color: var(--offer-ink);
  }

  .siwak-product-offers__card--subscription:has(input:checked) {
    border-color: var(--offer-red);
    background: var(--offer-paper);
    box-shadow: 5px 5px 0 var(--offer-ink);
  }

  .siwak-product-offers__card--subscription .siwak-product-offers__copy em {
    background: var(--offer-ink);
    color: #fff;
  }

  .siwak-product-offers__badge {
    position: absolute;
    top: -10px;
    right: 12px;
    padding: 4px 8px;
    border: 2px solid var(--offer-ink);
    background: var(--offer-paper);
    color: var(--offer-ink);
    font-size: 0.62rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    line-height: 1;
    text-transform: uppercase;
    transform: rotate(1.5deg);
  }

  .siwak-product-offers__card--disabled {
    cursor: not-allowed;
    filter: grayscale(0.2);
    opacity: 0.58;
  }

  .siwak-product-offers__card--disabled:hover {
    box-shadow: 4px 4px 0 var(--offer-ink);
    transform: none;
  }

  .siwak-product-offers__setup-note {
    margin: 11px 0 0;
    padding-left: 10px;
    border-left: 3px solid var(--offer-red);
    font-size: 0.72rem;
    line-height: 1.35;
    opacity: 0.72;
  }

  /* Reserve the strong red surface for the action beneath the offer cards. */
  .product-details:has(.siwak-product-offers) .product-form-buttons {
    margin-block-start: 12px;
    padding-inline: 6px;
    padding-block: 8px 12px;
  }

  .product-details:has(.siwak-product-offers) .product-form-buttons .add-to-cart-button {
    --button-background: #e52219;
    --button-color: #f5f1e9;
    --button-border-color: transparent;
    --button-hover-background: #c51b14;
    --button-hover-color: #f5f1e9;
    width: 100%;
    min-height: 60px;
    height: auto;
    padding: 16px 18px;
    border: 0;
    border-radius: 0;
    background: #e52219;
    box-shadow: 0 6px 0 #000;
    rotate: 0deg;
    font-family: var(--font-heading--family);
    font-size: clamp(1.2rem, 5.4vw, 1.65rem);
    font-weight: 700;
    line-height: 1.1;
    text-transform: uppercase;
    transition: background-color 120ms ease, box-shadow 120ms ease, translate 120ms ease;
  }

  .product-details:has(.siwak-product-offers) .product-form-buttons .add-to-cart-button:not([data-added='true']):not(:disabled) {
    color: #f5f1e9;
  }

  .product-details:has(.siwak-product-offers) .product-form-buttons .add-to-cart-button:not(:disabled):hover {
    background: #c51b14;
  }

  .product-details:has(.siwak-product-offers) .product-form-buttons .add-to-cart-button:not(:disabled):active {
    translate: 0 3px;
    box-shadow: 0 3px 0 #000;
  }

  .product-details:has(.siwak-product-offers) .product-form-buttons .add-to-cart-button:focus-visible {
    outline: 3px solid #171717;
    outline-offset: 5px;
  }

  .product-details:has(.siwak-product-offers) .product-form-buttons .add-to-cart-button:disabled {
    background: #dedbd5;
    color: #65615a;
    box-shadow: 3px 3px 0 #aaa;
    cursor: not-allowed;
  }

  @media (max-width: 749px) {
    .product-details:has(.siwak-product-offers) .product-form-buttons > span:has(add-to-cart-component) {
      flex: 1 1 100%;
      min-width: 0;
    }

    .product-details:has(.siwak-product-offers) .product-form-buttons > .quantity-selector-wrapper {
      margin-block-end: 6px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .product-details:has(.siwak-product-offers) .product-form-buttons .add-to-cart-button {
      transition: none;
    }
  }

  @media (max-width: 420px) {
    .siwak-product-offers__card {
      grid-template-columns: 22px minmax(0, 1fr) auto;
      gap: 9px;
      padding: 12px 10px;
    }

    .siwak-product-offers__copy > strong { font-size: 1.12rem; }
    .siwak-product-offers__price strong { font-size: 1.62rem; }
    .siwak-product-offers__price small { max-width: 72px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .siwak-product-offers__card { transition: none; }
  }

.product-details:has(.siwak-product-offers) .quantity-selector-wrapper, .product-details:has(.siwak-product-offers) .accelerated-checkout-block {display:none}
.siwak-product-offers__modes {display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:16px}
