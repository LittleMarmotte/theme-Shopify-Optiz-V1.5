ss=\"promise__headline\" data-animate>\n    <strong>Dents plus blanches<\/strong> en <span class=\"accent\">1 semaine<\/span>, sans dentifrices industriels, même sans te brosser les dents <u>trois fois par jour<\/u>.\n  <\/h1>\n\n  <span class=\"promise__comet\" aria-hidden=\"true\"><\/span>\n<\/section>\n\n<style>\n  :root {\n    --red: #FF0000;\n    --black: #212121;\n    --white: #FFFFFF;\n  }\n\n  .promise {\n    position: relative;\n    isolation: isolate;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    background: var(--white);\n    overflow: hidden;\n    padding: 80px 10px;\n    text-align: center;\n  }\n\n  \/* fond subtil *\/\n  .promise::before {\n    content: \"\";\n    position: absolute; inset: 0;\n    background:\n      radial-gradient(40vmax 40vmax at 50% 50%, rgba(255,0,0,.05), transparent 70%),\n      repeating-linear-gradient(to right, rgba(255,0,0,.015) 0 1px, transparent 1px 100px),\n      repeating-linear-gradient(to bottom, rgba(255,0,0,.015) 0 1px, transparent 1px 100px);\n    z-index: 0;\n  }\n\n  .promise__headline {\n    position: relative;\n    z-index: 2;\n    max-width: 950px;\n    font-weight: 800;\n    font-size: clamp(26px, 4.5vw, 60px);\n    line-height: 1.1;\n    color: var(--black);\n    margin: 0;\n    opacity: 0;\n    transform: translateY(15px);\n    transition: opacity 1s ease, transform 1s ease;\n  }\n\n  .promise__headline[data-animate=\"on\"] {\n    opacity: 1;\n    transform: translateY(0);\n  }\n\n  \/* mots rouges avec halo animé *\/\n  .promise__headline em,\n  .promise__headline .accent {\n    color: var(--red);\n    font-style: normal;\n    position: relative;\n    text-shadow:\n      0 0 8px rgba(255, 0, 0, 0.3),\n      0 0 20px rgba(255, 0, 0, 0.15),\n      0 0 40px rgba(255, 0, 0, 0.1);\n    animation: glowPulse 4s ease-in-out infinite;\n  }\n\n  @keyframes glowPulse {\n    0%,100% {\n      text-shadow:\n        0 0 8px rgba(255, 0, 0, 0.35),\n        0 0 20px rgba(255, 0, 0, 0.15),\n        0 0 40px rgba(255, 0, 0, 0.1);\n    }\n    50% {\n      text-shadow:\n        0 0 14px rgba(255, 0, 0, 0.5),\n        0 0 40px rgba(255, 0, 0, 0.25),\n        0 0 80px rgba(255, 0, 0, 0.15);\n    }\n  }\n\n  .promise__headline strong {\n    font-weight: 900;\n    color: var(--black);\n  }\n\n  .promise__headline u {\n    text-decoration: none;\n    background: linear-gradient(transparent 60%, rgba(255,0,0,0.15) 40%);\n  }\n\n  \/* halo global derrière tout le texte *\/\n  .promise__headline::before {\n    content: \"\";\n    position: absolute;\n    top: 50%; left: 50%;\n    transform: translate(-50%, -50%);\n    width: 130%;\n    height: 130%;\n    background: radial-gradient(circle, rgba(255,0,0,0.08), transparent 70%);\n    filter: blur(20px);\n    z-index: -1;\n    opacity: 0.6;\n    animation: haloPulse 6s ease-in-out infinite;\n  }\n\n  @keyframes haloPulse {\n    0%,100% { opacity: 0.5; transform: translate(-50%, -50%) scale(1); }\n    50%     { opacity: 0.8; transform: translate(-50%, -50%) scale(1.05); }\n  }\n\n  \/* comète rouge visible sous le texte *\/\n  .promise__comet {\n    position: absolute;\n    bottom: 20px;\n    left: -15%;\n    width: 30%;\n    height: 5px;\n    border-radius: 4px;\n    background: linear-gradient(90deg, rgba(255,0,0,0), var(--red), rgba(255,0,0,0));\n    filter: blur(1px);\n    z-index: 2;\n    animation: comet 5s cubic-bezier(.7,.05,.2,1) infinite;\n  }\n\n  .promise__comet::after {\n    content: \"\";\n    position: absolute;\n    right: -8px;\n    width: 10px;\n    height: 10px;\n    border-radius: 50%;\n    background: var(--red);\n    box-shadow:\n      0 0 10px rgba(255,0,0,.8),\n      0 0 25px rgba(255,0,0,.5),\n      0 0 60px rgba(255,0,0,.3);\n  }\n\n  @keyframes comet {\n    0%   { transform: translateX(0); opacity: 0; }\n    10%  { opacity: 1; }\n    50%  { transform: translateX(115vw); }\n    90%  { opacity: 1; }\n    100% { transform: translateX(160vw); opacity: 0; }\n  }\n\n  \/* Particules d’ambiance *\/\n  .promise__fx {\n    position: absolute;\n    inset: 0;\n    z-index: 0;\n    mix-blend-mode: multiply;\n    opacity: 0.25;\n    pointer-events: none;\n  }\n\n  @media (max-width: 600px) {\n    .promise {\n      padding: 60px 10px;\n    }\n    .promise__headline {\n      font-size: clamp(24px, 6vw, 42px);\n      line-height: 1.15;\n    }\n  }\n<\/style>\n\n<script>\n\/* === Animation d’apparition du texte === *\/\nconst headline = document.querySelector('.promise__headline');\nconst obs = new IntersectionObserver(entries => {\n  entries.forEach(e => {\n    if (e.isIntersecting) {\n      headline.setAttribute('data-animate','on');\n      obs.disconnect();\n    }\n  });\n}, {threshold: 0.3});\nobs.observe(headline);\n\n\/* === Particules rouges légères === *\/\nconst canvas = document.querySelector('.promise__fx');\nconst ctx = canvas.getContext('2d');\nlet w, h, dpr = Math.max(1, window.devicePixelRatio || 1);\nconst parts = [];\nconst COUNT = 50;\n\nfunction resize() {\n  w = canvas.clientWidth;\n  h = canvas.clientHeight;\n  canvas.width = w * dpr;\n  canvas.height = h * dpr;\n  ctx.setTransform(dpr,0,0,dpr,0,0);\n}\nwindow.addEventListener('resize', resize);\nresize();\n\nfunction rand(a,b){ return a + Math.random()*(b-a); }\n\nfor (let i=0;i<COUNT;i++) {\n  parts.push({x:rand(0,w),y:rand(0,h),r:rand(0.6,1.4),a:rand(0,Math.PI*2),s:rand(0.1,0.4)});\n}\n\nfunction loop(){\n  ctx.clearRect(0,0,w,h);\n  for(const p of parts){\n    p.x += Math.cos(p.a)*p.s;\n    p.y += Math.sin(p.a)*p.s;\n    if(p.x<0) p.x=w; if(p.x>w) p.x=0;\n    if(p.y<0) p.y=h; if(p.y>h) p.y=0;\n    ctx.beginPath();\n    const grad = ctx.createRadialGradient(p.x,p.y,0,p.x,p.y,p.r*5);\n    grad.addColorStop(0,`rgba(255,0,0,0.35)`);\n    grad.addColorStop(1,`rgba(255,0,0,0)`);\n    ctx.fillStyle=grad;\n    ctx.arc(p.x,p.y,p.r,0,Math.PI*2);\n    ctx.fill();\n  }\n  requestAnimationFrame(loop);\n}\nloop();\n<\/script>","color_scheme":"","section_width":"page-width","padding-block-start":0,"padding-block-end":0}},"custom_liquid_MKgeHC":{"type":"custom-liquid","disabled":true,"name":"t:names.custom_liquid","settings":{"custom_liquid":"<!-- Google Fonts -->\n<link href=\"https:\/\/fonts.googleapis.com\/css2?family=Roboto:wght@700&display=swap\" rel=\"stylesheet\">\n\n<style>\n  \/* Wrapper du ticker *\/\n  .full-page-ticker-wrapper {\n    width: 100%; \/* ne pas utiliser 100vw, évite le débordement horizontal *\/\n    background-color: #ffffff;\n    border-top: 3px solid #FF0000;\n    border-bottom: 3px solid #FF0000;\n    overflow: hidden;\n    position: relative; \/* pas de position fixe -> ne chevauche pas le reste *\/\n    z-index: 1; \/* faible priorité visuelle *\/\n    padding: 12px 0;\n    box-sizing: border-box; \/* pour que les bordures comptent dans la largeur *\/\n  }\n\n  \/* Texte du ticker *\/\n  .ticker-text {\n    display: inline-block;\n    padding-left: 100%;\n    white-space: nowrap;\n    font-family: 'Roboto', sans-serif;\n    font-weight: 700;\n    font-size: 16px;\n    letter-spacing: 0.08em;\n    color: #FF0000;\n    text-transform: uppercase;\n    animation: tickerScroll 28s linear infinite;\n  }\n\n  \/* Animation du défilement *\/\n  @keyframes tickerScroll {\n    0% {\n      transform: translateX(0%);\n    }\n    100% {\n      transform: translateX(-100%);\n    }\n  }\n<\/style>\n\n<div class=\"full-page-ticker-wrapper\">\n  <div class=\"ticker-text\">\n    FORCE & CONFIANCE ! LOOK IMPACTANT ! PRODUITS NATURELS ! SANTÉ & VITALITÉ ! FORCE & CONFIANCE ! LOOK IMPACTANT ! PRODUITS NATURELS ! SANTÉ & VITALITÉ ! FORCE & CONFIANCE ! LOOK IMPACTANT ! PRODUITS NATURELS ! SANTÉ & VITALITÉ !\n  <\/div>\n<\/div>","color_scheme":"","section_width":"full-width","padding-block-start":0,"padding-block-end":40}},"image_defile_gkW6Bw":{"type":"image_defile","blocks":{"image_Vp6t33":{"type":"image","settings":{"img":"shopify:\/\/shop_images\/hakim_pose.jpg"}},"image_DA3yUV":{"type":"image","settings":{"img":"shopify:\/\/shop_images\/hakim_pose_2.jpg"}},