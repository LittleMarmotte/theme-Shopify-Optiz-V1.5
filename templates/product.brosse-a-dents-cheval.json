DUITS NATURELS ! SANTÉ & VITALITÉ ! FORCE & CONFIANCE ! LOOK IMPACTANT ! PRODUITS NATURELS ! SANTÉ & VITALITÉ ! FORCE & CONFIANCE ! LOOK IMPACTANT ! PRODUITS NATURELS ! SANTÉ & VITALITÉ !\n  <\/div>\n<\/div>"},"blocks":{}},"custom_liquid_GP6Ey4":{"type":"custom-liquid","name":"t:names.custom_liquid","disabled":true,"settings":{"custom_liquid":""},"blocks":{}}},"block_order":["product_title_tefwj7","reviews","price_a7krng","custom_liquid_fUcjRY","text_gXMUag","variant_picker_R3rGDr","product_inventory_ibhciA","buy_buttons_eYQEYi","custom_liquid_qaaXJy","custom_liquid_GP6Ey4"]}},"custom_css":[".add-to-cart-button {background: #f00; box-shadow: 0 4px 8px rgba(255, 0, 0, 0.25);}",".name-option,h2 {font-weight: 700; color: #212121;}",".price {font-weight: 700; color: #f00; font-size: 30px;}",".price__badge-sale {font-weight: 700; background: #f00; color: #fff;}",".quantity-selector {background: #e4e4e4; box-shadow: 0 4px 8px rgba(0, 0, 0, 0.25);}",".shopify-payment-button__button {background: #212121; box-shadow: 0 4px 8px rgba(0, 0, 0, 0.25);}","@media (min-width: 1024px) {.product-media {transform: scale(1); transform-origin: center; }}"],"settings":{"content_width":"content-center-aligned","desktop_media_position":"left","equal_columns":false,"limit_details_width":false,"gap":20,"color_scheme":"scheme-1","padding-block-start":100,"padding-block-end":0}},"custom_liquid_77LfiJ":{"type":"custom-liquid","disabled":true,"name":"t:names.custom_liquid","settings":{"custom_liquid":"<!-- Google Fonts -->\n<link href=\"https:\/\/fonts.googleapis.com\/css2?family=Roboto:wght@700&display=swap\" rel=\"stylesheet\">\n\n<style>\n  \/* Wrapper du ticker *\/\n  .full-page-ticker-wrapper {\n    width: 100%; \/* ne pas utiliser 100vw, évite le débordement horizontal *\/\n    background-color: #ffffff;\n    border-top: 3px solid #FF0000;\n    border-bottom: 3px solid #FF0000;\n    overflow: hidden;\n    position: relative; \/* pas de position fixe -> ne chevauche pas le reste *\/\n    z-index: 1; \/* faible priorité visuelle *\/\n    padding: 12px 0;\n    box-sizing: border-box; \/* pour que les bordures comptent dans la largeur *\/\n  }\n\n  \/* Texte du ticker *\/\n  .ticker-text {\n    display: inline-block;\n    padding-left: 100%;\n    white-space: nowrap;\n    font-family: 'Roboto', sans-serif;\n    font-weight: 700;\n    font-size: 16px;\n    letter-spacing: 0.08em;\n    color: #FF0000;\n    text-transform: uppercase;\n    animation: tickerScroll 28s linear infinite;\n  }\n\n  \/* Animation du défilement *\/\n  @keyframes tickerScroll {\n    0% {\n      transform: translateX(0%);\n    }\n    100% {\n      transform: translateX(-100%);\n    }\n  }\n<\/style>\n\n<div class=\"full-page-ticker-wrapper\">\n  <div class=\"ticker-text\">\n    FORCE & CONFIANCE ! LOOK IMPACTANT ! PRODUITS NATURELS ! SANTÉ & VITALITÉ ! FORCE & CONFIANCE ! LOOK IMPACTANT ! PRODUITS NATURELS ! SANTÉ & VITALITÉ ! FORCE & CONFIANCE ! LOOK IMPACTANT ! PRODUITS NATURELS ! SANTÉ & VITALITÉ !\n  <\/div>\n<\/div>","color_scheme":"","section_width":"full-width","padding-block-start":0,"padding-block-end":40}},"custom_liquid_TrEHJq":{"type":"custom-liquid","custom_css":[],"name":"t:names.custom_liquid","settings":{"custom_liquid":"<div id=\"brosse-cheval-desc\" class=\"sd\">\n<style>\n.sd {\n --red:#FF0000;\n --blk:#212121;\n --mut:#6f6f6f;\n --bg:#ffffff;\n --card:#f7f7f7;\n font-family:system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial;\n color:var(--blk);\n}\n.sd *{box-sizing:border-box}\n\n\/* WRAP ULTRA-LARGE – presque bord à bord *\/\n.sd .wrap{\n max-width:100%;\n width:100%;\n margin:auto;\n padding: clamp(12px, 1.5vw, 22px);\n padding-left: 1vw;\n padding-right: 1vw;\n}\n\n.sd .grid{display:grid;gap:clamp(12px,1.5vw,20px)}\n\n\/* HERO *\/\n.sd .hero{\n position:relative;\n overflow:hidden;\n border-radius:18px;\n background:linear-gradient(135deg,var(--blk),#5c5c5c)\n}\n.sd .hero::after{\n content:\"\";\n position:absolute;\n inset:-40% -20% auto -20%;\n height:120%;\n background:\n  radial-gradient(1200px 400px at 20% 10%, rgba(255,0,0,.25), transparent 60%),\n  radial-gradient(900px 300px at 90% 0%, rgba(255,0,0,.18), transparent 60%);\n filter:blur(2px);\n pointer-events:none;\n}\n.sd .hero-inner{\n display:grid;\n grid-template-columns:1.1fr .9fr;\n gap:28px;\n padding:36px;\n align-items:center\n}\n@media (max-width:900px){\n .sd .hero-inner{grid-template-columns:1fr;padding:24px}\n}\n\n.sd h1{\n margin:0;\n font-size:clamp(28px,5vw,48px);\n line-height:1.05;\n letter-spacing:-.02em;\n color:#fff\n}\n.sd .sub{color:#f0f0f0;font-size:clamp(14px,1.6vw,18px);opacity:.9;margin-top:8px}\n.sd .badge{\n display:inline-flex;align-items:center;gap:8px;\n background:#ffffff10;border:1px solid #ffffff30;color:#fff;\n padding:8px 12px;border-radius:999px;font-weight:600\n}\n.sd .badge svg{width:16px;height:16px}\n\n.sd .hero-card{\n background:#fff;border-radius:16px;padding:20px;\n border:1px solid #eaeaea;\n box-shadow:0 10px 30px rgba(0,0,0,.08)\n}\n\n.sd .price{display:flex;align-items:baseline;gap:10px}\n.sd .price .num{font-size:34px;font-weight:800;color:var(--blk)}\n\n.sd .cta{margin-top:10px;display:flex;gap:10px;flex-wrap:wrap}\n.sd .btn{\n appearance:none;border:none;background:var(--red);color:#fff;\n padding:14px 18px;border-radius:12px;font-weight:800;\n letter-spacing:.2px;cursor:pointer;\n transition:transform .2s ease, box-shadow .2s ease\n}\n.sd .btn:hover{transform:translateY(-2px);box-shadow:0 8px 20px rgba(255,0,0,.25)}\n.sd .btn.sec{background:#fff;color:var(--blk);border:1px solid #dcdcdc}\n\n\/* POINTS CLÉS *\/\n.sd .ksp{\n margin-top:28px;\n display:grid;\n grid-template-columns:repeat(3,1fr);\n gap:14px\n}\n@media (max-width:800px){.sd .ksp{grid-template-columns:1fr 1fr}}\n@media (max-width:520px){.sd .ksp{grid-template-columns:1fr}}\n\n.sd .k{\n display:flex;gap:12px;align-items:flex-start;\n background:var(--card);border:1px solid #ececec;\n border-radius:14px;padding:14px\n}\n.sd .k svg{min-width:24px;width:24px;height:24px;color:var(--red)}\n\n.sd h2{font-size:clamp(22px,3.6vw,32px);letter-spacing:-.01em;margin:0 0 10px}\n.sd p{margin:6px 0 0;color:var(--blk)}\n.sd .mut{color:var(--mut)}\n\n\/* LIGNE DE SÉPARATION *\/\n.sd .hr{height:1px;background:linear-gradient(90deg,transparent,#e8e8e8,transparent);margin:28px 0}\n\n\/* 🔥 ULTRA-WIDE CARDS – encore plus larges *\/\n.sd .cards{\n display:grid;\n grid-template-columns:repeat(3, minmax(0, 1fr));\n gap:6px; \/* ← encore plus petit = cartes encore plus grandes *\/\n}\n\n@media (max-width:960px){\n .sd .cards{grid-template-columns:1fr}\n}\n\n\/* CARTES PLUS MASSIVES ET PLUS VISIBLES *\/\n.sd .card{\n background:#fff;\n border:1px solid #ececec;\n border-radius:16px;\n padding:32px; \/* ← plus épais *\/\n font-size:1.1rem; \/* ← augmente perception de largeur *\/\n line-height:1.55;\n box-shadow:0 12px 26px rgba(0,0,0,.07)\n}\n\n.sd .list{display:grid;gap:10px;margin-top:10px}\n.sd .li{display:flex;gap:12px}\n.sd .li svg{width:18px;height:18px;margin-top:2px;color:var(--red)}\n\n.sd .band{\n background:linear-gradient(90deg,#fff 0,#fff 40%,#ffe6e6 100%);\n border:1px solid #ffe1e1;padding:16px;\n border-radius:14px;\n display:grid;grid-template-columns:auto 1fr;gap:12px;align-items:center\n}\n.sd .band svg{width:28px;height:28px;color:var(--red)}\n\n.sd .reveal{opacity:0;transform:translateY(16px);transition:opacity .7s ease,transform .7s cubic-bezier(.2,.7,.2,1)}\n.sd .reveal.show{opacity:1;transform:none}\n\n.sd .u{position:relative;display:inline-block}\n.sd .u::after{\n content:\"\";position:absolute;left:0;right:0;bottom:-6px;\n height:3px;background:linear-gradient(90deg,var(--red),transparent)\n}\n\n.highlight-cart{\n box-shadow:0 0 20px 5px rgba(255,0,0,.6)!important;\n transform:scale(1.05);\n transition:all .4s ease\n}\n<\/style>\n\n<div class=\"wrap\">\n\n<!-- HERO -->\n<section class=\"hero\">\n <div class=\"hero-inner\">\n  <div class=\"reveal\">\n   <h1>Brosse à dents – Poils de cheval<\/h1>\n   <p class=\"sub\">Douceur naturelle, nettoyage efficace, et un geste plus responsable au quotidien.<\/p>\n   <div class=\"badge\">\n    <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n     <circle cx=\"12\" cy=\"12\" r=\"9\"\/>\n     <path d=\"M12 7v5l3 3\"\/>\n    <\/svg>\n    Poils naturels – Brossage doux\n   <\/div>\n  <\/div>\n\n  <div class=\"hero-card reveal\">\n   <h2 class=\"u\">Brosse en douceur<\/h2>\n   <p>Des poils de cheval souples pour respecter les gencives, tout en aidant à éliminer la plaque au quotidien.<\/p>\n   <div class=\"price\"><span class=\"num\">7,90 €<\/span><span class=\"mut\">1 brosse<\/span><\/div>\n   <div class=\"cta\">\n    <button class=\"btn scroll-to-top\">Ajouter au panier<\/button>\n    <button class=\"btn sec\" onclick=\"document.getElementById('brosse-contents')?.scrollIntoView({behavior:'smooth'})\">Découvrir plus<\/button>\n   <\/div>\n   <p class=\"mut\" style=\"margin-top:8px;font-size:.95rem\">💡 Convient si tu cherches une alternative plus naturelle aux brosses synthétiques.<\/p>\n  <\/div>\n\n <\/div>\n<\/section>\n\n<!-- PETITS POINTS CLÉS (optionnel mais ça rend bien) -->\n<section class=\"ksp reveal\">\n <div class=\"k\">\n  <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n   <path d=\"M20 6L9 17l-5-5\"\/>\n  <\/svg>\n  <div><strong>Poils naturels<\/strong><br><span class=\"mut\">Souplesse et confort.<\/span><\/div>\n <\/div>\n <div class=\"k\">\n  <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n   <path d=\"M20 6L9 17l-5-5\"\/>\n  <\/svg>\n  <div><strong>Douce pour les gencives<\/strong><br><span class=\"mut\">Brossage moins agressif.<\/span><\/div>\n <\/div>\n <div class=\"k\">\n  <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n   <path d=\"M20 6L9 17l-5-5\"\/>\n  <\/svg>\n  <div><strong>Entretien simple<\/strong><br><span class=\"mut\">Rinçage + séchage à l’air.<\/span><\/div>\n <\/div>\n<\/section>\n\n<!-- DESCRIPTION -->\n<section id=\"brosse-contents\" class=\"grid cards reveal\">\n\n <div class=\"card\">\n  <h2 class=\"u\">Une alternative naturelle<\/h2>\n  <p>\n   La brosse à dents en <strong>poils de cheval<\/strong> est appréciée pour sa <strong>douceur<\/strong> et son contact plus naturel en bouche.<br><br>\n   Idéale si tu veux un brossage confortable, notamment sur des <strong>gencives sensibles<\/strong>.\n  <\/p>\n  <div class=\"band\" style=\"margin-top:14px\">\n   <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n    <path d=\"M12 2v20\"\/>\n    <path d=\"M2 12h20\"\/>\n   <\/svg>\n   <div><strong>Conseil :<\/strong> change de brosse tous les 2–3 mois (ou plus tôt si les poils s’écartent).<\/div>\n  <\/div>\n <\/div>\n\n <div class=\"card\">\n  <h2 class=\"u\">Points forts<\/h2>\n  <div class=\"list\">\n   <div class=\"li\">\n    <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M20 6L9 17l-5-5\"\/><\/svg>\n    <div><strong>Poils souples<\/strong> → confort au brossage, gencives respectées.<\/div>\n   <\/div>\n   <div class=\"li\">\n    <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M20 6L9 17l-5-5\"\/><\/svg>\n    <div><strong>Nettoyage quotidien<\/strong> → aide à retirer la plaque dentaire.<\/div>\n   <\/div>\n   <div class=\"li\">\n    <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M20 6L9 17l-5-5\"\/><\/svg>\n    <div><strong>Alternative au synthétique<\/strong> → pour une routine plus “naturelle”.<\/div>\n   <\/div>\n   <div class=\"li\">\n    <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M20 6L9 17l-5-5\"\/><\/svg>\n    <div><strong>Prise en main facile<\/strong> → format simple, usage quotidien.<\/div>\n   <\/div>\n  <\/div>\n  <p class=\"mut\" style=\"margin-top:12px\">\n   Remarque : comme tout accessoire d’hygiène, l’efficacité dépend aussi de la technique de brossage (2 min, 2×\/jour).\n  <\/p>\n <\/div>\n\n <div class=\"card\">\n  <h2 class=\"u\">Utilisation & entretien<\/h2>\n  <p>\n   <strong>1)<\/strong> Mouille la brosse et ajoute une noisette de dentifrice.<br>\n   <strong>2)<\/strong> Brosse en mouvements doux (gencive → dent), 2 minutes.<br>\n   <strong>3)<\/strong> Rince soigneusement, puis <strong>laisse sécher à l’air<\/strong> (tête vers le haut).<br><br>\n   💡 <strong>Astuce :<\/strong> évite de la laisser dans un étui fermé quand elle est humide.\n  <\/p>\n  <div class=\"band\" style=\"margin-top:14px\">\n   <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n    <path d=\"M20 6L9 17l-5-5\"\/>\n   <\/svg>\n   <div><strong>Bon à savoir :<\/strong> privilégie un séchage complet entre deux utilisations.<\/div>\n  <\/div>\n <\/div>\n\n<\/section>\n\n<div class=\"hr reveal\"><\/div>\n\n<section class=\"reveal\" style=\"text-align:center\">\n <h2 class=\"u\">Le brossage doux, version naturelle<\/h2>\n <p>Simple, efficace, confortable au quotidien.<\/p>\n <button class=\"btn scroll-to-top\">Ajouter au panier<\/button>\n<\/section>\n\n<\/div>\n\n<script>\n(function(){\n const els=document.querySelectorAll('#brosse-cheval-desc .reveal');\n const io=new IntersectionObserver((entries)=>{\n  entries.forEach(e=>{\n   if(e.isIntersecting){\n    e.target.classList.add('show');\n    io.unobserve(e.target);\n   }\n  });\n },{threshold:.12});\n els.forEach(el=>io.observe(el));\n})();\n\ndocument.querySelectorAll('#brosse-cheval-desc .scroll-to-top').forEach(btn=>{\n btn.addEventListener('click',()=>{\n  const target=document.querySelector('form[action*=\"\/cart\"] button[name=\"add\"], button[name=\"add\"]');\n  if(target){\n   target.scrollIntoView({behavior:'smooth',block:'center'});\n   target.classList.add('highlight-cart');\n   setTimeout(()=>target.classList.remove('highlight-cart'),2000);\n  } else {\n   window.scrollTo({top:0,behavior:'smooth'});\n  }\n });\n});\n<\/script>\n\n<\/div>","color_scheme":"","section_width":"full-width","padding-block-start":0,"padding-block-end":0}},"image_defile_gkW6Bw":{"type":"image_defile","blocks":{"image_Vp6t33":{"type":"image","settings":{"img":"shopify:\/\/shop_images\/hakim_pose.jpg"}},"image_DA3yUV":{"type":"image","settings":{"img":"shopify:\/\/shop_images\/hakim_pose_2.jpg"}},"image_z4Vihd":{"type":"image","settings":{"img":"shopify:\/\/shop_images\/hakim_pose.jpg"}},"image_TdEKQc":{"type":"image","settings":{"img":"shopify:\/\/shop_images\/hakim_pose_2.jpg"}},"image_RMVVxX":{"type":"image","settings":{"img":"shopify:\/\/shop_images\/hakim_pose.jpg"}},"image_PBMnLD":{"type":"image","settings":{"img":"shopify:\/\/shop_images\/hakim_pose_2.jpg"}}},"block_order":["image_Vp6t33","image_DA3yUV","image_z4Vihd","image_TdEKQc","image_RMVVxX","image_PBMnLD"],"custom_css":["{margin-bottom: 35px;}"],"name":"Barre d'images","settings":{"image_height":260,"speed":52,"background_color":"#ffffff"}},"17621634554ab52470":{"type":"_blocks","blocks":{"klaviyo_reviews_product_reviews_V7x3z7":{"type":"shopify:\/\/apps\/klaviyo-reviews\/blocks\/product-reviews\/db20e365-d984-4ac4-9655-e1588d951ca9","settings":{}}},"block_order":["klaviyo_reviews_product_reviews_V7x3z7"],"settings":{"content_direction":"column","vertical_on_mobile":true,"horizontal_alignment":"flex-start","vertical_alignment":"center","align_baseline":false,"horizontal_alignment_flex_direction_column":"center","vertical_alignment_flex_direction_column":"center","gap":12,"section_width":"full-width","section_height":"","section_height_custom":50,"color_scheme":"","background_media":"none","video_position":"cover","background_image_position":"cover","border":"none","border_width":1,"border_opacity":100,"border_radius":0,"toggle_overlay":true,"overlay_color":"#212121","overlay_style":"solid","gradient_direction":"to top","padding-block-start":0,"padding-block-end":0}}},"order":["main","custom