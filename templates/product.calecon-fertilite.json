ream);\n    padding:52px;\n    border-radius:24px;\n  }\n\n  #optiz-parachute .op-badge{\n    display:inline-flex;\n    align-items:center;\n    gap:8px;\n    margin-bottom:19px;\n    padding:8px 13px;\n    border-radius:999px;\n    background:#111;\n    color:#fff;\n    font-size:11px;\n    font-weight:850;\n    letter-spacing:.09em;\n    text-transform:uppercase;\n  }\n\n  #optiz-parachute .op-dot{\n    width:7px;\n    height:7px;\n    border-radius:50%;\n    background:var(--red);\n  }\n\n  #optiz-parachute .op-title{\n    margin:0;\n    max-width:720px;\n    font-size:clamp(39px,5vw,62px);\n    line-height:.99;\n    font-weight:900;\n    letter-spacing:-.05em;\n  }\n\n  #optiz-parachute .op-title-red{\n    color:var(--red);\n  }\n\n  #optiz-parachute .op-intro{\n    max-width:620px;\n    margin:22px 0 0;\n    font-size:17px;\n    line-height:1.6;\n    color:#343434;\n  }\n\n  #optiz-parachute .op-intro strong{\n    color:#111;\n    font-weight:800;\n  }\n\n  #optiz-parachute .op-statement{\n    margin-top:22px;\n    padding:15px 17px;\n    background:#fff;\n    border-left:4px solid var(--red);\n    border-radius:0 12px 12px 0;\n    font-size:14px;\n    line-height:1.5;\n  }\n\n  #optiz-parachute .op-checks{\n    display:grid;\n    grid-template-columns:1fr 1fr;\n    gap:12px 20px;\n    margin-top:24px;\n  }\n\n  #optiz-parachute .op-check{\n    display:flex;\n    align-items:center;\n    gap:9px;\n    font-size:14px;\n    font-weight:700;\n  }\n\n  #optiz-parachute .op-check-icon{\n    width:21px;\n    height:21px;\n    flex:0 0 21px;\n    display:flex;\n    justify-content:center;\n    align-items:center;\n    border-radius:50%;\n    background:#fff;\n    border:1px solid #ddd;\n    color:var(--red);\n  }\n\n  #optiz-parachute .op-check-icon svg{\n    width:12px;\n    height:12px;\n  }\n\n  #optiz-parachute .op-buy{\n    width:100%;\n    padding:29px;\n    background:#fff;\n    border:1px solid var(--border);\n    border-radius:19px;\n    box-shadow:0 18px 45px rgba(0,0,0,.065);\n  }\n\n  #optiz-parachute .op-brand{\n    margin-bottom:6px;\n    color:#777;\n    font-size:11px;\n    font-weight:850;\n    letter-spacing:.1em;\n    text-transform:uppercase;\n  }\n\n  #optiz-parachute .op-product-name{\n    margin:0;\n    font-size:26px;\n    line-height:1.15;\n    font-weight:850;\n  }\n\n  #optiz-parachute .op-product-sub{\n    margin:7px 0 0;\n    color:#777;\n    font-size:13px;\n  }\n\n  #optiz-parachute .op-price-wrap{\n    display:flex;\n    align-items:flex-end;\n    flex-wrap:wrap;\n    gap:11px;\n    margin-top:21px;\n  }\n\n  #optiz-parachute .op-price{\n    font-size:44px;\n    line-height:.95;\n    font-weight:900;\n    letter-spacing:-.045em;\n  }\n\n  #optiz-parachute .op-unit{\n    padding-bottom:3px;\n    color:#777;\n    font-size:13px;\n    font-weight:600;\n  }\n\n  #optiz-parachute .op-pack{\n    display:flex;\n    align-items:flex-start;\n    gap:13px;\n    margin-top:23px;\n    padding:16px;\n    background:#FFF1F1;\n    border:1px solid #FFD6D6;\n    border-radius:14px;\n  }\n\n  #optiz-parachute .op-pack-icon{\n    width:38px;\n    height:38px;\n    flex:0 0 38px;\n    display:flex;\n    justify-content:center;\n    align-items:center;\n    background:var(--red);\n    color:#fff;\n    border-radius:10px;\n  }\n\n  #optiz-parachute .op-pack-icon svg{\n    width:19px;\n    height:19px;\n  }\n\n  #optiz-parachute .op-pack strong{\n    display:block;\n    margin-bottom:4px;\n    font-size:15px;\n    font-weight:850;\n  }\n\n  #optiz-parachute .op-pack span{\n    display:block;\n    color:#555;\n    font-size:13px;\n    line-height:1.45;\n  }\n\n  #optiz-parachute .op-btn{\n    width:100%;\n    margin-top:19px;\n    padding:17px 20px;\n    border:0;\n    border-radius:11px;\n    background:#111;\n    color:#fff;\n    font-family:inherit;\n    font-size:15px;\n    font-weight:850;\n    cursor:pointer;\n    transition:.2s ease;\n  }\n\n  #optiz-parachute .op-btn:hover{\n    background:var(--red);\n    transform:translateY(-1px);\n  }\n\n  #optiz-parachute .op-btn-sub{\n    margin-top:10px;\n    text-align:center;\n    color:#777;\n    font-size:12px;\n    font-weight:600;\n  }\n\n  #optiz-parachute .op-benefits{\n    margin-top:65px;\n  }\n\n  #optiz-parachute .op-benefit-header{\n    max-width:720px;\n    margin-bottom:28px;\n  }\n\n  #optiz-parachute .op-section-tag{\n    color:var(--red);\n    font-size:11px;\n    font-weight:900;\n    letter-spacing:.1em;\n    text-transform:uppercase;\n  }\n\n  #optiz-parachute .op-benefit-title{\n    margin:8px 0 0;\n    font-size:clamp(29px,4vw,41px);\n    line-height:1.08;\n    font-weight:900;\n    letter-spacing:-.04em;\n  }\n\n  #optiz-parachute .op-cards{\n    display:grid;\n    grid-template-columns:repeat(3,minmax(0,1fr));\n    gap:15px;\n  }\n\n  #optiz-parachute .op-card{\n    padding:27px;\n    background:#fff;\n    border:1px solid var(--border);\n    border-radius:17px;\n  }\n\n  #optiz-parachute .op-card-featured{\n    background:#111;\n    border-color:#111;\n    color:#fff;\n  }\n\n  #optiz-parachute .op-card-number{\n    display:block;\n    margin-bottom:22px;\n    color:var(--red);\n    font-size:13px;\n    font-weight:900;\n  }\n\n  #optiz-parachute .op-card h4{\n    margin:0 0 10px;\n    font-size:21px;\n    line-height:1.2;\n    font-weight:850;\n  }\n\n  #optiz-parachute .op-card p{\n    margin:0;\n    color:#595959;\n    font-size:14px;\n    line-height:1.55;\n  }\n\n  #optiz-parachute .op-card strong{\n    color:#111;\n    font-weight:800;\n  }\n\n  #optiz-parachute .op-card-featured p{\n    color:#ccc;\n  }\n\n  #optiz-parachute .op-card-featured strong{\n    color:#fff;\n  }\n\n  #optiz-parachute .op-final{\n    display:flex;\n    align-items:center;\n    justify-content:space-between;\n    gap:30px;\n    margin-top:25px;\n    padding:25px 28px;\n    border-radius:17px;\n    background:#111;\n    color:#fff;\n  }\n\n  #optiz-parachute .op-final-label{\n    margin-bottom:5px;\n    color:#999;\n    font-size:11px;\n    font-weight:850;\n    letter-spacing:.09em;\n    text-transform:uppercase;\n  }\n\n  #optiz-parachute .op-final-main{\n    font-size:20px;\n    font-weight:800;\n  }\n\n  #optiz-parachute .op-final-price{\n    white-space:nowrap;\n    font-size:28px;\n    font-weight:900;\n  }\n\n  #optiz-parachute .op-final-price span{\n    color:var(--red);\n  }\n\n  \/* AJOUT : mention légale obligatoire *\/\n  #optiz-parachute .op-legal{\n    margin:18px 0 0;\n    color:#9a9a9a;\n    font-size:11px;\n    line-height:1.5;\n  }\n\n  @media(max-width:900px){\n\n    #optiz-parachute .op-container{\n      padding:28px 16px 45px;\n    }\n\n    #optiz-parachute .op-hero{\n      grid-template-columns:1fr;\n      gap:34px;\n      padding:35px 28px;\n    }\n\n    #optiz-parachute .op-cards{\n      grid-template-columns:1fr;\n    }\n\n  }\n\n  @media(max-width:600px){\n\n    #optiz-parachute .op-container{\n      padding:18px 12px 38px;\n    }\n\n    #optiz-parachute .op-hero{\n      padding:27px 19px;\n      border-radius:18px;\n      gap:28px;\n    }\n\n    #optiz-parachute .op-title{\n      font-size:38px;\n    }\n\n    #optiz-parachute .op-intro{\n      font-size:15px;\n      line-height:1.55;\n    }\n\n    #optiz-parachute .op-checks{\n      grid-template-columns:1fr;\n    }\n\n    #optiz-parachute .op-buy{\n      padding:21px;\n    }\n\n    #optiz-parachute .op-price{\n      font-size:39px;\n    }\n\n    #optiz-parachute .op-benefits{\n      margin-top:48px;\n    }\n\n    #optiz-parachute .op-card{\n      padding:22px;\n    }\n\n    #optiz-parachute .op-final{\n      flex-direction:column;\n      align-items:flex-start;\n      gap:14px;\n      padding:22px;\n    }\n\n  }\n\n<\/style>\n\n\n<div class=\"op-container\">\n\n  <section class=\"op-hero\">\n\n    <div>\n\n      <div class=\"op-badge\">\n        <span class=\"op-dot\"><\/span>\n        OPTIZ • 100 % coton, 0 % polyester\n      <\/div>\n\n      <h2 class=\"op-title\">\n        Ton confort ce soir.\n        <span class=\"op-title-red\">Ta fertilité dans trois mois.<\/span>\n      <\/h2>\n\n      <p class=\"op-intro\">\n        Tes testicules sont à l’extérieur de ton corps pour une raison :\n        ils doivent rester <strong>2 à 4 °C plus frais<\/strong> que le reste\n        de toi pour produire du sperme correctement. Un boxer serré en\n        polyester annule exactement ça, 16 heures par jour. Le Caleçon\n        Parachute fait l’inverse. Et tu le sens dès le premier soir.\n      <\/p>\n\n      <div class=\"op-statement\">\n        <strong>74 jours.<\/strong> C’est le temps que prend la fabrication\n        d’un spermatozoïde. Aucun symptôme, aucune douleur, aucun signal :\n        la plupart des hommes découvrent l’état de leur fertilité le jour\n        où ils essaient d’avoir un enfant. Mais chaque cycle repart de\n        zéro. Le prochain commence demain matin.\n      <\/div>\n\n      <div class=\"op-checks\">\n\n        <div class=\"op-check\">\n          <span class=\"op-check-icon\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\">\n              <path d=\"M20 6L9 17l-5-5\"\/>\n            <\/svg>\n          <\/span>\n          Sec toute la journée\n        <\/div>\n\n        <div class=\"op-check\">\n          <span class=\"op-check-icon\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\">\n              <path d=\"M20 6L9 17l-5-5\"\/>\n            <\/svg>\n          <\/span>\n          Beaucoup moins d’odeur\n        <\/div>\n\n        <div class=\"op-check\">\n          <span class=\"op-check-icon\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\">\n              <path d=\"M20 6L9 17l-5-5\"\/>\n            <\/svg>\n          <\/span>\n          Zéro compression\n        <\/div>\n\n        <div class=\"op-check\">\n          <span class=\"op-check-icon\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\">\n              <path d=\"M20 6L9 17l-5-5\"\/>\n            <\/svg>\n          <\/span>\n          100 % coton, 0 % polyester\n        <\/div>\n\n      <\/div>\n\n    <\/div>\n\n\n    <div class=\"op-buy\">\n\n      <div class=\"op-brand\">OPTIZ<\/div>\n\n      <h3 class=\"op-product-name\">\n        Caleçon Parachute\n      <\/h3>\n\n      <p class=\"op-product-sub\">\n        Pack de 3 • 100 % coton • Coupe parachute\n      <\/p>\n\n      <div class=\"op-price-wrap\">\n\n        <div class=\"op-price\">\n          {{ product.price | money }}\n        <\/div>\n\n        <div class=\"op-unit\">\n          soit {{ product.price | divided_by: 3 | money }} \/ caleçon\n        <\/div>\n\n      <\/div>\n\n      <div class=\"op-pack\">\n\n        <div class=\"op-pack-icon\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n            <path d=\"M21 8l-9 5-9-5\"\/>\n            <path d=\"M3 8l9-5 9 5v8l-9 5-9-5z\"\/>\n            <path d=\"M12 13v8\"\/>\n          <\/svg>\n        <\/div>\n\n        <div>\n          <strong>1 quantité = 3 caleçons<\/strong>\n          <span>De quoi ne plus jamais remettre un polyester, dès demain matin.<\/span>\n        <\/div>\n\n      <\/div>\n\n      <button type=\"button\" class=\"op-btn op-scroll-cart\">\n        Ajouter les 3 caleçons\n      <\/button>\n\n      <div class=\"op-btn-sub\">\n        3 caleçons • Satisfait ou remboursé 30 jours\n      <\/div>\n\n    <\/div>\n\n  <\/section>\n\n\n\n  <section class=\"op-benefits\">\n\n    <div class=\"op-benefit-header\">\n\n      <span class=\"op-section-tag\">\n        Ce que tu gagnes, et quand\n      <\/span>\n\n      <h3 class=\"op-benefit-title\">\n        Dès ce soir. Dans trois mois. Et pour les années d’après.\n      <\/h3>\n\n    <\/div>\n\n\n    <div class=\"op-cards\">\n\n      <article class=\"op-card op-card-featured\">\n\n        <span class=\"op-card-number\">DÈS CE SOIR<\/span>\n\n        <h4>\n          Sec, libre, sans odeur.\n        <\/h4>\n\n        <p>\n          Le coton absorbe la sueur au lieu de la piéger entre des fibres\n          synthétiques. Les bactéries responsables de la mauvaise odeur se\n          développent bien mieux sur le polyester que sur le coton.\n          <strong>Tu le constates dès le premier soir.<\/strong>\n        <\/p>\n\n      <\/article>\n\n\n      <article class=\"op-card\">\n\n        <span class=\"op-card-number\">DANS TROIS MOIS<\/span>\n\n        <h4>\n          Un cycle entier à la bonne température.\n        <\/h4>\n\n        <p>\n          Sur 656 hommes suivis par une équipe de Harvard, ceux qui\n          portaient des caleçons amples avaient un nombre de\n          spermatozoïdes plus élevé. Ils avaient aussi une FSH plus basse,\n          l’hormone que le corps augmente <strong>quand il compense une\n          production qui décroche.<\/strong>\n        <\/p>\n\n      <\/article>\n\n\n      <article class=\"op-card\">\n\n        <span class=\"op-card-number\">SUR LE LONG TERME<\/span>\n\n        <h4>\n          Plus de plastique contre ta peau.\n        <\/h4>\n\n        <p>\n          Le polyester est un plastique, porté 16 heures par jour contre\n          une peau chaude et moite. Ses additifs chimiques migrent dans la\n          sueur et <strong>franchissent la barrière cutanée<\/strong>,\n          d’autant plus quand la peau est humide.\n        <\/p>\n\n      <\/article>\n\n    <\/div>\n\n  <\/section>\n\n\n\n  <div class=\"op-final\">\n\n    <div>\n\n      <div class=\"op-final-label\">\n        Ton prochain cycle commence demain matin\n      <\/div>\n\n      <div class=\"op-final-main\">\n        3 caleçons • 100 % coton • 0 % polyester\n      <\/div>\n\n    <\/div>\n\n    <div class=\"op-final-price\">\n      <span>3×<\/span> pour {{ product.price | money }}\n    <\/div>\n\n  <\/div>\n\n\n  <p class=\"op-legal\">\n    Le Caleçon Parachute OPTIZ est un sous-vêtement en coton. Ce n’est pas\n    un dispositif médical et il ne traite, ne prévient ni ne guérit aucun\n    trouble de la fertilité. Les éléments cités renvoient à des travaux\n    publiés sur la thermorégulation scrotale et n’ont pas valeur de\n    diagnostic. En cas de difficulté à concevoir, consultez un médecin.\n  <\/p>\n\n<\/div>\n\n\n<script>\n\n(function(){\n\n  var buttons = document.querySelectorAll(\n    \"#optiz-parachute .op-scroll-cart\"\n  );\n\n  buttons.forEach(function(button){\n\n    button.addEventListener(\"click\",function(){\n\n      var target = document.querySelector(\n        'form[action*=\"\/cart\"] button[name=\"add\"], ' +\n        'button[name=\"add\"], ' +\n        '.product-form__submit'\n      );\n\n      if(target){\n\n        target.scrollIntoView({\n          behavior:\"smooth\",\n          block:\"center\"\n        });\n\n      }else{\n\n        window.scrollTo({\n          top:0,\n          behavior:\"smooth\"\n        });\n\n      }\n\n    });\n\n  });\n\n})();\n\n<\/script>\n\n<\/div>","color_scheme":"","section_width":"full-width","padding-block-start":0,"padding-block-end":0}},"image_defile_gkW6Bw":{"type":"image_defile","blocks":{"image_Vp6t33":{"type":"image","settings":{"img":"shopify:\/\/shop_images\/hakim_pose.jpg"}},"image_DA3yUV":{"type":"image","settings":{"img":"shopify:\/\/shop_images\/hakim_pose_2.jpg"}},"image_z4Vihd":{"type":"image","settings":{"img":"shopify:\/\/shop_images\/hakim_pose.jpg"}},"image_TdEKQc":{"type":"image","settings":{"img":"shopify:\/\/shop_images\/hakim_pose_2.jpg"}},"image_RMVVxX":{"type":"image","settings":{"img":"shopify:\/\/shop_images\/hakim_pose.jpg"}},"image_PBMnLD":{"type":"image","settings":{"img":"shopify:\/\/shop_images\/hakim_pose_2.jpg"}}},"block_order":["image_Vp6t33","image_DA3yUV","image_z4Vihd","image_TdEKQc","image_RMVVxX","image_PBMnLD"],"custom_css":[],"name":"Barre d'images","settings":{"image_height":260,"speed":52,"background_color":"#ffffff"}},"product_recommendations_iA6pyd":{"type":"product-recomm