cing:-.03em;\n      color:#fff;\n      max-width:12ch;\n    }\n\n    .sd .sub{\n      color:#f2f2f2;\n      font-size:clamp(15px,1.7vw,19px);\n      line-height:1.5;\n      opacity:.95;\n      margin:14px 0 0;\n      max-width:56ch;\n    }\n\n    .sd .hero-points{\n      display:grid;\n      gap:10px;\n      margin-top:18px;\n    }\n\n    .sd .hero-point{\n      display:flex;\n      gap:10px;\n      align-items:flex-start;\n      color:#fff;\n      font-size:14px;\n      opacity:.95;\n    }\n\n    .sd .hero-point svg{\n      width:18px;\n      height:18px;\n      flex:0 0 18px;\n      margin-top:1px;\n      color:#fff;\n    }\n\n    .sd .hero-card{\n      background:rgba(255,255,255,.98);\n      border:1px solid rgba(255,255,255,.7);\n      border-radius:18px;\n      padding:20px;\n      box-shadow:0 14px 38px rgba(0,0,0,.12);\n    }\n\n    .sd .mini-badge{\n      display:inline-flex;\n      align-items:center;\n      gap:8px;\n      background:var(--soft);\n      border:1px solid #ffdcdc;\n      color:var(--blk);\n      padding:8px 12px;\n      border-radius:999px;\n      font-size:13px;\n      font-weight:700;\n      margin-bottom:12px;\n    }\n\n    .sd .mini-badge svg{width:15px;height:15px;color:var(--red)}\n\n    .sd h2{\n      font-size:clamp(22px,2.5vw,28px);\n      margin:0;\n      line-height:1.15;\n      letter-spacing:-.02em;\n    }\n\n    .sd .u{\n      position:relative;\n      display:inline-block;\n    }\n\n    .sd .u::after{\n      content:\"\";\n      position:absolute;\n      left:0;\n      right:0;\n      bottom:-6px;\n      height:3px;\n      background:linear-gradient(90deg,var(--red),transparent);\n    }\n\n    .sd .hero-card p{\n      margin:14px 0 0;\n      color:#333;\n      line-height:1.62;\n      font-size:15px;\n    }\n\n    .sd .price{\n      display:flex;\n      align-items:baseline;\n      gap:10px;\n      margin-top:16px;\n      flex-wrap:wrap;\n    }\n\n    .sd .price .num{\n      font-size:36px;\n      font-weight:900;\n      color:var(--blk);\n      letter-spacing:-.03em;\n    }\n\n    .sd .price .mut{\n      color:var(--mut);\n      font-size:14px;\n      font-weight:600;\n    }\n\n    .sd .trust{\n      display:grid;\n      grid-template-columns:repeat(3,1fr);\n      gap:10px;\n      margin-top:16px;\n    }\n\n    @media (max-width:540px){\n      .sd .trust{grid-template-columns:1fr}\n    }\n\n    .sd .trust-item{\n      background:#fafafa;\n      border:1px solid var(--line);\n      border-radius:12px;\n      padding:12px;\n      font-size:13px;\n      line-height:1.4;\n      color:#303030;\n    }\n\n    .sd .trust-item strong{\n      display:block;\n      font-size:14px;\n      color:var(--blk);\n      margin-bottom:3px;\n    }\n\n    .sd .cta{\n      margin-top:14px;\n      display:flex;\n      flex-direction:column;\n      gap:10px;\n      align-items:stretch;\n    }\n\n    .sd .cta .btn.scroll-to-top{\n      width:100%;\n      display:block;\n      text-align:center;\n    }\n\n    .sd .btn{\n      appearance:none;\n      border:none;\n      background:var(--red);\n      color:#fff;\n      padding:15px 18px;\n      border-radius:14px;\n      font-weight:900;\n      letter-spacing:.2px;\n      cursor:pointer;\n      transition:transform .2s ease, box-shadow .2s ease, opacity .2s ease;\n      box-shadow:0 10px 24px rgba(255,0,0,.22);\n    }\n\n    .sd .btn:hover{\n      transform:translateY(-2px);\n      box-shadow:0 14px 28px rgba(255,0,0,.28);\n    }\n\n    .sd .btn-sub{\n      text-align:center;\n      color:var(--mut);\n      font-size:12px;\n      font-weight:600;\n    }\n\n    .sd .hr{\n      height:1px;\n      background:linear-gradient(90deg,transparent,#e8e8e8,transparent);\n      margin:30px 0;\n    }\n\n    .sd .section-head{\n      text-align:center;\n      max-width:780px;\n      margin:0 auto 18px;\n    }\n\n    .sd .section-head h3{\n      margin:0;\n      font-size:clamp(24px,3vw,34px);\n      line-height:1.1;\n      letter-spacing:-.03em;\n    }\n\n    .sd .section-head p{\n      margin:10px 0 0;\n      color:var(--mut);\n      line-height:1.6;\n      font-size:15px;\n    }\n\n    .sd .cards{\n      grid-template-columns:repeat(3,minmax(0,1fr));\n    }\n\n    @media (max-width:960px){\n      .sd .cards{grid-template-columns:1fr}\n    }\n\n    .sd .card{\n      background:#fff;\n      border:1px solid var(--line);\n      border-radius:18px;\n      padding:22px;\n      box-shadow:0 10px 26px rgba(0,0,0,.05);\n      position:relative;\n      overflow:hidden;\n    }\n\n    .sd .card::before{\n      content:\"\";\n      position:absolute;\n      inset:0 auto 0 0;\n      width:4px;\n      background:linear-gradient(180deg,var(--red),transparent);\n      opacity:.9;\n    }\n\n    .sd .icon{\n      width:42px;\n      height:42px;\n      border-radius:12px;\n      display:grid;\n      place-items:center;\n      background:var(--soft);\n      border:1px solid #ffdede;\n      margin-bottom:14px;\n    }\n\n    .sd .icon svg{\n      width:21px;\n      height:21px;\n      color:var(--red);\n    }\n\n    .sd .card h5{\n      margin:0;\n      font-size:22px;\n      line-height:1.15;\n      letter-spacing:-.02em;\n    }\n\n    .sd .card p{\n      margin:10px 0 0;\n      color:#454545;\n      line-height:1.65;\n      font-size:15px;\n    }\n\n    .sd .band{\n      background:linear-gradient(90deg,#fff 0,#fff 38%, #fff1f1 100%);\n      border:1px solid #ffdede;\n      padding:18px;\n      border-radius:16px;\n      display:grid;\n      grid-template-columns:auto 1fr;\n      gap:14px;\n      align-items:center;\n      margin-top:22px;\n    }\n\n    @media (max-width:640px){\n      .sd .band{grid-template-columns:1fr}\n    }\n\n    .sd .band svg{\n      width:28px;\n      height:28px;\n      color:var(--red);\n    }\n\n    .sd .band strong{\n      display:block;\n      margin-bottom:4px;\n      font-size:16px;\n    }\n\n    .sd .band p{\n      margin:0;\n      color:#444;\n      line-height:1.55;\n      font-size:14px;\n    }\n\n    .sd .reveal{\n      opacity:0;\n      transform:translateY(16px);\n      transition:opacity .7s ease, transform .7s cubic-bezier(.2,.7,.2,1);\n    }\n\n    .sd .reveal.show{\n      opacity:1;\n      transform:none;\n    }\n\n    .highlight-cart{\n      box-shadow:0 0 20px 5px rgba(255,0,0,.6)!important;\n      transform:scale(1.05);\n      transition:all .4s ease;\n    }\n\n    @media (min-width:961px){\n      .sd .wrap{\n        max-width:100%;\n        width:100%;\n        padding-left:1vw;\n        padding-right:1vw;\n      }\n      .sd .cards{\n        gap:10px;\n      }\n      .sd .card{\n        padding:26px;\n      }\n    }\n  <\/style>\n\n  <div class=\"wrap\">\n\n    <!-- HERO -->\n    <section class=\"hero\">\n      <div class=\"hero-inner\">\n        <div class=\"reveal\">\n          <div class=\"eyebrow\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n              <path d=\"M12 2l4 4-4 4-4-4 4-4z\"\/>\n            <\/svg>\n            Filtration avancée • Installation sans outil\n          <\/div>\n\n          <h4>Le pommeau qui transforme votre eau en 60 secondes<\/h4>\n\n          <p class=\"sub\">\n            Filtre efficacement le chlore et les impuretés présentes dans l’eau de douche pour une sensation plus douce sur la peau, plus agréable sur les cheveux, et une routine quotidienne nettement plus confortable.\n          <\/p>\n\n          <div class=\"hero-points\">\n            <div class=\"hero-point\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                <path d=\"M20 6L9 17l-5-5\"\/>\n              <\/svg>\n              <span>Se visse en moins d’une minute, sans outil<\/span>\n            <\/div>\n\n            <div class=\"hero-point\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                <path d=\"M20 6L9 17l-5-5\"\/>\n              <\/svg>\n              <span>Filtration au carbone actif pour une eau plus propre<\/span>\n            <\/div>\n\n            <div class=\"hero-point\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                <path d=\"M20 6L9 17l-5-5\"\/>\n              <\/svg>\n              <span>Conçu pour améliorer le confort de douche au quotidien<\/span>\n            <\/div>\n          <\/div>\n        <\/div>\n\n        <div class=\"hero-card reveal\">\n          <div class=\"mini-badge\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n              <path d=\"M12 3v18M3 12h18\"\/>\n            <\/svg>\n            Votre nouvelle douche, en mieux\n          <\/div>\n\n          <h2 class=\"u\">Enfin une eau plus pure, chaque jour<\/h2>\n\n          <p>\n            Grâce à sa technologie de filtration à base de fibres de carbone actif, ce pommeau aide à réduire le chlore résiduel, les grosses particules et certaines impuretés de l’eau. Résultat : une eau plus douce, plus nette, et une douche plus agréable dès les premières utilisations.\n          <\/p>\n\n          <div class=\"price\">\n            <span class=\"num\">69,90 €<\/span>\n            <span class=\"mut\">Pommeau + filtre inclus<\/span>\n          <\/div>\n\n          \n\n          <div class=\"cta\">\n            <button class=\"btn scroll-to-top\">Ajouter au panier<\/button>\n            <div class=\"btn-sub\">Installation simple • Utilisation immédiate<\/div>\n          <\/div>\n        <\/div>\n      <\/div>\n    <\/section>\n\n    <div class=\"hr reveal\"><\/div>\n\n    <!-- ARGUMENTS -->\n    <section class=\"section-head reveal\">\n      <h3>Pourquoi autant de clients ne veulent plus revenir à une douche classique ?<\/h3>\n      <p>\n        Parce qu’une eau plus propre change toute l’expérience : moins d’inconfort, une sensation plus nette sur la peau, et une routine qui paraît enfin plus agréable au quotidien.\n      <\/p>\n    <\/section>\n\n    <section class=\"grid cards\">\n      <div class=\"card reveal\">\n        <div class=\"icon\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n            <path d=\"M12 3v18M5 10c0 4 3 7 7 7s7-3 7-7\"\/>\n          <\/svg>\n        <\/div>\n        <h5>Filtre le chlore et les impuretés<\/h5>\n        <p>\n          Sa filtration au carbone actif aide à réduire le chlore résiduel, les particules et diverses impuretés présentes dans l’eau de douche, pour une eau visiblement plus agréable à utiliser.\n        <\/p>\n      <\/div>\n\n      <div class=\"card reveal\">\n        <div class=\"icon\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n            <path d=\"M12 21s-6-4.35-9-8.5C.9 9.4 2.4 5 6.7 5c2.2 0 3.4 1.1 5.3 3 1.9-1.9 3.1-3 5.3-3C21.6 5 23.1 9.4 21 12.5 18 16.65 12 21 12 21z\"\/>\n          <\/svg>\n        <\/div>\n        <h5>Plus douce pour la peau et les cheveux<\/h5>\n        <p>\n          Une eau moins agressive peut contribuer à améliorer la sensation après la douche : moins de tiraillements, moins d’inconfort, et une routine plus respectueuse de votre peau et de vos cheveux.\n        <\/p>\n      <\/div>\n\n      <div class=\"card reveal\">\n        <div class=\"icon\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n            <path d=\"M14 3h7v7\"\/>\n            <path d=\"M10 14L21 3\"\/>\n            <path d=\"M21 14v7h-7\"\/>\n            <path d=\"M3 10L14 21\"\/>\n          <\/svg>\n        <\/div>\n        <h5>Installez-le en moins d’une minute<\/h5>\n        <p>\n          Pas besoin d’outil, pas besoin d’être bricoleur. Il se visse simplement à votre installation pour transformer votre douche en quelques secondes seulement.\n        <\/p>\n      <\/div>\n    <\/section>\n\n  <\/div>\n\n  <script>\n    (function(){\n      const els = document.querySelectorAll('#mastic-optiz-desc .reveal');\n      const io = new IntersectionObserver((entries)=>{\n        entries.forEach(e=>{\n          if(e.isIntersecting){\n            e.target.classList.add('show');\n            io.unobserve(e.target);\n          }\n        });\n      }, { threshold:.12 });\n      els.forEach(el=>io.observe(el));\n    })();\n\n    document.querySelectorAll('#mastic-optiz-desc .scroll-to-top').forEach(btn=>{\n      btn.addEventListener('click', ()=>{\n        const target = document.querySelector('form[action*=\"\/cart\"] button[name=\"add\"], button[name=\"add\"]');\n        if(target){\n          target.scrollIntoView({behavior:'smooth', block:'center'});\n          target.classList.add('highlight-cart');\n          setTimeout(()=>target.classList.remove('highlight-cart'), 2000);\n        }else{\n          window.scrollTo({top:0, behavior:'smooth'});\n        }\n      });\n    });\n  <\/script>\n<\/div>","color_scheme":"","section_width":"full-width","padding-block-start":0,"padding-block-end":40}},"image_defile_gkW6Bw":{"type":"image_defile","blocks":{"image_Vp6t33":{"type":"image","settings":{"img":"shopify:\/\/shop_images\/hakim_pose.jpg"}},"image_DA3yUV":{"type":"image","settings":{"img":"shopify:\/\/shop_images\/hakim_pose_2.jpg"}},"image_z4Vihd":{"type":"image","settings":{"img":"shopify:\/\/shop_images\/hakim_pose.jpg"}},"image_TdEKQc":{"type":"image","settings":{"img":"shopify:\/\/shop_images\/hakim_pose_2.jpg"}},"image_RMVVxX":{"type":"image","settings":{"img":"shopify:\/\/shop_images\/hakim_pose.jpg"}},"image_PBMnLD":{"type":"image","settings":{"img":"shopify:\/\/shop_images\/hakim_pose_2.jpg"}}},"block_order":["image_Vp6t33","image_DA3yUV","image_z4Vihd","image_TdEKQc","image_RMVVxX","image_PBMnLD"],"custom_css":[],"name":"Barre d'images","settings":{"image_height":260,"speed":52,"background_color":"#ffffff"}},"17621633459afa2520":{"type":"_blocks","blocks":{"klaviyo_reviews_product_reviews_yP4fpF":{"type":"shopify:\/\/apps\/klaviyo-reviews\/blocks\/product-reviews\