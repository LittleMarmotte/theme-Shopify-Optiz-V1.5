.hero{position:relative;overflow:hidden;border-radius:18px;background:linear-gradient(135deg,var(--blk),#5c5c5c)}\n    .sd .hero::after{content:\"\";position:absolute;inset:-40% -20% auto -20%;height:120%;background:\n      radial-gradient(1200px 400px at 20% 10%, rgba(255,0,0,.25), transparent 60%),\n      radial-gradient(900px 300px at 90% 0%, rgba(255,0,0,.18), transparent 60%);\n      filter:blur(2px);pointer-events:none;}\n    .sd .hero-inner{display:grid;grid-template-columns:1.1fr .9fr;gap:28px;padding:36px;align-items:center}\n    @media (max-width:900px){ .sd .hero-inner{grid-template-columns:1fr;padding:24px}}\n    .sd h1{margin:0;font-size:clamp(28px,5vw,48px);line-height:1.05;letter-spacing:-.02em;color:#fff}\n    .sd .sub{color:#f0f0f0;font-size:clamp(14px,1.6vw,18px);opacity:.9;margin-top:8px}\n    .sd .badge{display:inline-flex;align-items:center;gap:8px;background:#ffffff10;border:1px solid #ffffff30;color:#fff;padding:8px 12px;border-radius:999px;font-weight:600}\n    .sd .badge svg{width:16px;height:16px}\n    .sd .hero-card{background:#fff;border-radius:16px;padding:18px;border:1px solid #eaeaea;box-shadow:0 10px 30px rgba(0,0,0,.08)}\n    .sd .price{display:flex;align-items:baseline;gap:10px}\n    .sd .price .num{font-size:34px;font-weight:800;color:var(--blk)}\n    .sd .cta{margin-top:10px;display:flex;gap:10px;flex-wrap:wrap}\n    .sd .btn{appearance:none;border:none;background:var(--red);color:#fff;padding:14px 18px;border-radius:12px;font-weight:800;letter-spacing:.2px;cursor:pointer;transition:transform .2s ease, box-shadow .2s ease}\n    .sd .btn:hover{transform:translateY(-2px);box-shadow:0 8px 20px rgba(255,0,0,.25)}\n    .sd .btn.sec{background:#fff;color:var(--blk);border:1px solid #dcdcdc}\n    .sd .cards{grid-template-columns:repeat(3,1fr)}\n    @media (max-width:960px){.sd .cards{grid-template-columns:1fr}}\n    .sd .card{background:#fff;border:1px solid #ececec;border-radius:16px;padding:16px;box-shadow:0 8px 22px rgba(0,0,0,.05)}\n    .sd .list{display:grid;gap:10px;margin-top:10px}\n    .sd .li{display:flex;gap:12px}\n    .sd .li svg{width:18px;height:18px;margin-top:2px;color:var(--red)}\n    .sd .hr{height:1px;background:linear-gradient(90deg,transparent,#e8e8e8,transparent);margin:28px 0}\n    .sd .band{background:linear-gradient(90deg,#fff 0,#fff 40%,#ffe6e6 100%);border:1px solid #ffe1e1;padding:16px;border-radius:14px;display:grid;grid-template-columns:auto 1fr;gap:12px;align-items:center}\n    .sd .band svg{width:28px;height:28px;color:var(--red)}\n    .sd .reveal{opacity:0;transform:translateY(16px);transition:opacity .7s ease,transform .7s cubic-bezier(.2,.7,.2,1)}\n    .sd .reveal.show{opacity:1;transform:none}\n    .sd h2 { font-size: clamp(20px, 2.6vw, 26px); margin: 0; line-height: 1.2; }\n    .sd .card p { margin-top: 4px; }\n    .sd .u{position:relative;display:inline-block}\n    .sd .u::after{content:\"\";position:absolute;left:0;right:0;bottom:-6px;height:3px;background:linear-gradient(90deg,var(--red),transparent)}\n    .highlight-cart{box-shadow:0 0 20px 5px rgba(255,0,0,.6)!important;transform:scale(1.05);transition:all .4s ease}\n\n    \/* 🔥 MODIFS DESKTOP UNIQUEMENT POUR AGRANDIR LES 3 CARTES *\/\n    @media (min-width: 961px){\n      .sd .wrap{\n        max-width:100%;\n        width:100%;\n        padding-left:1vw;\n        padding-right:1vw;\n      }\n      .sd .cards{\n        grid-template-columns:repeat(3, minmax(0,1fr));\n        gap:8px; \/* gouttières réduites = cartes plus larges *\/\n      }\n      .sd .card{\n        padding:26px; \/* cartes plus “massives” sur ordi *\/\n      }\n    }\n  <\/style>\n\n  <div class=\"wrap\">\n    <!-- HERO -->\n    <section class=\"hero\">\n      <div class=\"hero-inner\">\n        <div class=\"reveal\">\n          <h1>Charcoal Optiz – Blanchiment naturel<\/h1>\n          <p class=\"sub\">Le vrai blanchiment, sans fluor ni chimie. Juste la puissance du charbon actif de noix de coco.<\/p>\n          <div class=\"badge\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M12 2l4 4-4 4-4-4 4-4z\"\/><\/svg>\n            100 % naturel – Poudre de charbon actif de coco\n          <\/div>\n        <\/div>\n        <div class=\"hero-card reveal\">\n          <h2 class=\"u\">Le vrai blanchiment naturel<\/h2>\n          <p>Un soin pur et efficace pour des dents plus blanches, une bouche détoxifiée et une haleine fraîche — sans fluor, sans plastique, sans produits chimiques.<\/p>\n          <div class=\"price\"><span class=\"num\">13,50 €<\/span><span class=\"mut\">Pot 30g<\/span><\/div>\n          <div class=\"cta\">\n            <button class=\"btn scroll-to-top\">Ajouter au panier<\/button>\n            <button class=\"btn sec\" onclick=\"document.getElementById('charcoal-contents')?.scrollIntoView({behavior:'smooth'})\">Découvrir plus<\/button>\n          <\/div>\n        <\/div>\n      <\/div>\n    <\/section>\n\n    <!-- DESCRIPTION -->\n    <section id=\"charcoal-contents\" class=\"grid cards reveal\">\n      <div class=\"card\">\n        <h2 class=\"u\">Le vrai blanchiment naturel<\/h2>\n        <p>Le charbon actif, c’est le secret ancestral pour un sourire éclatant.<br><br>\n        Issu de la noix de coco, il polit en douceur les dents, absorbe les taches (café, thé, tabac…) et détoxifie la bouche sans agresser l’émail.<br><br>\n        Le Charcoal Optiz, c’est le blanchiment réinventé : sans fluor, sans mousse, sans produits chimiques.<br>\n        Un sourire plus blanc, une haleine plus fraîche, et une bouche saine. Naturellement.<\/p>\n      <\/div>\n\n      <div class=\"card\">\n        <h2 class=\"u\">Bienfaits & composition<\/h2>\n        <div class=\"list\">\n          <div class=\"li\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M20 6L9 17l-5-5\"\/><\/svg>\n            <div><strong>Charbon actif de noix de coco (food grade)<\/strong> → élimine taches, toxines et pigments.<\/div>\n          <\/div>\n          <div class=\"li\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M20 6L9 17l-5-5\"\/><\/svg>\n            <div><strong>Argile bentonite<\/strong> → minéralise, purifie et combat les bactéries responsables de la mauvaise haleine.<\/div>\n          <\/div>\n          <div class=\"li\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M20 6L9 17l-5-5\"\/><\/svg>\n            <div><strong>Arôme naturel de menthe<\/strong> → fraîcheur propre, sans sucre ni menthol artificiel.<\/div>\n          <\/div>\n          <div class=\"li\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M20 6L9 17l-5-5\"\/><\/svg>\n            <div><strong>0 % fluor, 0 % plastique, 0 % perturbateurs endocriniens<\/strong> → formulé pour détoxifier, pas masquer.<\/div>\n          <\/div>\n        <\/div>\n      <\/div>\n\n      <div class=\"card\">\n        <h2 class=\"u\">Utilisation<\/h2>\n        <p>Humidifie ta brosse et trempe-la légèrement dans la poudre.<br><br>\n        Brosse-toi les dents doucement en cercles pendant 2 minutes.<br>\n        Crache puis rince soigneusement à l’eau froide.<br><br>\n        Utilise 2 à 4 fois par semaine.<br><br>\n        💡 <strong>Astuce :<\/strong> laisse agir 30 secondes sur les zones les plus jaunies avant de rincer pour un effet renforcé.<\/p>\n      <\/div>\n    <\/section>\n\n    <div class=\"hr reveal\"><\/div>\n\n    <!-- CONCLUSION -->\n    <section class=\"reveal\" style=\"text-align:center\">\n      <h2 class=\"u\">Résultat : un sourire éclatant sans abîmer l’émail<\/h2>\n      <p style=\"margin-bottom:16px\">Grâce à sa texture ultra fine et sa formule minéralisante, le Charcoal Optiz blanchit sans abrasion.<br>\n      Un soin pur, efficace et doux — pour des dents plus blanches et une bouche saine, jour après jour.<\/p>\n      <button class=\"btn scroll-to-top\">Ajouter au panier<\/button>\n    <\/section>\n  <\/div>\n\n  <script>\n    (function(){\n      const els=document.querySelectorAll('#charcoal-optiz-desc .reveal');\n      const io=new IntersectionObserver((entries)=>{\n        entries.forEach(e=>{\n          if(e.isIntersecting){e.target.classList.add('show');io.unobserve(e.target);}\n        });\n      },{threshold:.12});\n      els.forEach(el=>io.observe(el));\n    })();\n\n    document.querySelectorAll('#charcoal-optiz-desc .scroll-to-top').forEach(btn=>{\n      btn.addEventListener('click',()=>{\n        const target=document.querySelector('form[action*=\"\/cart\"] button[name=\"add\"], button[name=\"add\"]');\n        if(target){\n          target.scrollIntoView({behavior:'smooth',block:'center'});\n          target.classList.add('highlight-cart');\n          setTimeout(()=>target.classList.remove('highlight-cart'),2000);\n        }else{\n          window.scrollTo({top:0,behavior:'smooth'});\n        }\n      });\n    });\n  <\/script>\n<\/div>","color_scheme":"","section_width":"full-width","padding-block-start":0,"padding-block-end":0}},"avant_apres_BbpxYX":{"type":"avant-apres","name":"Avant \/ Après (slider)","settings":{"bg_color":"#ffffff","padding_y":32,"heading":"Avant \/ Après","heading_size":32,"text_align":"center","before_image":"shopify:\/\/shop_images\/dos_boutonneux.webp","after_image":"shopify:\/\/shop_images\/ChatGPT_Image_27_janv._2026_21_24_57.png","aspect_ratio":"1 \/ 1","fit_mode":"cover","frame_bg":"#f2f2f2","radius":16,"max_width":900,"start":50,"handle_bg":"#ffffff","handle_color":"#111111","range_accent":"#111111","caption":"<p>Filtre l'eau de ta douche<\/p>","heading_2":"Ta peau absorbe tout","heading2_size":22,"text_2":"<p>Elle te le rendra<\/p>","text_size":16,"text2_size":16}},"custom_liquid_xtxE4Q":{"type":"custom-liquid","name":"t:names.custom_liquid","settings":{"custom_liquid":"<div id=\"mastic-optiz-desc\" class=\"sd\">\n  <style>\n    