,"type_preset":"h4","width":"100%","alignment":"left","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","color":"var(--color-foreground)","padding-block-start":4,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"custom_liquid_fUcjRY":{"type":"custom-liquid","name":"t:names.custom_liquid","settings":{"custom_liquid":"<ul style=\"list-style: none; padding: 0; font-family: 'Open Sans', sans-serif; font-size: 1rem; color: #212121; line-height: 1.3; margin: 0;\">\n  \n  <li style=\"display: flex; align-items: center; margin-bottom: 0.25rem;\">\n    <span style=\"color: #FF0000; font-weight: bold; margin-right: 0.35rem; display: flex; align-items: center;\">\n      <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" width=\"14\" height=\"14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\">\n        <path d=\"M20 6L9 17l-5-5\"\/>\n      <\/svg>\n    <\/span>Nettoie naturellement les dents\n  <\/li>\n\n  <li style=\"display: flex; align-items: center; margin-bottom: 0.25rem;\">\n    <span style=\"color: #FF0000; font-weight: bold; margin-right: 0.35rem; display: flex; align-items: center;\">\n      <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" width=\"14\" height=\"14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\">\n        <path d=\"M5 13l4 4L19 7\"\/>\n      <\/svg>\n    <\/span>Antibactérien et sans fluor\n  <\/li>\n\n  <li style=\"display: flex; align-items: center; margin-bottom: 0.25rem;\">\n    <span style=\"color: #FF0000; font-weight: bold; margin-right: 0.35rem; display: flex; align-items: center;\">\n      <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" width=\"14\" height=\"14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\">\n        <path d=\"M4 12h16M4 6h16M4 18h16\"\/>\n      <\/svg>\n    <\/span>Rafraîchit durablement l’haleine\n  <\/li>\n\n  <li style=\"display: flex; align-items: center; margin-bottom: 0.25rem;\">\n    <span style=\"color: #FF0000; font-weight: bold; margin-right: 0.35rem; display: flex; align-items: center;\">\n      <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" width=\"14\" height=\"14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\">\n        <path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"\/>\n      <\/svg>\n    <\/span>100 % biodégradable\n  <\/li>\n\n  <li style=\"display: flex; align-items: center; margin-bottom: 0;\">\n    <span style=\"color: #FF0000; font-weight: bold; margin-right: 0.35rem; display: flex; align-items: center;\">\n      <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" width=\"14\" height=\"14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\">\n        <circle cx=\"12\" cy=\"12\" r=\"10\"\/><path d=\"M12 8v8M8 12h8\"\/>\n      <\/svg>\n    <\/span>Renforce les gencives naturellement\n  <\/li>\n\n<\/ul>"},"blocks":{}},"custom_liquid_bzMjyJ":{"type":"custom-liquid","name":"t:names.custom_liquid","settings":{"custom_liquid":"<div class=\"stockline\" data-delivery-days=\"4\" role=\"status\" aria-live=\"polite\">\n  <span class=\"stock-dot\" aria-hidden=\"true\"><i><\/i><\/span>\n\n  <p class=\"stock-copy\">\n    <span class=\"green\">En stock (limité)<\/span><span class=\"rest\"> : Commandez maintenant et recevez-le\n      <span class=\"nowrap\">avant le <span class=\"date\" data-delivery-date>--\/--\/----<\/span><\/span>\n    <\/span>\n  <\/p>\n<\/div>\n\n<style>\n  :root{\n    --green:#46c14b;\n  }\n\n  .stockline{\n    display:flex;\n    align-items:flex-start; \/* point aligné au début du texte *\/\n    gap: 10px;\n  }\n\n  \/* reset du <p> (sinon Shopify met des marges qui cassent tout) *\/\n  .stockline .stock-copy{\n    margin:0;\n    padding:0;\n    font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;\n    font-size: 16px;         \/* un peu plus petit *\/\n    line-height: 1.35;\n    color:#333;\n  }\n\n  .stockline .green{\n    color: var(--green);\n    font-weight: 600;\n  }\n\n  .stockline .rest{\n    font-weight: 500;\n  }\n\n  .stockline .date{\n    font-weight: 800;\n    color:#111;\n  }\n\n  \/* Important: empêche \"avant le\" d’être séparé de la date *\/\n  .stockline .nowrap{\n    white-space: nowrap;\n  }\n\n  \/* Point + halo *\/\n  .stockline .stock-dot{\n    position:relative;\n    width:16px;\n    height:16px;\n    flex:0 0 16px;\n    margin-top: 3px; \/* petit ajustement visuel comme sur l’exemple *\/\n  }\n\n  .stockline .stock-dot::before{\n    content:\"\";\n    position:absolute;\n    inset:0;\n    border-radius:999px;\n    background: rgba(70,193,75,.18);\n  }\n\n  .stockline .stock-dot > i{\n    position:absolute;\n    left:50%;\n    top:50%;\n    width:8px;\n    height:8px;\n    transform:translate(-50%,-50%);\n    border-radius:999px;\n    background: var(--green);\n  }\n\n  \/* halo animé *\/\n  .stockline .stock-dot::after{\n    content:\"\";\n    position:absolute;\n    left:50%;\n    top:50%;\n    width:8px;\n    height:8px;\n    transform:translate(-50%,-50%) scale(1);\n    border-radius:999px;\n    background: rgba(70,193,75,.22);\n    animation: stockPulse 1.8s ease-out infinite;\n  }\n\n  @keyframes stockPulse{\n    0%   { transform: translate(-50%,-50%) scale(1);   opacity: .55; }\n    60%  { transform: translate(-50%,-50%) scale(2.6); opacity: .12; }\n    100% { transform: translate(-50%,-50%) scale(3.1); opacity: 0; }\n  }\n<\/style>\n\n<script>\n(function(){\n  function addDaysLocal(date, days){\n    const d = new Date(date);\n    d.setDate(d.getDate() + days);\n    return d;\n  }\n\n  function formatFR(date){\n    return new Intl.DateTimeFormat('fr-FR', {\n      day: '2-digit',\n      month: '2-digit',\n      year: 'numeric'\n    }).format(date);\n  }\n\n  function msUntilNextMidnight(){\n    const now = new Date();\n    const next = new Date(now);\n    next.setHours(24,0,0,0);\n    return next - now;\n  }\n\n  function updateOne(block){\n    const days = parseInt(block.getAttribute('data-delivery-days') || '4', 10);\n    const dateEl = block.querySelector('[data-delivery-date]');\n    if(!dateEl) return;\n\n    const deliverBy = addDaysLocal(new Date(), days);\n    dateEl.textContent = formatFR(deliverBy);\n  }\n\n  function init(){\n    const blocks = document.querySelectorAll('.stockline');\n    blocks.forEach(updateOne);\n\n    \/\/ refresh à minuit (une seule boucle pour tous les blocs)\n    (function schedule(){\n      setTimeout(() => {\n        blocks.forEach(updateOne);\n        schedule();\n      }, msUntilNextMidnight() + 50);\n    })();\n\n    \/\/ si l’onglet redevient actif, on recalcule\n    window.addEventListener('focus', () => blocks.forEach(updateOne));\n    document.addEventListener('visibilitychange', () => {\n      if(!document.hidden) blocks.forEach(updateOne);\n    });\n  }\n\n  if(document.readyState === 'loading'){\n    document.addEventListener('DOMContentLoaded', init);\n  } else {\n    init();\n  }\n})();\n<\/script>"},"blocks":{}},"text_gXMUag":{"type":"text","name":"Product description","settings":{"text":"{{ closest.product.description }}","width":"100%","max_width":"normal","alignment":"left","type_preset":"rte","font":"var(--font-primary--family)","font_size":"","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"variant_picker_R3rGDr":{"type":"variant-picker","settings":{"variant_style":"buttons","show_swatches":true,"alignment":"left","padding-block-start":12,"padding-block-end":24,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"product_inventory_ibhciA":{"type":"product-inventory","name":"t:names.product_inventory","disabled":true,"settings":{"inventory_threshold":10,"show_inventory_quantity":true,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"buy_buttons_eYQEYi":{"type":"buy-buttons","settings":{"stacking":false,"show_pickup_availability":false,"gift_card_form":true,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{"quantity":{"type":"quantity","static":true,"settings":{},"blocks":{}},"add-to-cart":{"type":"add-to-cart","static":true,"settings":{"style_class":"button"},"blocks":{}},"accelerated-checkout":{"type":"accelerated-checkout","static":true,"settings":{},"blocks":{}}},"block_order":[]}},"block_order":["product_title_tefwj7","reviews","price_a7krng","custom_liquid_fUcjRY","custom_liquid_bzMjyJ","text_gXMUag","variant_picker_R3rGDr","product_inventory_ibhciA","buy_buttons_eYQEYi"]}},"custom_css":[".add-to-cart-button {background: #f00; box-shadow: 0 4px 8px rgba(255, 0, 0, 0.25);}",".name-option,h2 {font-weight: 700; color: #212121;}",".price {font-weight: 700; color: #f00; font-size: 30px;}",".price__badge-sale {font-weight: 700; background: #f00; color: #fff;}",".quantity-selector {background: #e4e4e4; box-shadow: 0 4px 8px rgba(0, 0, 0, 0.25);}",".shopify-payment-button__button {background: #212121; box-shadow: 0 4px 8px rgba(0, 0, 0, 0.25);}","@media (min-width: 1024px) {.product-media {transform: scale(1); transform-origin: center; }}"],"settings":{"content_width":"content-center-aligned","desktop_media_position":"left","equal_columns":false,"limit_details_width":false,"gap":20,"color_scheme":"scheme-1","padding-block-start":100,"padding-block-end":0}},"custom_liquid_MKgeHC":{"type":"custom-liquid","name":"t:names.custom_liquid","settings":{"custom_liquid":"<!-- Google Fonts -->\n<link href=\"https:\/\/fonts.googleapis.com\/css2?family=Roboto:wght@700&display=swap\" rel=\"stylesheet\">\n\n<style>\n  \/* Wrapper du ticker *\/\n  .full-page-ticker-wrapper {\n    width: 100%; \/* ne pas utiliser 100vw, évite le débordement horizontal *\/\n    background-color: #ffffff;\n    border-top: 3px solid #FF0000;\n    border-bottom: 3px solid #FF0000;\n    overflow: hidden;\n    position: relative; \/* pas de position fixe -> ne chevauche pas le reste *\/\n    z-index: 1; \/* faible priorité visuelle *\/\n    padding: 12px 0;\n    box-sizing: border-box; \/* pour que les bordures comptent dans la largeur *\/\n  }\n\n  \/* Texte du ticker *\/\n  .ticker-text {\n    display: inline-block;\n    padding-left: 100%;\n    white-space: nowrap;\n    font-family: 'Roboto', sans-serif;\n    font-weight: 700;\n    font-size: 16px;\n    letter-spacing: 0.08em;\n    color: #FF0000;\n    text-transform: uppercase;\n    animation: tickerScroll 28s linear infinite;\n  }\n\n  \/* Animation du défilement *\/\n  @keyframes tickerScroll {\n    0% {\n      transform: translateX(0%);\n    }\n    100% {\n      transform: translateX(-100%);\n    }\n  }\n<\/style>\n\n<div class=\"full-page-ticker-wrapper\">\n  <div class=\"ticker-text\">\n    FORCE & CONFIANCE ! LOOK IMPACTANT ! PRODUITS NATURELS ! SANTÉ & VITALITÉ ! FORCE & CONFIANCE ! LOOK IMPACTANT ! PRODUITS NATURELS ! SANTÉ & VITALITÉ ! FORCE & CONFIANCE ! LOOK IMPACTANT ! PRODUITS NATURELS ! SANTÉ & VITALITÉ !\n  <\/div>\n<\/div>","color_scheme":"","section_width":"full-width","padding-block-start":0,"padding-block-end":40}},"custom_liquid_TrEHJq":{"type":"custom-liquid","custom_css":["{margin-top: -50px;}"],"name":"t:names.custom_liquid","settings":{"custom_liquid":"<div id=\"siwak-optiz-desc\" class=\"sd\">\n  <style>\n    .sd { --red:#FF0000; --blk:#212121; --mut:#6f6f6f; --bg:#ffffff; --card:#f7f7f7;\n      font-family:system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial; color:var(--blk);}\n    .sd *{box-sizing:border-box}\n    .sd .wrap{max-width:1080px;margin:auto;padding:clamp(18px,3.5vw,36px)}\n    .sd .grid{display:grid;gap:clamp(16px,2vw,24px)}\n    .sd .hero{position:relative;overflow:hidden;border-radius:18px;background:linear-gradient(135deg,var(--blk),#5c5c5c)}\n    .sd .hero::after{content:\"\";position:absolute;inset:-40% -20% auto -20%;height:120%;background:\n      radial-gradient(1200px 400px at 20% 10%, rgba(255,0,0,.25), transparent 60%),\n      radial-gradient(900px 300px at 90% 0%, rgba(255,0,0,.18), transparent 60%);\n      filter:blur(2px);pointer-events:none;}\n    .sd .hero-inner{display:grid;grid-template-columns:1.1fr .9fr;gap:28px;padding:36px;align-items:center}\n    @media (max-width:900px){ .sd .hero-inner{grid-template-columns:1fr;padding:24px}}\n    .sd h1{margin:0;font-size:clamp(28px,5vw,48px);line-height:1.05;letter-spacing:-.02em;color:#fff}\n    .sd .sub{color:#f0f0f0;font-size:clamp(14px,1.6vw,18px);opacity:.9;margin-top:8px}\n    .sd .badge{display:inline-flex;align-items:center;gap:8px;background:#ffffff10;border:1px solid #ffffff30;color:#fff;padding:8px 12px;border-radius:999px;font-weight:600}\n    .sd .badge svg{width:16px;height:16px}\n    .sd .hero-card{background:#fff;border-radius:16px;padding:18px;border:1px solid #eaeaea;box-shadow:0 10px 30px rgba(0,0,0,.08)}\n    .sd .price{display:flex;align-items:baseline;gap:10px}\n    .sd .price .num{font-size:34px;font-weight:800;color:var(--blk)}\n    .sd .cta{margin-top:10px;display:flex;gap:10px;flex-wrap:wrap}\n    .sd .btn{appearance:none;border:none;background:var(--red);color:#fff;padding:14px 18px;border-radius:12px;font-weight:800;letter-spacing:.2px;cursor:pointer;transition:transform .2s ease, box-shadow .2s ease}\n    .sd .btn:hover{transform:translateY(-2px);box-shadow:0 8px 20px rgba(255,0,0,.25)}\n    .sd .btn.sec{background:#fff;color:var(--blk);border:1px solid #dcdcdc}\n    .sd .cards{grid-template-columns:repeat(3,1fr)}\n    @media (max-width:960px){.sd .cards{grid-template-columns:1fr}}\n    .sd .card{background:#fff;border:1px solid #ececec;border-radius:16px;padding:16px;box-shadow:0 8px 22px rgba(0,0,0,.05)}\n    .sd .list{display:grid;gap:10px;margin-top:10px}\n    .sd .li{display:flex;gap:12px}\n    .sd .li svg{width:18px;height:18px;margin-top:2px;color:var(--red)}\n    .sd .hr{height:1px;background:linear-gradient(90deg,transparent,#e8e8e8,transparent);margin:28px 0}\n    .sd .band{background:linear-gradient(90deg,#fff 0,#fff 40%, #ffe6e6 100%);border:1px solid #ffe1e1;padding:16px;border-radius:14px;display:grid;grid-template-columns:auto 1fr;gap:12px;align-items:center}\n    .sd .band svg{width:28px;height:28px;color:var(--red)}\n    .sd .reveal{opacity:0;transform:translateY(16px);transition:opacity .7s ease,transform .7s cubic-bezier(.2,.7,.2,1)}\n    .sd .reveal.show{opacity:1;transform:none}\n    .sd .u{position:relative;display:inline-block}\n    .sd .u::after{content:\"\";position:absolute;left:0;right:0;bottom:-6px;height:3px;background:linear-gradient(90deg,var(--red),transparent)}\n    .highlight-cart{box-shadow:0 0 20px 5px rgba(255,0,0,.6)!important;transform:scale(1.05);transition:all .4s ease}\n    .sd h2 { font-size: clamp(20px, 2.6vw, 26px); margin: 0; line-height: 1.2; }\n    .sd .card p { margin-top: 4px; }\n\n    \/* 🔥 MODIFS DESKTOP UNIQUEMENT POUR AGRANDIR LES 3 CARTES *\/\n    @media (min-width: 961px){\n      .sd .wrap{\n        max-width:100%;\n        width:100%;\n        padding-left:1vw;\n        padding-right:1vw;\n      }\n      .sd .cards{\n        grid-template-columns:repeat(3, minmax(0,1fr));\n        gap:8px; \/* gouttières réduites = cartes plus larges *\/\n      }\n      .sd .card{\n        padding:26px; \/* cartes plus “massives” sur ordi *\/\n      }\n    }\n  <\/style>\n\n  <div class=\"wrap\">\n    <!-- HERO -->\n    <section class=\"hero\">\n      <div class=\"hero-inner\">\n        <div class=\"reveal\">\n          <h1>Siwak Optiz<\/h1>\n          <p class=\"sub\">Le retour à la vraie hygiène buccale : simple, efficace et 100 % naturelle.<\/p>\n          <div class=\"badge\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M3 12l18 0\"\/><\/svg>\n            Bois de Salvadora persica naturel\n          <\/div>\n        <\/div>\n        <div class=\"hero-card reveal\">\n          <h2 class=\"u\">L’efficacité sans chimie<\/h2>\n          <p>Un soin buccal ancestral, pur et antibactérien. Le Siwak Optiz nettoie, renforce et rafraîchit sans mousse, sans plastique, sans fluor.<\/p>\n          <div class=\"price\"><span class=\"num\">11,50 €<\/span> <span class=\"mut\">Bâton naturel<\/span><\/div>\n          <div class=\"cta\">\n            <button class=\"btn scroll-to-top\">Ajouter au panier<\/button>\n            <button class=\"btn sec\" onclick=\"document.getElementById('siwak-contents')?.scrollIntoView({behavior:'smooth'})\">Découvrir plus<\/button>\n          <\/div>\n        <\/div>\n      <\/div>\n    <\/section>\n\n    <!-- CONTENU -->\n    <section id=\"siwak-contents\" class=\"grid cards reveal\">\n      <div class=\"card\">\n        <h2 class=\"u\">Le vrai soin ancestral<\/h2>\n        <p>Bien avant les dentifrices industriels, nos ancêtres utilisaient le siwak, bâton naturel de l’arbre Salvadora persica, pour nettoyer les dents, renforcer les gencives et rafraîchir l’haleine.<br><br>\n        Le Siwak Optiz, c’est ce geste ancestral revisité : une hygiène buccale simple, naturelle et 100 % efficace.<\/p>\n      <\/div>\n\n      <div class=\"card\">\n        <h2 class=\"u\">Bienfaits & composition<\/h2>\n        <div class=\"list\">\n          <div class=\"li\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M20 6L9 17l-5-5\"\/><\/svg>\n            <div><strong>Antibactérien naturel<\/strong> → réduit la plaque et prévient les caries.<\/div>\n          <\/div>\n          <div class=\"li\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M20 6L9 17l-5-5\"\/><\/svg>\n            <div><strong>Renforce les gencives<\/strong> → grâce aux tanins et minéraux qu’il contient.<\/div>\n          <\/div>\n          <div class=\"li\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M20 6L9 17l-5-5\"\/><\/svg>\n            <div><strong>Rafraîchit l’haleine durablement<\/strong> → sans menthol artificiel ni sucre.<\/div>\n          <\/div>\n          <div class=\"li\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M20 6L9 17l-5-5\"\/><\/svg>\n            <div><strong>100 % biodégradable<\/strong> → zéro plastique, zéro déchet.<\/div>\n          <\/div>\n          <div class=\"li\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M20 6L9 17l-5-5\"\/><\/svg>\n            <div><strong>Aucun perturbateur endocrinien<\/strong> → une bouche saine, naturellement.<\/div>\n          <\/div>\n        <\/div>\n      <\/div>\n\n      <div class=\"card\">\n        <h2 class=\"u\">Utilisation<\/h2>\n        <p>Coupe une fine extrémité, mâche-la pour former une brosse.<br>\n        Brosse les dents quelques minutes.<br>\n        Avant chaque usage → remâche légèrement pour réactiver les agents naturels.<br>\n        Quand le goût s’estompe ou qu’il ne blanchit plus → recoupe l’extrémité.<br>\n        Rince et laisse sécher.<br><br>\n        💡 <strong>Astuce :<\/strong> trempe le bout dans un peu d’eau citronnée ou de menthe naturelle pour plus de fraîcheur.<\/p>\n      <\/div>\n    <\/section>\n\n    <div class=\"hr reveal\"><\/div>\n\n    <!-- CONCLUSION -->\n    <section class=\"reveal\" style=\"text-align:center\">\n      <h2 class=\"u\">Redécouvre le geste ancestral du soin buccal<\/h2>\n      <p style=\"margin-bottom:16px\">Minimaliste, pur et efficace : le Siwak Optiz te ramène à l’essentiel. Zéro plastique, zéro mousse, zéro compromis.<\/p>\n      <button class=\"btn scroll-to-top\">Ajouter au panier<\/button>\n    <\/section>\n  <\/div>\n\n  <script>\n    (function(){\n      const els=document.querySelectorAll('#siwak-optiz-desc .reveal');\n      const io=new IntersectionObserver((entries)=>{\n        entries.forEach(e=>{\n          if(e.isIntersecting){e.target.classList.add('show');io.unobserve(e.target);}\n        });\n      },{threshold:.12});\n      els.forEach(el=>io.observe(el));\n    })();\n\n    document.querySelectorAll('#siwak-optiz-desc .scroll-to-top').forEach(btn=>{\n      btn.addEventListener('click',()=>{\n        const target=document.querySelector('form[action*=\"\/cart\"] button[name=\"add\"], button[name=\"add\"]');\n        if(target){\n          target.scrollIntoView({behavior:'smooth',block:'center'});\n          target.classList.add('highlight-cart');\n          setTimeout(()=>target.classList.remove('highlight-cart'),2000);\n        }else{\n          window.scrollTo({top:0,behavior:'smooth'});\n        }\n      });\n    });\n  <\/script>\n\n<\/div>","color_scheme":"","section_width":"full-width","padding-block-start":0,"padding-block-end":0}},"image_defile_gkW6Bw":{"type":"image_defile","blocks":{"image_Vp6t33":{"type":"image","settings":{"img":"shopify:\/\/shop_images\/hakim_pose.jpg"}},"image_DA3yUV":{"type":"image","settings":{"img":"shopify:\/\/shop_images\/hakim_pose_2.jpg"}},"image_z4Vihd":{"type":"image","settings":{"img":"shopify:\/\/shop_images\/hakim_pose.jpg"}},"image_TdEKQc":{"type":"image","settings":{"img":"shopify:\/\/shop_images\/hakim_pose_2.jpg"}},"image_RMVVxX":{"type":"image","settings":{"img":"shopify:\/\/shop_images\/hakim_pose.jpg"}},"image_PBMnLD":{"type":"image","settings":{"img":"shopify:\/\/shop_images\/hakim_pose_2.jpg"}}},"block_order":["image_Vp6t33","image_DA3yUV","image_z4Vihd","image_TdEKQc","image_RMVVxX","image_PBMnLD"],"custom_css":[],"name":"Barre d'images","settings":{"image_height":260,"speed":52,"background_color":"#ffffff"}},"1762162908837e6a1b":{"type":"_blocks","blocks":{"klaviyo_reviews_product_reviews_NDeej8":{"type":"shopify:\/\/apps\/klaviyo-reviews\/blocks\/product-reviews\/db20e365-d984-4ac4-9655-e1588d951ca9","settings":{}}