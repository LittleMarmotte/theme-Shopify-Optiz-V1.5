-spacing:.08em;\n    padding:6px 10px;\n    border-radius:999px;\n    background:rgba(255,200,90,.18);\n    border:1px solid rgba(255,200,90,.5);\n    margin-bottom:10px;\n    color:#7a5600;\n  }\n\n  .gold-card h3{\n    margin:6px 0 10px;\n    font-size:22px;\n    font-weight:900;\n    letter-spacing:-.02em;\n  }\n\n  .gold-card p{\n    margin:0 0 10px;\n    font-size:15px;\n    line-height:1.5;\n    color:#333;\n  }\n\n  .gold-card .highlight{\n    font-weight:700;\n    color:#7a5600;\n  }\n\n  .gold-card .highlight span{\n    font-weight:600;\n    opacity:.85;\n  }\n\n  .gold-card .note{\n    margin-top:6px;\n    font-size:12px;\n    letter-spacing:.08em;\n    text-transform:uppercase;\n    color:#666;\n  }\n\n  \/* Reflet doré léger *\/\n  .gold-card .shine{\n    position:absolute;\n    inset:-40% -60%;\n    background:linear-gradient(\n      120deg,\n      transparent 40%,\n      rgba(255,215,120,.25) 50%,\n      transparent 60%\n    );\n    transform:rotate(8deg);\n    animation:shine 6s ease-in-out infinite;\n    pointer-events:none;\n  }\n\n  @keyframes shine{\n    0%,40%{transform:translateX(-30%) rotate(8deg); opacity:0;}\n    50%{opacity:.6;}\n    65%{opacity:.2;}\n    100%{transform:translateX(30%) rotate(8deg); opacity:0;}\n  }\n<\/style>"},"blocks":{}},"text_gXMUag":{"type":"text","name":"Product description","settings":{"text":"{{ closest.product.description }}","width":"100%","max_width":"normal","alignment":"left","type_preset":"rte","font":"var(--font-primary--family)","font_size":"","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"variant_picker_R3rGDr":{"type":"variant-picker","settings":{"variant_style":"buttons","show_swatches":true,"alignment":"left","padding-block-start":12,"padding-block-end":24,"padding-inline-start":0,"paddin