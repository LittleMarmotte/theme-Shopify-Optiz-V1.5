isplay=swap\" rel=\"stylesheet\">\n\n<style>\n  \/* Wrapper du ticker *\/\n  .full-page-ticker-wrapper {\n    width: 100%; \/* ne pas utiliser 100vw, évite le débordement horizontal *\/\n    background-color: #ffffff;\n    border-top: 3px solid #FF0000;\n    border-bottom: 3px solid #FF0000;\n    overflow: hidden;\n    position: relative; \/* pas de position fixe -> ne chevauche pas le reste *\/\n    z-index: 1; \/* faible priorité visuelle *\/\n    padding: 12px 0;\n    box-sizing: border-box; \/* pour que les bordures comptent dans la largeur *\/\n  }\n\n  \/* Texte du ticker *\/\n  .ticker-text {\n    display: inline-block;\n    padding-left: 100%;\n    white-space: nowrap;\n    font-family: 'Roboto', sans-serif;\n    font-weight: 700;\n    font-size: 16px;\n    letter-spacing: 0.08em;\n    color: #FF0000;\n    text-transform: uppercase;\n    animation: tickerScroll 28s linear infinite;\n  }\n\n  \/* Animation du défilement *\/\n  @keyframes tickerScroll {\n    0% {\n      transform: translateX(0%);\n    }\n    100% {\n      transform: translateX(-100%);\n    }\n  }\n<\/style>\n\n<div class=\"full-page-ticker-wrapper\">\n  <div class=\"ticker-text\">\n    FORCE & CONFIANCE ! LOOK IMPACTANT ! PRODUITS NATURELS ! SANTÉ & VITALITÉ ! FORCE & CONFIANCE ! LOOK IMPACTANT ! PRODUITS NATURELS ! SANTÉ & VITALITÉ ! FORCE & CONFIANCE ! LOOK IMPACTANT ! PRODUITS NATURELS ! SANTÉ & VITALITÉ !\n  <\/div>\n<\/div>","color_scheme":"","section_width":"full-width","padding-block-start":0,"padding-block-end":40}},"custom_liquid_Pjdje9":{"type":"custom-liquid","custom_css":["{margin-top: -20px;}"],"name":"t:names.custom_liquid","settings":{"custom_liquid":"<section id=\"promesse\" class=\"promise promise--compact\">\n  <canvas class=\"promise__fx\" aria-hidden=\"true\"><\/canvas>\n\n  <h2 class=\"promise__headline\" data-animate>\n    Obtient une peau lisse en <span class=\"accent\">30j<\/span> sans dizaine de produit skincare\n    <br>\n    même si tu as une peau <span class=\"accent\">sensible<\/span>.\n  <\/h2>\n\n  <span class=\"promise__comet\" aria-hidden=\"true\"><\/span>\n<\/section>\n\n<style>\n  :root {\n    --red: #FF0000;\n    --black: #212121;\n    --white: #FFFFFF;\n  }\n\n  .promise {\n    position: relative;\n    isolation: isolate;\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    align-items: center;\n    background: var(--white);\n    overflow: hidden;\n    padding: 80px 10px;\n    text-align: center;\n    gap: 18px;\n  }\n\n  \/* fond subtil *\/\n  .promise::before {\n    content: \"\";\n    position: absolute; inset: 0;\n    background:\n      radial-gradient(40vmax 40vmax at 50% 50%, rgba(255,0,0,.05), transparent 70%),\n      repeating-linear-gradient(to right, rgba(255,0,0,.015) 0 1px, transparent 1px 100px),\n      repeating-linear-gradient(to bottom, rgba(255,0,0,.015) 0 1px, transparent 1px 100px);\n    z-index: 0;\n  }\n\n  .promise__headline {\n    position: relative;\n    z-index: 2;\n    max-width: 950px;\n    font-weight: 800;\n    font-size: clamp(26px, 4.5vw, 60px);\n    line-height: 1.1;\n    color: var(--black);\n    margin: 0;\n    opacity: 0;\n    transform: translateY(15px);\n    transition: opacity 1s ease, transform 1s ease;\n  }\n\n  .promise__headline[data-animate=\"on\"] {\n    opacity: 1;\n    transform: translateY(0);\n  }\n\n  \/* mots rouges avec halo animé *\/\n  .promise__headline em,\n  .promise__headline .accent {\n    color: var(--red);\n    font-style: normal;\n    position: relative;\n    text-shadow:\n      0 0 8px rgba(255, 0, 0, 0.3),\n      0 0 20px rgba(255, 0, 0, 0.15),\n      0 0 40px rgba(255, 0, 0, 0.1);\n    animation: glowPulse 4s ease-in-out infinite;\n  }\n\n  @keyframes glowPulse {\n    0%,100% {\n      text-shadow:\n        0 0 8px rgba(255, 0, 0, 0.35),\n        0 0 20px rgba(255, 0, 0, 0.15),\n        0 0 40px rgba(255, 0, 0, 0.1);\n    }\n    50% {\n      text-shadow:\n        0 0 14px rgba(255, 0, 0, 0.5),\n        0 0 40px rgba(255, 0, 0, 0.25),\n        0 0 80px rgba(255, 0, 0, 0.15);\n    }\n  }\n\n  .promise__headline strong {\n    font-weight: 900;\n    color: var(--black);\n  }\n\n  .promise__headline u {\n    text-decoration: none;\n    background: linear-gradient(transparent 60%, rgba(255,0,0,0.15) 40%);\n  }\n\n  \/* halo global derrière tout le texte *\/\n  .promise__headline::before {\n    content: \"\";\n    position: absolute;\n    top: 50%; left: 50%;\n    transform: translate(-50%, -50%);\n    width: 130%;\n    height: 130%;\n    background: radial-gradient(circle, rgba(255,0,0,0.08), transparent 70%);\n    filter: blur(20px);\n    z-index: -1;\n    opacity: 0.6;\n    animation: haloPulse 6s ease-in-out infinite;\n  }\n\n  @keyframes haloPulse {\n    0%,100% { opacity: 0.5; transform: translate(-50%, -50%) scale(1); }\n    50%     { opacity: 0.8; transform: translate(-50%, -50%) scale(1.05); }\n  }\n\n  \/* comète rouge visible sous le texte *\/\n  .promise__comet {\n    position: absolute;\n    bottom: 20px;\n    left: -15%;\n    width: 30%;\n    height: 5px;\n    border-radius: 4px;\n    background: linear-gradient(90deg, rgba(255,0,0,0), var(--red), rgba(255,0,0,0));\n    filter: blur(1px);\n    z-index: 2;\n    animation: comet 5s cubic-bezier(.7,.05,.2,1) infinite;\n  }\n\n  .promise__comet::after {\n    content: \"\";\n    position: absolute;\n    right: -8px;\n    width: 10px;\n    height: 10px;\n    border-radius: 50%;\n    background: var(--red);\n    box-shadow:\n      0 0 10px rgba(255,0,0,.8),\n      0 0 25px rgba(255,0,0,.5),\n      0 0 60px rgba(255,0,0,.3);\n  }\n\n  @keyframes comet {\n    0%   { transform: translateX(0); opacity: 0; }\n    10%  { opacity: 1; }\n    50%  { transform: translateX(115vw); }\n    90%  { opacity: 1; }\n    100% { transform: translateX(160vw); opacity: 0; }\n  }\n\n  \/* Particules d’ambiance *\/\n  .promise__fx {\n    position: absolute;\n    inset: 0;\n    z-index: 0;\n    mix-blend-mode: multiply;\n    opacity: 0.25;\n    pointer-events: none;\n  }\n\n  @media (max-width: 600px) {\n    .promise {\n      padding: 60px 10px;\n      gap: 14px;\n    }\n    .promise__headline {\n      font-size: clamp(24px, 6vw, 42px);\n      line-height: 1.15;\n    }\n  }\n<\/style>\n\n<script>\n\/* === Animation d’apparition du texte === *\/\nconst headline = document.querySelector('.promise__headline');\n\nconst obs = new IntersectionObserver(entries => {\n  entries.forEach(e => {\n    if (e.isIntersecting) {\n      headline.setAttribute('data-animate','on');\n      obs.disconnect();\n    }\n  });\n}, {threshold: 0.3});\n\nobs.observe(headline);\n\n\/* === Particules rouges légères === *\/\nconst canvas = document.querySelector('.promise__fx');\nconst ctx = canvas.getContext('2d');\nlet w, h, dpr = Math.max(1, window.devicePixelRatio || 1);\nconst parts = [];\nconst COUNT = 50;\n\nfunction resize() {\n  w = canvas.clientWidth;\n  h = canvas.clientHeight;\n  canvas.width = w * dpr;\n  canvas.height = h * dpr;\n  ctx.setTransform(dpr,0,0,dpr,0,0);\n}\nwindow.addEventListener('resize', resize);\nresize();\n\nfunction rand(a,b){ return a + Math.random()*(b-a); }\n\nfor (let i=0;i<COUNT;i++) {\n  parts.push({x:rand(0,w),y:rand(0,h),r:rand(0.6,1.4),a:rand(0,Math.PI*2),s:rand(0.1,0.4)});\n}\n\nfunction loop(){\n  ctx.clearRect(0,0,w,h);\n  for(const p of parts){\n    p.x += Math.cos(p.a)*p.s;\n    p.y += Math.sin(p.a)*p.s;\n    if(p.x<0) p.x=w; if(p.x>w) p.x=0;\n    if(p.y<0) p.y=h; if(p.y>h) p.y=0;\n    ctx.beginPath();\n    const grad = ctx.createRadialGradient(p.x,p.y,0,p.x,p.y,p.r*5);\n    grad.addColorStop(0,`rgba(255,0,0,0.35)`);\n    grad.addColorStop(1,`rgba(255,0,0,0)`);\n    ctx.fillStyle=grad;\n    ctx.arc(p.x,p.y,p.r,0,Math.PI*2);\n    ctx.fill();\n  }\n  requestAnimationFrame(loop);\n}\nloop();\n<\/script>","color_scheme":"","section_width":"page-width","padding-block-start":0,"padding-block-end":0}},"avant_apres_6mEiFB":{"type":"avant-apres","custom_css":[],"name":"Avant \/ Après (slider)","settings":{"bg_color":"#ffffff","padding_y":32,"heading":"Avant \/ Après","heading_size":32,"text_align":"center","before_image":"shopify:\/\/shop_images\/dos_boutonneux.webp","after_image":"shopify:\/\/shop_images\/ChatGPT_Image_27_janv._2026_21_24_57.png","aspect_ratio":"1 \/ 1","fit_mode":"cover","frame_bg":"#f2f2f2","radius":16,"max_width":480,"start":50,"handle_bg":"#ffffff","handle_color":"#111111","range_accent":"#212121","caption":"","heading_2":"Le même dos, pas la même peau","heading2_size":22,"text_2":"<p><\/p><p>Utilise un vrai savon = Une belle peau<\/p><p>Une belle peau = Tu es bien plus beau<\/p>","text_size":16,"text2_size":16}},"custom_liquid_Jk3GQC":{"type":"custom-liquid","name":"t:names.custom_liquid","settings":{"custom_liquid":"<div id=\"mastic-optiz-desc\" class=\"sd\">\n  <style>\n    .sd { --red:#FF0000; --blk:#212121; --mut:#6f6f6f; --bg:#ffffff; --card:#f7f7f7;\n      font-family:system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial; color:var(--blk);}\n    .sd *{box-sizing:border-box}\n    .sd .wrap{max-width:1080px;margin:auto;padding:clamp(18px,3.5vw,36px)}\n    .sd .grid{display:grid;gap:clamp(16px,2vw,24px)}\n    .sd .hero{position:relative;overflow:hidden;border-radius:18px;background:linear-gradient(135deg,var(--blk),#5c5c5c)}\n    .sd .hero::after{content:\"\";position:absolute;inset:-40% -20% auto -20%;height:120%;background:\n      radial-gradient(1200px 400px at 20% 10%, rgba(255,0,0,.25), transparent 60%),\n      radial-gradient(900px 300px at 90% 0%, rgba(255,0,0,.18), transparent 60%);\n      filter:blur(2px);pointer-events:none;}\n    .sd .hero-inner{display:grid;grid-template-columns:1.1fr .9fr;gap:28px;padding:36px;align-items:center}\n    @media (max-width:900px){ .sd .hero-inner{grid-template-columns:1fr;padding:24px}}\n    .sd h4{margin:0;font-size:clamp(28px,5vw,48px);line-height:1.05;letter-spacing:-.02em;color:#fff}\n    .sd .sub{color:#f0f0f0;font-size:clamp(14px,1.6vw,18px);opacity:.9;margin-top:8px}\n    .sd .badge{display:inline-flex;align-items:center;gap:8px;background:#ffffff10;border:1px solid #ffffff30;color:#fff;padding:8px 12px;border-radius:999px;font-weight:600}\n    .sd .badge svg{width:16px;height:16px}\n    .sd .hero-card{background:#fff;border-radius:16px;padding:18px;border:1px solid #eaeaea;box-shadow:0 10px 30px rgba(0,0,0,.08)}\n    .sd .price{display:flex;align-items:baseline;gap:10px}\n    .sd .price .num{font-size:34px;font-weight:800;color:var(--blk)}\n    \/* CTA : une colonne pour que le bouton prenne toute la ligne *\/\n.sd .cta{\n  margin-top:10px;\n  display:flex;\n  flex-direction:column;\n  gap:10px;\n  align-items:stretch; \/* étire les enfants sur toute la largeur *\/\n}\n\n\/* Le bouton \"Ajouter au panier\" dans la CTA = 100% *\/\n.sd .cta .btn.scroll-to-top{\n  width:100%;\n  display:block;\n  text-align:center;\n}\n\n    .sd .btn{appearance:none;border:none;background:var(--red);color:#fff;padding:14px 18px;border-radius:12px;font-weight:800;letter-spacing:.2px;cursor:pointer;transition:transform .2s ease, box-shadow .2s ease}\n    .sd .btn:hover{transform:translateY(-2px);box-shadow:0 8px 20px rgba(255,0,0,.25)}\n    .sd .btn.sec{background:#fff;color:var(--blk);border:1px solid #dcdcdc}\n    .sd .cards{grid-template-columns:repeat(3,1fr)}\n    @media (max-width:960px){.sd .cards{grid-template-columns:1fr}}\n    .sd .card{background:#fff;border:1px solid #ececec;border-radius:16px;padding:18px;box-shadow:0 8px 22px rgba(0,0,0,.05)}\n    .sd .list{display:grid;gap:10px;margin-top:10px}\n    .sd .li{display:flex;gap:12px}\n    .sd .li svg{width:18px;height:18px;margin-top:2px;color:var(--red)}\n    .sd .hr{height:1px;background:linear-gradient(90deg,transparent,#e8e8e8,transparent);margin:28px 0}\n    .sd .band{background:linear-gradient(90deg,#fff 0,#fff 40%, #ffe6e6 100%);border:1px solid #ffe1e1;padding:16px;border-radius:14px;display:grid;grid-template-columns:auto 1fr;gap:12px;align-items:center}\n    .sd .band svg{width:28px;height:28px;color:var(--red)}\n    .sd .reveal{opacity:0;transform:translateY(16px);transition:opacity .7s ease,transform .7s cubic-bezier(.2,.7,.2,1)}\n    .sd .reveal.show{opacity:1;transform:none}\n    .sd .u{position:relative;display:inline-block}\n    .sd .u::after{content:\"\";position:absolute;left:0;right:0;bottom:-6px;height:3px;background:linear-gradient(90deg,var(--red),transparent)}\n    .highlight-cart{box-shadow:0 0 20px 5px rgba(255,0,0,.6)!important;transform:scale(1.05);transition:all .4s ease}\n    .sd h2 { font-size: clamp(20px, 2.6vw, 26px); margin: 0; line-height: 1.2; }\n    .sd .card { padding: 16px; }\n    .sd .card p { margin-top: 4px; }\n\n    \/* 🔥 MODIFS DESKTOP UNIQUEMENT (≥ 961px) POUR AGRANDIR LES 3 CARTES *\/\n    @media (min-width: 961px){\n      .sd .wrap{\n        max-width:100%;\n        width:100%;\n        padding-left:1vw;\n        padding-right:1vw;\n      }\n      .sd .cards{\n        grid-template-columns:repeat(3, minmax(0,1fr));\n        gap:8px; \/* gouttières réduites = cartes plus larges *\/\n      }\n      .sd .card{\n        padding:26px; \/* cartes plus “massives” sur ordi *\/\n      }\n    }\n  <\/style>\n\n  <div class=\"wrap\">\n    <!-- HERO -->\n    <section class=\"hero\">\n      <div class=\"hero-inner\">\n        <div class=\"reveal\">\n          <h4>Savon à froid artisanal<\/h4>\n          <p class=\"sub\">Un savon qui fait partie du TOP 1 % du marché.<\/p>\n          <div class=\"badge\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M12 2l4 4-4 4-4-4 4-4z\"\/><\/svg>\n            Karité, 6% de surgas\n          <\/div>\n        <\/div>\n        <div class=\"hero-card reveal\">\n          <h2 class=\"u\">Juste un savon TOP 1%<\/h2>\n          <p>Saponifié à froid, artisanal, avec 6% de surgras au beurre de karité. Formule pure, sans tensioactifs, sans huile de tournesol, sans silicone.\n<\/p>\n          <div class=\"price\"><span class=\"num\">12,50 €<\/span> <span class=\"mut\">Pain de 100g<\/span><\/div>\n          <div class=\"cta\">\n            <button class=\"btn scroll-to-top\">Ajouter au panier<\/button>\n          <\/div>\n        <\/div>\n      <\/div>\n    <\/section>\n    <div class=\"hr reveal\"><\/div>\n\n    <!-- CONCLUSION -->\n  <script>\n    (function(){\n      const els=document.querySelectorAll('#mastic-optiz-desc .reveal');\n      const io=new IntersectionObserver((entries)=>{\n        entries.forEach(e=>{\n          if(e.isIntersecting){e.target.classList.add('show');io.unobserve(e.target);}\n        });\n      },{threshold:.12});\n      els.forEach(el=>io.observe(el));\n    })();\n\n    document.querySelectorAll('#mastic-optiz-desc .scroll-to-top').forEach(btn=>{\n      btn.addEventListener('click',()=>{\n        const target=document.querySelector('form[action*=\"\/cart\"] button[name=\"add\"], button[name=\"add\"]');\n        if(target){\n          target.scrollIntoView({behavior:'smooth',block:'center'});\n          target.classList.add('highlight-cart');\n          setTimeout(()=>target.classList.remove('highlight-cart'),2000);\n        }else{\n          window.scrollTo({top:0,behavior:'smooth'});\n        }\n      });\n    });\n  <\/script>\n\n<\/div>","color_scheme":"","section_width":"page-width","padding-block-start":0,"padding-block-end":0}},"image_ttext_m_erXayk":{"type":"image-ttext-m","name":"Image carrée + texte","settings":{"image":"shopify:\/\/shop_images\/3_8d6ed0d5-02fd-408d-aec3-17b85d4ea354.jpg","square_size":400,"radius":16,"fit_mode":"cover","square_bg":"#f2f2f2","title":"Et si tu avais une peau parfaite ?","title_size":24,"text":"<p>Imagine comment avoir une peau parfaite pourrait te rendre plus beau.<\/p><p>Tu gagnerais combien de points sur 10 ?<\/p><p><br\/><\/p><p>En règle générale, quelqu’un avec une mauvaise peau gagne <strong>3 points sur 10<\/strong> avec une peau parfaite.<\/p><p><br\/><\/p><p>Alors tant mieux si tu as des boutons : tu peux régler ce problème et devenir <strong>une meilleure version de toi-même<\/strong>.<\/p>","text_size":16,"bg_color":"#ffffff","padding_y":12,"max_width":900}},"image_ttext_m_UNcfNX":{"type":"image-ttext-m","name":"Image carrée + texte","settings":{"image":"shopify:\/\/shop_images\/1_c1c2cef0-88cf-460b-a25e-ca651e96e4ad.jpg","square_size":400,"radius":16,"fit_mode":"cover","square_bg":"#f2f2f2","title":"Ce n’est pas de ta faute si tu as une peau pleine de boutons.","title_size":28,"text":"<p>En réalité, <strong>c’est toute une industrie qui t’a fait croire que<\/strong> t’appliquer une multitude de produits<strong> tous aussi mauvais les uns que les autres <\/strong>sur le corps et le visage allait te donner une belle peau.<\/p><p>Et quand des boutons apparaissent, on te dit que <strong>c’est normal<\/strong>, que c’est l’adolescence… tout en te tendant un autre produit pour « régler » le problème.<\/p>","text_size":16,"bg_color":"#ffffff","padding_y":16,"max_width":900}},"image_ttext_m_fNhUin":{"type":"image-ttext-m","name":"Image carrée + texte","settings":{"image":"shopify:\/\/shop_images\/2_e04947fe-7386-40c0-8a33-746856b4c23f.jpg","square_size":400,"radius":16,"fit_mode":"cover","square_bg":"#f2f2f2","title":"Il n’est pas trop tard pour ta peau.","title_size":28,"text":"<p>Tu as sûrement peur que tes boutons <strong>ne partent pas<\/strong>, qu’un très bon savon ne soit pas suffisant.<\/p><p>Mais ne sous-estime pas<strong> l’effet cumulé de toutes les merdes que tu te balances chaque jour sur le visage et le corps.<\/strong><br\/><\/p><p>En <strong>1 mois<\/strong>, tu verras déjà la différence.<\/p>","text_size":16,"bg_color":"#ffffff","padding_y":8,"max_width":900}},"custom_liquid_N7qpzt":{"type":"custom-liquid","custom_css":["{margin-top: 30px; margin-bottom: 30px;}"],"name":"t:names.custom_liquid","settings":{"custom_liquid":"<!DOCTYPE html>\n<html lang=\"fr\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Section Ingrédients - Style Optiz<\/title>\n  <style>\n    \/* Reset et base *\/\n    * {\n      margin: 0;\n      padding: 0;\n      box-sizing: border-box;\n    }\n\n    body {\n      font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif;\n      background-color: #ffffff;\n      color: #1a1a1a;\n      line-height: 1.6;\n      padding: 24px;\n    }\n\n    \/* Section principale *\/\n    .optiz-ingredients-section {\n      max-width: 800px;\n      margin: 0 auto;\n    }\n\n    \/* Accordéon *\/\n    .optiz-accordion {\n      margin-bottom: 32px;\n      border: 1px solid #e5e5e5;\n      border-radius: 16px;\n      background-color: #f8f8f8;\n      overflow: hidden;\n      transition: box-shadow 0.3s ease;\n    }\n\n    .optiz-accordion:hover {\n      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);\n    }\n\n    .optiz-accordion-trigger {\n      width: 100%;\n      padding: 20px 24px;\n      background: transparent;\n      border: none;\n      text-align: left;\n      cursor: pointer;\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      font-size: 16px;\n      font-weight: 500;\n      color: #1a1a1a;\n      transition: background-color 0.2s ease;\n      font-family: inherit;\n    }\n\n    .optiz-accordion-trigger:hover {\n      background-color: #f0f0f0;\n    }\n\n    .optiz-accordion-trigger:focus {\n      outline: 2px solid #1a1a1a;\n      outline-offset: -2px;\n    }\n\n    .optiz-accordion-trigger:focus:not(:focus-visible) {\n      outline: none;\n    }\n\n    .optiz-accordion-chevron {\n      width: 20px;\n      height: 20px;\n      flex-shrink: 0;\n      margin-left: 16px;\n      transition: transform 0.3s ease;\n      stroke: #1a1a1a;\n      stroke-width: 2;\n      fill: none;\n    }\n\n    .optiz-accordion-trigger[aria-expanded=\"true\"] .optiz-accordion-chevron {\n      transform: rotate(180deg);\n    }\n\n    .optiz-accordion-panel {\n      max-height: 0;\n      opacity: 0;\n      overflow: hidden;\n      transition: max-height 0.3s ease, opacity 0.3s ease, padding 0.3s ease;\n      padding: 0 24px;\n    }\n\n    .optiz-accordion-panel[aria-hidden=\"false\"] {\n      max-height: 500px;\n      opacity: 1;\n      padding: 0 24px 24px 24px;\n    }\n\n    .optiz-accordion-content {\n      padding-top: 16px;\n    }\n\n    .optiz-accordion-inci {\n      font-size: 14px;\n      line-height: 1.8;\n      color: #2d2d2d;\n      white-space: pre-line;\n      margin-bottom: 16px;\n      font-family: 'Courier New', monospace;\n    }\n\n    .optiz-copy-button {\n      padding: 10px 20px;\n      background-color: #ffffff;\n      border: 1px solid #e5e5e5;\n      border-radius: 8px;\n      font-size: 14px;\n      font-weight: 500;\n      color: #1a1a1a;\n      cursor: pointer;\n      transition: all 0.2s ease;\n      font-family: inherit;\n      display: inline-flex;\n      align-items: center;\n      gap: 8px;\n    }\n\n    .optiz-copy-button:hover {\n      background-color: #f8f8f8;\n      border-color: #d0d0d0;\n    }\n\n    .optiz-copy-button:active {\n      transform: scale(0.98);\n    }\n\n    .optiz-copy-button:focus {\n      outline: 2px solid #1a1a1a;\n      outline-offset: 2px;\n    }\n\n    .optiz-copy-button:focus:not(:focus-visible) {\n      outline: none;\n    }\n\n    .optiz-copy-button.copied {\n      background-color: #1a1a1a;\n      color: #ffffff;\n      border-color: #1a1a1a;\n    }\n\n    \/* Badges *\/\n    .optiz-badges-container {\n      display: grid;\n      grid-template-columns: 1fr;\n      gap: 16px;\n    }\n\n    @media (min-width: 768px) {\n      .optiz-badges-container {\n        grid-template-columns: repeat(2, 1fr);\n      }\n    }\n\n    .optiz-badge {\n      background-color: #f8f8f8;\n      border: 1px solid #e5e5e5;\n      border-radius: 14px;\n      padding: 24px;\n      text-align: center;\n      transition: all 0.3s ease;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      gap: 12px;\n    }\n\n    .optiz-badge:hover {\n      background-color: #f0f0f0;\n      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);\n      transform: translateY(-2px);\n    }\n\n    .optiz-badge-icon {\n      width: 32px;\n      height: 32px;\n      flex-shrink: 0;\n    }\n\n    .optiz-badge-icon svg {\n      width: 100%;\n      height: 100%;\n      stroke: #1a1a1a;\n      stroke-width: 1.5;\n      fill: none;\n    }\n\n    .optiz-badge-text {\n      font-size: 16px;\n      font-weight: 500;\n      color: #1a1a1a;\n      line-height: 1.4;\n    }\n\n    .optiz-badge-subtext {\n      font-size: 13px;\n      color: #666666;\n      font-weight: 400;\n      margin-top: 4px;\n    }\n  <\/style>\n<\/head>\n<body>\n  <section class=\"optiz-ingredients-section\">\n    <!-- Accordéon Liste INCI -->\n    <div class=\"optiz-accordion\">\n      <button \n        class=\"optiz-accordion-trigger\" \n        aria-expanded=\"false\" \n        aria-controls=\"optiz-accordion-panel\"\n        id=\"optiz-accordion-trigger\"\n      >\n        <span>Liste INCI<\/span>\n        <svg class=\"optiz-accordion-chevron\" viewBox=\"0 0 24 24\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\">\n          <path d=\"M6 9l6 6 6-6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"\/>\n        <\/svg>\n      <\/button>\n      <div \n        class=\"optiz-accordion-panel\" \n        id=\"optiz-accordion-panel\"\n        role=\"region\" \n        aria-labelledby=\"optiz-accordion-trigger\"\n        aria-hidden=\"true\"\n      >\n        <div class=\"optiz-accordion-content\">\n          <div class=\"optiz-accordion-inci\" id=\"optiz-inci-text\">Sodium Olivate, Sodium Cocoate,\nCitrus Limon Peel Water, Sodium Sweet\nAlmondate, Sodium Safflowerate, Sodium Cocoa\nButterate<\/div>\n          <button class=\"optiz-copy-button\" id=\"optiz-copy-button\" aria-label=\"Copier la liste INCI\">\n            <span class=\"optiz-copy-button-text\">Copier<\/span>\n          <\/button>\n        <\/div>\n      <\/div>\n    <\/div>\n\n    <!-- Badges -->\n    <div class=\"optiz-badges-container\">\n      <div class=\"optiz-badge\">\n        <div class=\"optiz-badge-icon\">\n          <svg viewBox=\"0 0 24 24\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\">\n            <path d=\"M12 2v4M12 18v4M2 12h4M18 12h4\" stroke-linecap=\"round\"\/>\n            <path d=\"M6.34 6.34l2.83 2.83M14.83 14.83l2.83 2.83M6.34 17.66l2.83-2.83M14.83 9.17l2.83-2.83\" stroke-linecap=\"round\"\/>\n            <circle cx=\"12\" cy=\"12\" r=\"3\"\/>\n          <\/svg>\n        <\/div>\n        <div>\n          <div class=\"optiz-badge-text\">Saponifié à froid<\/div>\n        <\/div>\n      <\/div>\n      <div class=\"optiz-badge\">\n        <div class=\"optiz-badge-icon\">\n          <svg viewBox=\"0 0 24 24\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\">\n            <circle cx=\"12\" cy=\"12\" r=\"10\"\/>\n            <text x=\"12\" y=\"16\" text-anchor=\"middle\" font-size=\"8\" font-weight=\"600\" fill=\"currentColor\">6%<\/text>\n          <\/svg>\n        <\/div>\n        <div>\n          <div class=\"optiz-badge-text\">6% de surgras<\/div>\n          <div class=\"optiz-badge-subtext\">Au beurre de karité<\/div>\n        <\/div>\n      <\/div>\n    <\/div>\n  <\/section>\n\n  <script>\n    \/\/ Accordéon\n    const accordionTrigger = document.getElementById('optiz-accordion-trigger');\n    const accordionPanel = document.getElementById('optiz-accordion-panel');\n\n    accordionTrigger.addEventListener('click', function() {\n      const isExpanded = this.getAttribute('aria-expanded') === 'true';\n      this.setAttribute('aria-expanded', !isExpanded);\n      accordionPanel.setAttribute('aria-hidden', isExpanded);\n    });\n\n    \/\/ Bouton Copier\n    const copyButton = document.getElementById('optiz-copy-button');\n    const copyButtonText = copyButton.querySelector('.optiz-copy-button-text');\n    const inciText = document.getElementById('optiz-inci-text').textContent;\n\n    copyButton.addEventListener('click', async function() {\n      try {\n        await navigator.clipboard.writeText(inciText);\n        copyButtonText.textContent = 'Copié ✓';\n        copyButton.classList.add('copied');\n        \n        setTimeout(() => {\n          copyButtonText.textContent = 'Copier';\n          copyButton.classList.remove('copied');\n        }, 2000);\n      } catch (err) {\n        \/\/ Fallback pour navigateurs sans clipboard API\n        const textArea = document.createElement('textarea');\n        textArea.value = inciText;\n        textArea.style.position = 'fixed';\n        textArea.style.opacity = '0';\n        document.body.appendChild(textArea);\n        textArea.select();\n        try {\n          document.execCommand('copy');\n          copyButtonText.textContent = 'Copié ✓';\n          copyButton.classList.add('copied');\n          setTimeout(() => {\n            copyButtonText.textContent = 'Copier';\n            copyButton.classList.remove('copied');\n          }, 2000);\n        } catch (err) {\n          console.error('Erreur lors de la copie:', err);\n        }\n        document.body.removeChild(textArea);\n      }\n    });\n  <\/script>\n<\/body>\n<\/html>","color_scheme":"","section_width":"page-width","padding-block-start":0,"padding-block-end":0}},"custom_liquid_TrEHJq":{"type":"custom-liquid","custom_css":["{margin-top: 0px;}"],"name":"CTA","settings":{"custom_liquid":"<div id=\"savon-optiz-desc\" class=\"sd\">\n  <style>\n    .sd { --red:#FF0000; --blk:#212121; --mut:#6f6f6f; --bg:#ffffff; --card:#f7f7f7;\n      font-family:system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial; color:var(--blk);}\n    .sd *{box-sizing:border-box}\n    .sd .wrap{max-width:1080px;margin:auto;padding:clamp(18px,3.5vw,36px)}\n    .sd .grid{display:grid;gap:clamp(16px,2vw,24px)}\n    .sd .hero{position:relative;overflow:hidden;border-radius:18px;background:linear-gradient(135deg,var(--blk),#5c5c5c)}\n    .sd .hero::after{content:\"\";position:absolute;inset:-40% -20% auto -20%;height:120%;background:\n      radial-gradient(1200px 400px at 20% 10%, rgba(255,0,0,.25), transparent 60%),\n      radial-gradient(900px 300px at 90% 0%, rgba(255,0,0,.18), transparent 60%);\n      filter:blur(2px);pointer-events:none;}\n    .sd .hero-inner{display:grid;grid-template-columns:1.1fr .9fr;gap:28px;padding:36px;align-items:center}\n    @media (max-width:900px){ .sd .hero-inner{grid-template-columns:1fr;padding:24px}}\n    .sd h1{margin:0;font-size:clamp(28px,5vw,48px);line-height:1.05;letter-spacing:-.02em;color:#fff}\n    .sd .sub{color:#f0f0f0;font-size:clamp(14px,1.6vw,18px);opacity:.9;margin-top:8px}\n    .sd .badge{display:inline-flex;align-items:center;gap:8px;background:#ffffff10;border:1px solid #ffffff30;color:#fff;padding:8px 12px;border-radius:999px;font-weight:600}\n    .sd .badge svg{width:16px;height:16px}\n    .sd .hero-card{background:#fff;border-radius:16px;padding:18px;border:1px solid #eaeaea;box-shadow:0 10px 30px rgba(0,0,0,.08)}\n    .sd .price{display:flex;align-items:baseline;gap:10px}\n    .sd .price .num{font-size:34px;font-weight:800;color:var(--blk)}\n    .sd .cta{margin-top:10px;display:flex;gap:10px;flex-wrap:wrap}\n    .sd .btn{appearance:none;border:none;background:var(--red);color:#fff;padding:14px 18px;border-radius:12px;font-weight:800;letter-spacing:.2px;cursor:pointer;transition:transform .2s ease, box-shadow .2s ease}\n    .sd .btn:hover{transform:translateY(-2px);box-shadow:0 8px 20px rgba(255,0,0,.25)}\n    .sd .btn.sec{background:#fff;color:var(--blk);border:1px solid #dcdcdc}\n    .sd h2{font-size:clamp(22px,3.6vw,32px);letter-spacing:-.01em;margin:0 0 10px}\n    .sd p{margin:6px 0 0;color:var(--blk)}\n    .sd .mut{color:var(--mut)}\n    .sd .hr{height:1px;background:linear-gradient(90deg,transparent,#e8e8e8,transparent);margin:28px 0}\n    .sd .cards{grid-template-columns:repeat(3,1fr)}\n    @media (max-width:960px){.sd .cards{grid-template-columns:1fr}}\n    .sd .card{background:#fff;border:1px solid #ececec;border-radius:16px;padding:18px;box-shadow:0 8px 22px rgba(0,0,0,.05)}\n    .sd .list{display:grid;gap:10px;margin-top:10px}\n    .sd .li{display:flex;gap:12px}\n    .sd .li svg{width:18px;height:18px;margin-top:2px;color:var(--red)}\n    .sd .reveal{opacity:0;transform:translateY(16px);transition:opacity .7s ease,transform .7s cubic-bezier(.2,.7,.2,1)}\n    .sd .reveal.show{opacity:1;transform:none}\n    .sd .u{position:relative;display:inline-block}\n    .sd .u::after{content:\"\";position:absolute;left:0;right:0;bottom:-6px;height:3px;background:linear-gradient(90deg,var(--red),transparent)}\n    .highlight-cart{box-shadow:0 0 20px 5px rgba(255,0,0,.6)!important;transform:scale(1.05);transition:all .4s ease}\n\n    \/* 🔥 MODIFS DESKTOP UNIQUEMENT POUR AGRANDIR LES 3 CARTES *\/\n    @media (min-width: 961px){\n      .sd .wrap{\n        max-width:100%;\n        width:100%;\n        padding-left:1vw;\n        padding-right:1vw;\n      }\n      .sd .cards{\n        grid-template-columns:repeat(3, minmax(0,1fr));\n        gap:8px;\n      }\n      .sd .card{\n        padding:26px;\n      }\n    }\n  <\/style>\n\n  <div class=\"wrap\">\n    <!-- ✅ FIN UNIQUEMENT (comme demandé) -->\n    <section class=\"reveal\" style=\"text-align:center\">\n      <h2 class=\"u\">Juste un savon TOP 1%<\/h2>\n      <p style=\"margin-bottom:16px\">\n        Convient parfaitement aux peaux sensibles. Tout le monde peut l’utiliser sur le visage et le corps.\n      <\/p>\n      <button class=\"btn scroll-to-top\">Ajouter au panier<\/button>\n    <\/section>\n  <\/div>\n\n  <script>\n    \/\/ Animation au scroll\n    (function(){\n      const els=document.querySelectorAll('#savon-optiz-desc .reveal');\n      const io=new IntersectionObserver((entries)=>{\n        entries.forEach(e=>{\n          if(e.isIntersecting){e.target.classList.add('show');io.unobserve(e.target);}\n        });\n      },{threshold:.12});\n      els.forEach(el=>io.observe(el));\n    })();\n\n    \/\/ Remonte vers le vrai bouton \"Ajouter au panier\"\n    document.querySelectorAll('#savon-optiz-desc .scroll-to-top').forEach(btn=>{\n      btn.addEventListener('click',()=>{\n        const target=document.querySelector('form[action*=\"\/cart\"] button[name=\"add\"], button[name=\"add\"]');\n        if(target){\n          target.scrollIntoView({behavior:'smooth',block:'center'});\n          target.classList.add('highlight-cart');\n          setTimeout(()=>target.classList.remove('highlight-cart'),2000);\n        }else{\n          window.scrollTo({top:0,behavior:'smooth'});\n        }\n      });\n    });\n  <\/script>\n<\/div>","color_scheme":"","section_width":"full-width","padding-block-start":0,"padding-block-end":0}},"image_defile_gkW6Bw":{"type":"image_defile","blocks":{"image_Vp6t33":{"type":"image","settings":{"img":"shopify:\/\/shop_images\/hakim_pose.jpg"}},"image_DA3yUV":{"type":"image","settings":{"img":"shopify:\/\/shop_images\/hakim_pose_2.jpg"}},"image_z4Vihd":{"type":"image","settings":{"img":"shopify:\/\/shop_images\/hakim_pose.jpg"}},"image_TdEKQc":{"type":"image","settings":{"img":"shopify:\/\/shop_images\/hakim_pose_2.jpg"}},"image_RMVVxX":{"type":"image","settings":{"img":"shopify:\/\/shop_images\/hakim_pose.jpg"}},"image_PBMnLD":{"type":"image","settings":{"img":"shopify:\/\/shop_images\/hakim_pose_2.jpg"}}},"block_order":["image_Vp6t33","image_DA3yUV","image_z4Vihd","image_TdEKQc","image_RMVVxX","image_PBMnLD"],"custom_css":[],"name":"Barre d'images","settings":{"image_height":260,"speed":52,"background_color":"#ffffff"}},"17621635801e638a63":{"type":"_blocks","blocks":{"klaviyo_reviews_product_reviews_gfdb8E":{"type":"shopify:\/\/apps\/klaviyo-reviews\/blocks\/product-reviews\/db20e365-d984-4ac4-9655-e1588d951ca9","settings":{}}},"block_order":["klaviyo_reviews_product_reviews_gfdb8E"],"settings":{"content_direction":"column","vertical_on_mobile":true,"horizontal_alignment":"flex-start","vertical_alignment":"center","align_baseline":false,"horizontal_alignment_flex_direction_colu