ong>.<\/p>\n    <div class=\"sparkle\"><\/div>\n  <\/div>\n<\/section>\n\n<style>\n.savings-section{\n  display:flex;justify-content:center;align-items:center;\n  background:#fff;padding:20px;text-align:center;\n  font-family:'Poppins',sans-serif;\n}\n.savings-container{\n  position:relative;\n  background:#009c3d;\n  color:#fff;\n  padding:15px 25px;\n  border-radius:10px;\n  box-shadow:0 0 10px rgba(0,156,61,0.4);\n  animation:popIn .8s ease;\n}\n.savings-container h2{\n  font-size:1.4em;margin:0 0 5px;\n  text-shadow:0 0 6px rgba(0,0,0,0.2);\n}\n.savings-container p{\n  font-size:0.95em;margin:0;\n}\n@keyframes popIn{\n  0%{transform:scale(.5);opacity:0;}\n  100%{transform:scale(1);opacity:1;}\n}\n@keyframes sparkle{\n  0%{transform:rotate(0deg);}\n  100%{transform:rotate(360deg);}\n}\n.sparkle{\n  position:absolute;top:-10px;right:-10px;width:25px;height:25px;\n  border:3px solid #fff;border-radius:50%;\n  box-shadow:0 0 10px rgba(255,255,255,0.8);\n  animation:sparkle 4s linear infinite;\n  opacity:0.9;\n}\n#savings-amount{\n  font-weight:700;\n  font-size:1.5em;\n  color:#fff;\n  text-shadow:0 0 8px rgba(0,0,0,0.3);\n}\n<\/style>\n\n<script>\ndocument.addEventListener(\"DOMContentLoaded\",()=>{\n  const el = document.getElementById(\"savings-amount\");\n  let val = 0;\n  const target = 56;       \/\/ économie correcte\n  const duration = 1200;\n  const step = target \/ (duration \/ 20);\n\n  const count = setInterval(()=>{\n    val += step;\n    if(val >= target){\n      val = target;\n      clearInterval(count);\n    }\n    el.textContent = Math.round(val);\n  },20);\n});\n<\/script>"},"blocks":{}},"variant_picker_R3rGDr":{"type":"variant-picker","settings":{"variant_style":"buttons","show_swatches":true,"alignment":"left","padding-block-start":12,"padding-block-end":24,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"product_inventory_ibhciA":{"type":"product-inventory","name":"t:names.product_inventory","settings":{"inventory_threshold":10,"sh