<section class="siwak-mechanism" aria-labelledby="SiwakMechanismTitle-{{ section.id }}">
  <div class="siwak-mechanism__media">
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 2000 | image_tag: widths: '640, 960, 1280, 1600, 2000', sizes: '(min-width: 900px) 58vw, 100vw', loading: 'lazy', alt: section.settings.image.alt | default: section.settings.image_alt }}
    {% else %}
      {{ 'product-1' | placeholder_svg_tag: 'siwak-mechanism__placeholder' }}
    {% endif %}
    <p>{{ section.settings.caption | escape }}</p>
  </div>
  <div class="siwak-mechanism__copy">
    <p class="siwak-mechanism__index">02 / LE GESTE</p>
    <h2 id="SiwakMechanismTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
    <div class="siwak-mechanism__text rte">{{ section.settings.text }}</div>
    {% if section.settings.proof_note != blank %}
      <div class="siwak-mechanism__proof">
        <strong>PREUVE À AJOUTER</strong>
        <span>{{ section.settings.proof_note | escape }}</span>
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .siwak-mechanism { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(320px, 0.75fr); background: #171717; color: #fff; }
  .siwak-mechanism__media { position: relative; min-height: 620px; border-right: 1px solid rgb(255 255 255 / 0.28); overflow: hidden; }
  .siwak-mechanism__media img, .siwak-mechanism__placeholder { width: 100%; height: 100%; display: block; object-fit: cover; background: #302f2d; }
  .siwak-mechanism__media p { position: absolute; left: 22px; bottom: 18px; margin: 0; padding: 8px 11px; background: #f5f1e9; color: #171717; font-size: 0.73rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; }
  .siwak-mechanism__copy { display: flex; flex-direction: column; justify-content: center; padding: clamp(40px, 7vw, 104px); }
  .siwak-mechanism__index { margin: 0 0 34px; color: #ff3b30; font-size: 0.75rem; font-weight: 800; letter-spacing: 0.12em; }
  .siwak-mechanism h2 { margin: 0 0 28px; max-width: 570px; font-size: clamp(2.4rem, 4.8vw, 5.6rem); line-height: 0.93; letter-spacing: -0.045em; }
  .siwak-mechanism__text { max-width: 540px; font-size: clamp(1rem, 1.35vw, 1.18rem); line-height: 1.55; }
  .siwak-mechanism__proof { display: grid; gap: 8px; margin-top: 34px; padding-top: 18px; border-top: 4px solid #e10600; }
  .siwak-mechanism__proof strong { color: #ff3b30; font-size: 0.72rem; letter-spacing: 0.13em; }
  .siwak-mechanism__proof span { font-size: 0.9rem; line-height: 1.45; }
  @media (max-width: 899px) {
    .siwak-mechanism { grid-template-columns: 1fr; }
    .siwak-mechanism__media { min-height: auto; aspect-ratio: 3 / 2; border-right: 0; border-bottom: 1px solid rgb(255 255 255 / 0.28); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Siwak — geste et fibres",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Macro des fibres" },
    { "type": "text", "id": "image_alt", "label": "Texte alternatif", "default": "Fibres formées à l’extrémité d’un siwak" },
    { "type": "text", "id": "caption", "label": "Légende image", "default": "La pointe du siwak, vue de près" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Regarde le geste de près." },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>La pointe s’assouplit et se sépare en fibres. Tu ajustes ensuite la pression et le passage, dent par dent.</p>" },
    { "type": "textarea", "id": "proof_note", "label": "Note de preuve provisoire", "default": "Ajouter ici la formulation validée relative à l’émail et à la sensibilité, accompagnée de sa source." }
  ],
  "presets": [{ "name": "Siwak — geste et fibres" }]
}
{% endschema %}
