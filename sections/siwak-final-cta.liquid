{% liquid
  assign hero_alt = section.settings.image.alt | default: section.settings.image_alt
  assign background_count = 0
  for block in section.blocks
    if block.settings.image != blank
      assign background_count = background_count | plus: 1
    endif
  endfor
%}
<section class="siwak-final-cta" aria-labelledby="SiwakFinalTitle-{{ section.id }}" style="--siwak-final-background-opacity: {{ section.settings.background_opacity | divided_by: 100.0 }};">
  {% if background_count > 0 %}
    <div class="siwak-final-cta__mosaic siwak-final-cta__mosaic--{{ background_count }}{% if background_count > 8 %} siwak-final-cta__mosaic--dense{% endif %}" aria-hidden="true">
      {% for block in section.blocks %}
        {% if block.settings.image != blank %}
          <div class="siwak-final-cta__tile" {{ block.shopify_attributes }}>
            {{ block.settings.image | image_url: width: 1200 | image_tag: widths: '300, 500, 800, 1200', sizes: '(min-width: 750px) 50vw, 100vw', loading: 'lazy', alt: '' }}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}
  <div class="siwak-final-cta__inner">
    <div class="siwak-final-cta__content">
      {% if section.settings.eyebrow != blank %}<p class="siwak-final-cta__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      <h2 id="SiwakFinalTitle-{{ section.id }}" class="siwak-final-cta__heading">
        {{ section.settings.heading | escape }}
        {% if section.settings.heading_accent != blank %}<span>{{ section.settings.heading_accent | escape }}</span>{% endif %}
      </h2>
      {% if section.settings.text != blank %}<div class="siwak-final-cta__text rte">{{ section.settings.text }}</div>{% endif %}
      {% if section.settings.button_label != blank %}
        <a class="siwak-final-cta__button" href="#siwak-buy"><span>{{ section.settings.button_label | escape }}</span><svg viewBox="0 0 24 24" aria-hidden="true" fill="none"><path d="M4 12h15m-6-6 6 6-6 6" stroke="currentColor" stroke-width="2"/></svg></a>
      {% endif %}
    </div>
    <figure class="siwak-final-cta__visual">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 1400 | image_tag: class: 'siwak-final-cta__image', widths: '360, 540, 750, 1000, 1400', sizes: '(min-width: 750px) 400px, 320px', loading: 'lazy', alt: hero_alt }}
      {% else %}
        <img class="siwak-final-cta__image" src="{{ 'optiz-siwak-box-stone-cutout-v2.png' | file_url }}" width="1122" height="1402" loading="lazy" alt="{{ hero_alt | escape }}">
      {% endif %}
      {% if section.settings.show_caption and section.settings.caption != blank %}<figcaption class="siwak-final-cta__caption">{{ section.settings.caption | escape }}</figcaption>{% endif %}
    </figure>
  </div>
</section>
{% stylesheet %}
  .siwak-final-cta {
    --siwak-final-red: #e52219;
    --siwak-final-ink: #171717;
    --siwak-final-paper: #f5f1e9;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--siwak-final-ink);
    color: var(--siwak-final-paper);
    border-block: 4px solid var(--siwak-final-red);
  }
  .siwak-final-cta *, .siwak-final-cta *::before, .siwak-final-cta *::after { box-sizing: border-box; }
  .siwak-final-cta__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr);
    align-items: center;
    gap: clamp(20px, 3vw, 44px);
    width: 100%;
    max-width: 1400px;
    margin-inline: auto;
    padding: 12px clamp(24px, 5vw, 72px) 0;
  }
  .siwak-final-cta__content { min-width: 0; padding-bottom: 0; }
  .siwak-final-cta__eyebrow { display: inline-block; max-width: 100%; margin: 0 0 14px; border-bottom: 2px solid var(--siwak-final-red); padding-bottom: 6px; color: var(--siwak-final-paper); font: 700 13px/1.5 "Courier New", monospace; letter-spacing: .12em; text-transform: uppercase; }
  .siwak-final-cta .siwak-final-cta__heading { position: relative; margin: 0; color: inherit; font-family: "Barlow Condensed", var(--font-heading--family), sans-serif; font-size: clamp(47px, 5.8vw, 76px); font-weight: 800; line-height: .93; letter-spacing: -.025em; text-transform: uppercase; text-wrap: balance; overflow-wrap: anywhere; }
  .siwak-final-cta__heading span { display: block; margin-top: 5px; color: var(--siwak-final-red); }
  .siwak-final-cta__text { max-width: 470px; margin: 16px 0 20px; color: var(--siwak-final-paper); font-size: clamp(16px, 1.4vw, 19px); line-height: 1.5; }
  .siwak-final-cta__text p { margin: 0 0 12px; }
  .siwak-final-cta__text p:last-child { margin-bottom: 0; }
  .siwak-final-cta__button { display: inline-flex; align-items: center; justify-content: space-between; gap: 30px; min-height: 56px; max-width: 100%; padding: 12px 20px; border: 2px solid var(--siwak-final-paper); background: var(--siwak-final-paper); color: var(--siwak-final-ink); box-shadow: 6px 6px 0 var(--siwak-final-red); text-decoration: none; font-family: "Barlow Condensed", var(--font-heading--family), sans-serif; font-size: 24px; font-weight: 800; line-height: 1.15; letter-spacing: .02em; text-transform: uppercase; transition: background-color 160ms ease, color 160ms ease; }
  .siwak-final-cta__button span { overflow-wrap: anywhere; }
  .siwak-final-cta__button svg { flex: 0 0 26px; width: 26px; height: 26px; }
  .siwak-final-cta__button:hover { border-color: var(--siwak-final-red); background: var(--siwak-final-red); color: #fff; box-shadow: 6px 6px 0 var(--siwak-final-paper); }
  .siwak-final-cta__button:focus-visible { outline: 3px solid var(--siwak-final-paper); outline-offset: 10px; }
  .siwak-final-cta__visual { position: relative; display: flex; flex-direction: column; align-items: center; align-self: end; justify-self: center; width: 100%; max-width: 400px; min-width: 0; margin: 0 0 -16px; }
  .siwak-final-cta__image { display: block; width: 100%; height: min(470px, 68vh); height: min(470px, 68svh); object-fit: contain; object-position: center bottom; }
  .siwak-final-cta__visual:has(.siwak-final-cta__caption) { margin-bottom: 0; }
  .siwak-final-cta__caption { max-width: 100%; margin: 14px 0 0; padding: 0; color: var(--siwak-final-paper); font: 700 11px/1.6 "Courier New", monospace; text-align: center; text-transform: uppercase; letter-spacing: .06em; overflow-wrap: anywhere; }
  .siwak-final-cta__mosaic { position: absolute; z-index: 0; inset: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-auto-rows: minmax(0, 1fr); gap: 3px; opacity: var(--siwak-final-background-opacity, .3); pointer-events: none; }
  .siwak-final-cta__tile { min-width: 0; min-height: 0; overflow: hidden; }
  .siwak-final-cta__tile img { display: block; width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) brightness(.7); }
  /* Fill the last mosaic row for any count up to sixteen. */
  .siwak-final-cta__mosaic > .siwak-final-cta__tile:where(:last-child:nth-child(4n + 1)) { grid-column: 1 / -1; }
  .siwak-final-cta__mosaic > .siwak-final-cta__tile:where(:last-child:nth-child(4n + 3)) { grid-column: span 2; }
  .siwak-final-cta__mosaic:where(:has(> .siwak-final-cta__tile:last-child:nth-child(4n + 2))) > .siwak-final-cta__tile:where(:nth-last-child(-n + 2)) { grid-column: span 2; }
  @media (min-width: 750px) and (max-width: 1099px) {
    .siwak-final-cta__inner { gap: 20px; padding: 12px 28px 0; }
    .siwak-final-cta .siwak-final-cta__heading { font-size: clamp(45px, 5.8vw, 64px); }
    .siwak-final-cta__eyebrow { font-size: 11px; letter-spacing: .07em; }
  }
  @media (max-width: 749px) {
    .siwak-final-cta__inner { grid-template-columns: minmax(0, 1fr); min-height: 0; align-content: start; gap: 10px; padding: 8px 22px 0; }
    .siwak-final-cta__content { padding: 0; text-align: center; }
    .siwak-final-cta__eyebrow { margin-bottom: 10px; padding-bottom: 5px; font-size: 10px; line-height: 1.3; letter-spacing: .08em; }
    .siwak-final-cta .siwak-final-cta__heading { max-width: 440px; margin-inline: auto; font-size: clamp(34px, 9.8vw, 44px); line-height: .95; }
    .siwak-final-cta__text { max-width: 380px; margin: 12px auto 14px; font-size: 15px; line-height: 1.4; }
    .siwak-final-cta__text p { margin-bottom: 8px; }
    .siwak-final-cta__button { min-height: 43px; font-size: 20px; padding: 8px 14px; gap: 18px; box-shadow: 4px 4px 0 var(--siwak-final-red); }
    .siwak-final-cta__visual { max-width: 340px; }
    /* Enlarge the product into the former bottom whitespace. The figure
       extends below the section so only the lower edge of the stone is cropped. */
    .siwak-final-cta__image { width: 100%; height: clamp(180px, calc(100vh - 330px), 380px); height: clamp(180px, calc(100svh - 330px), 380px); height: clamp(180px, calc(100dvh - 330px), 380px); max-height: none; }
    .siwak-final-cta__caption { margin-top: 6px; font-size: 10px; }
    .siwak-final-cta__mosaic:not(.siwak-final-cta__mosaic--dense) { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .siwak-final-cta__mosaic:not(.siwak-final-cta__mosaic--dense) > .siwak-final-cta__tile { grid-column: auto; }
    .siwak-final-cta__mosaic:not(.siwak-final-cta__mosaic--dense) > .siwak-final-cta__tile:last-child:nth-child(odd) { grid-column: 1 / -1; }
  }
  @media (max-width: 359px) {
    .siwak-final-cta__inner { padding: 6px 16px 0; gap: 8px; }
    .siwak-final-cta .siwak-final-cta__heading { font-size: 32px; }
    .siwak-final-cta__text { font-size: 14px; }
    .siwak-final-cta__button { gap: 14px; font-size: 19px; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .siwak-final-cta__tile img {
      animation: siwak-mosaic-drift 22s ease-in-out infinite alternate;
    }
    .siwak-final-cta__tile:nth-child(4n + 1) img { animation-delay: -6s; }
    .siwak-final-cta__tile:nth-child(4n + 2) img { animation-delay: -14s; animation-direction: alternate-reverse; }
    .siwak-final-cta__tile:nth-child(4n + 3) img { animation-duration: 26s; animation-delay: -20s; }
    .siwak-final-cta__tile:nth-child(4n) img { animation-duration: 24s; animation-delay: -10s; animation-direction: alternate-reverse; }
  }
  @keyframes siwak-mosaic-drift {
    from { transform: scale(1.06) translate3d(-2px, -3px, 0); }
    to { transform: scale(1.06) translate3d(2px, 3px, 0); }
  }
  @media (prefers-reduced-motion: reduce) { .siwak-final-cta__button { transition: none; } }
{% endstylesheet %}
{% schema %}
{
  "name": "Siwak — appel final",
  "max_blocks": 16,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "LE PROCHAIN GESTE EST À TOI" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "TON GLOW-UP" },
    { "type": "text", "id": "heading_accent", "label": "Suite du titre en rouge", "default": "VA JUSQU’AU SOURIRE." },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Tu prends déjà soin de toi. Fais aussi une place à ton sourire. Un bâtonnet, des fibres à préparer, cinq minutes dans ta routine : voilà le geste Siwak Optiz.</p>" },
    { "type": "text", "id": "button_label", "label": "Bouton", "default": "CHOISIR MON SIWAK" },
    { "type": "image_picker", "id": "image", "label": "Produit au premier plan", "info": "Choisir une image PNG détourée. Sans image sélectionnée, la boîte sur son socle enregistrée dans les fichiers de la boutique est utilisée." },
    { "type": "text", "id": "image_alt", "label": "Description du produit", "default": "Boîte de siwaks Optiz posée sur un socle en pierre" },
    { "type": "checkbox", "id": "show_caption", "label": "Afficher la légende sous le produit", "default": false },
    { "type": "text", "id": "caption", "label": "Légende du produit", "default": "LE SIWAK OPTIZ, TOUT SIMPLEMENT." },
    { "type": "range", "id": "background_opacity", "label": "Visibilité des photos de fond", "min": 0, "max": 40, "step": 5, "unit": "%", "default": 30, "info": "Ajouter les photos avec les blocs Photo de fond. Le voile sombre préserve la lisibilité du texte." }
  ],
  "blocks": [
    { "type": "photo", "name": "Photo de fond facultative", "settings": [
      { "type": "image_picker", "id": "image", "label": "Photo", "info": "Ajouter vos propres photos ou captures d’avis autorisées. Les blocs sans image ne sont pas affichés." }
    ] }
  ],
  "presets": [{ "name": "Siwak — appel final" }]
}
{% endschema %}



