{% liquid
  assign promise_heading = section.settings.heading | escape
  assign promise_accent = section.settings.accent | escape
%}
{% if promise_accent != blank and promise_heading contains promise_accent %}
  {% assign promise_parts = promise_heading | split: promise_accent %}
  {% capture promise_heading %}<span class="siwak-promise__lead">{{ promise_parts | first }}</span><span class="siwak-promise__accent">{{ promise_accent }}</span><span class="siwak-promise__tail">{{ promise_parts | last }}</span>{% endcapture %}
{% endif %}

<section class="siwak-promise" aria-labelledby="SiwakPromiseTitle-{{ section.id }}">
  <div class="siwak-promise__inner">
    {% if section.settings.eyebrow != blank %}
    <div class="siwak-promise__label">
      {% if section.settings.eyebrow != blank %}<p>{{ section.settings.eyebrow | escape }}</p>{% endif %}
      <svg class="siwak-promise__mark" viewBox="0 0 32 32" fill="none" aria-hidden="true"><path d="M16 2v28M4 9l24 14M4 23 28 9" stroke="currentColor" stroke-width="5"/></svg>
    </div>
    {% endif %}
    <h2 id="SiwakPromiseTitle-{{ section.id }}">{{ promise_heading }}</h2>
    {% if section.settings.note != blank %}<p class="siwak-promise__note">{{ section.settings.note | escape }}</p>{% endif %}
  </div>
</section>

{% stylesheet %}
  .siwak-promise {
    padding: 24px max(20px, calc((100vw - 1400px) / 2));
    background: #f7f7f6;
    color: #f5f1e9;
  }
  .siwak-promise__inner {
    position: relative;
    isolation: isolate;
    max-width: 1100px;
    margin: 0 auto;
    padding: 24px 38px 28px;
    border: 2px solid #171717;
    background: #171717;
    box-shadow: 6px 6px 0 #e52219;
    text-align: center;
  }
  .siwak-promise__label {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
  }
  .siwak-promise__label p {
    margin: 0;
    color: #f5f1e9;
    font-family: "Courier New", Courier, monospace;
    font-size: 11px;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: .15em;
    text-transform: uppercase;
  }
  .siwak-promise__mark { width: 17px; height: 17px; flex-shrink: 0; color: #e52219; }
  .siwak-promise h2 {
    max-width: 880px;
    margin: 0 auto;
    color: #f5f1e9;
    font-family: var(--font-heading--family);
    font-weight: 700;
    font-size: clamp(34px, 4.4vw, 54px);
    line-height: .98;
    letter-spacing: -.02em;
    text-transform: uppercase;
    text-wrap: balance;
  }
  .siwak-promise__lead {
    display: block;
    font-size: .85em;
    line-height: 1;
    letter-spacing: .015em;
  }
  .siwak-promise__accent {
    display: block;
    width: fit-content;
    max-width: 100%;
    margin: 10px auto 16px;
    padding: 7px 18px 10px;
    background: #e52219;
    color: #f5f1e9;
    box-shadow: 3px 3px 0 #f5f1e9;
    transform: rotate(-1.5deg);
    font-size: 1.12em;
    line-height: .94;
  }
  .siwak-promise__tail {
    display: block;
    max-width: 42ch;
    margin: 0 auto;
    font-size: .68em;
    line-height: 1.08;
    letter-spacing: .01em;
  }
  .siwak-promise__note {
    max-width: 640px;
    margin: 16px auto 0;
    padding-top: 12px;
    border-top: 1px solid #f5f1e940;
    color: #f5f1e9;
    font-size: 15px;
    line-height: 1.45;
  }
  @media (max-width: 749px) {
    .siwak-promise { padding: 18px 16px 22px; }
    .siwak-promise__inner { padding: 18px 18px 22px; box-shadow: 4px 4px 0 #e52219; }
    .siwak-promise__label { gap: 8px; margin-bottom: 12px; }
    .siwak-promise__label p { font-size: 10px; letter-spacing: .11em; }
    .siwak-promise h2 { font-size: clamp(34px, 10vw, 44px); }
    .siwak-promise__accent { margin: 10px auto 15px; padding: 7px 10px 9px; font-size: 1em; }
    .siwak-promise__lead { font-size: .82em; }
    .siwak-promise__tail { max-width: 28ch; font-size: .72em; line-height: 1.1; }
    .siwak-promise__note { margin-top: 12px; font-size: 14px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Siwak — promesse",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "LE GESTE SIWAK" },
    { "type": "textarea", "id": "heading", "label": "Promesse", "default": "Retrouve la blancheur de tes dents en 15 jours sans sensibiliser tes gencives." },
    { "type": "text", "id": "accent", "label": "Expression en rouge", "default": "blancheur de tes dents", "info": "Reprend exactement une expression du titre. Laisse vide pour un titre entièrement noir." },
    { "type": "textarea", "id": "note", "label": "Précision visible", "default": "Un geste quotidien de 5 minutes pour entretenir un sourire naturellement plus clair." }
  ],
  "presets": [{ "name": "Siwak — promesse" }]
}
{% endschema %}
