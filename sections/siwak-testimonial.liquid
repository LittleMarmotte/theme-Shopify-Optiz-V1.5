{% liquid
  assign video_blocks = section.blocks | where: 'type', 'testimonial'
  assign review_blocks = section.blocks | where: 'type', 'review'
%}

<siwak-testimonial-carousel class="siwak-testimonials siwak-testimonials--{{ section.id }}">
  <section aria-labelledby="SiwakTestimonialsTitle-{{ section.id }}">
    <header class="siwak-testimonials__header">
      {% if section.settings.eyebrow != blank %}<p class="siwak-testimonials__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      <h2 id="SiwakTestimonialsTitle-{{ section.id }}">{{ section.settings.heading | escape | newline_to_br }}</h2>
      {% if section.settings.text != blank %}<p class="siwak-testimonials__intro">{{ section.settings.text | escape }}</p>{% endif %}
    </header>

    {% if video_blocks.size > 0 %}
      <div class="siwak-testimonials__carousel">
        <button class="siwak-testimonials__arrow siwak-testimonials__arrow--prev" type="button" data-carousel-prev aria-label="Témoignage vidéo précédent" disabled>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 5-7 7 7 7"/></svg>
        </button>

        <div class="siwak-testimonials__track" id="SiwakVideoTrack-{{ section.id }}" data-carousel-track tabindex="0" aria-label="Témoignages vidéo">
          {% for block in video_blocks %}
            {% liquid
              assign external_url = block.settings.external_video_url | strip
              assign embed_url = ''
              assign provider = ''
              assign external_id = ''

              if external_url contains 'youtube.com/shorts/'
                assign provider = 'YouTube'
                assign external_id = external_url | split: 'youtube.com/shorts/' | last | split: '?' | first | split: '&' | first | split: '/' | first
              elsif external_url contains 'youtu.be/'
                assign provider = 'YouTube'
                assign external_id = external_url | split: 'youtu.be/' | last | split: '?' | first | split: '&' | first | split: '/' | first
              elsif external_url contains 'youtube.com/watch' and external_url contains 'v='
                assign provider = 'YouTube'
                assign external_id = external_url | split: 'v=' | last | split: '&' | first | split: '?' | first | split: '/' | first
              elsif external_url contains 'youtube.com/embed/'
                assign provider = 'YouTube'
                assign external_id = external_url | split: 'youtube.com/embed/' | last | split: '?' | first | split: '&' | first | split: '/' | first
              elsif external_url contains 'tiktok.com/' and external_url contains '/video/'
                assign provider = 'TikTok'
                assign external_id = external_url | split: '/video/' | last | split: '?' | first | split: '&' | first | split: '/' | first
              elsif external_url contains 'instagram.com/reel/'
                assign provider = 'Instagram'
                assign external_id = external_url | split: 'instagram.com/reel/' | last | split: '?' | first | split: '&' | first | split: '/' | first
                assign embed_url = 'https://www.instagram.com/reel/' | append: external_id | append: '/embed/'
              elsif external_url contains 'instagram.com/reels/'
                assign provider = 'Instagram'
                assign external_id = external_url | split: 'instagram.com/reels/' | last | split: '?' | first | split: '&' | first | split: '/' | first
                assign embed_url = 'https://www.instagram.com/reel/' | append: external_id | append: '/embed/'
              elsif external_url contains 'instagram.com/p/'
                assign provider = 'Instagram'
                assign external_id = external_url | split: 'instagram.com/p/' | last | split: '?' | first | split: '&' | first | split: '/' | first
                assign embed_url = 'https://www.instagram.com/p/' | append: external_id | append: '/embed/'
              endif

              if provider == 'YouTube' and external_id != blank
                assign embed_url = 'https://www.youtube-nocookie.com/embed/' | append: external_id | append: '?autoplay=0&playsinline=1&rel=0'
              elsif provider == 'TikTok' and external_id != blank
                assign embed_url = 'https://www.tiktok.com/player/v1/' | append: external_id | append: '?autoplay=0&controls=1&progress_bar=1&play_button=1&volume_control=1&fullscreen_button=1'
              endif

              assign video_title = block.settings.title | default: 'Témoignage client'
              assign poster_image = block.settings.poster | default: block.settings.video.preview_image
              assign poster_url = ''
              if poster_image != blank
                assign poster_url = poster_image | image_url: width: 900
              endif
            %}

            <article class="siwak-testimonials__video-card{% if block.settings.video != blank %} has-native-video{% endif %}" {{ block.shopify_attributes }}>
              <div class="siwak-testimonials__media">
                {% if block.settings.video != blank %}
                  {{ block.settings.video
                    | video_tag:
                      autoplay: false,
                      loop: true,
                      controls: false,
                      muted: true,
                      playsinline: true,
                      preload: 'metadata',
                      image_size: '900x',
                      poster: poster_url,
                      class: 'siwak-testimonials__native-video'
                  }}
                  <button class="siwak-testimonials__play-toggle" type="button" data-video-toggle aria-label="Lire {{ video_title | escape }}">
                    <svg class="siwak-testimonials__icon-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4v16l13-8z"/></svg>
                    <svg class="siwak-testimonials__icon-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 4h4v16H6zm8 0h4v16h-4z"/></svg>
                  </button>
                  <button class="siwak-testimonials__sound-toggle" type="button" data-sound-toggle aria-label="Activer le son">
                    <svg class="siwak-testimonials__icon-muted" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9v6h4l5 5V4L8 9zm12.5 1.5 3 3m0-3-3 3"/></svg>
                    <svg class="siwak-testimonials__icon-sound" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9v6h4l5 5V4L8 9zm12-1a5 5 0 0 1 0 8"/></svg>
                  </button>
                {% elsif embed_url != blank %}
                  <iframe
                    src="{{ embed_url | escape }}"
                    title="Témoignage vidéo {{ provider }} — {{ video_title | escape }}"
                    loading="lazy"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    allowfullscreen
                    referrerpolicy="strict-origin-when-cross-origin"
                  ></iframe>
                {% elsif block.settings.poster != blank %}
                  {{ block.settings.poster
                    | image_url: width: 900
                    | image_tag:
                      widths: '400, 600, 900',
                      sizes: '(min-width: 990px) 230px, 74vw',
                      loading: 'lazy',
                      alt: block.settings.poster.alt | default: video_title
                  }}
                {% else %}
                  <div class="siwak-testimonials__placeholder">
                    <span aria-hidden="true">▶</span>
                    <strong>VIDÉO CLIENT</strong>
                    <small>SÉLECTIONNE UNE VIDÉO SHOPIFY</small>
                  </div>
                {% endif %}

                {% if external_url != blank and embed_url == blank and block.settings.video == blank and request.design_mode %}
                  <p class="siwak-testimonials__editor-error">Lien non reconnu. Utilise l’URL complète d’un Reel Instagram, d’une vidéo TikTok ou d’une vidéo YouTube.</p>
                {% endif %}
              </div>

              {% if block.settings.title != blank or block.settings.context != blank %}
                <div class="siwak-testimonials__video-caption">
                  {% if block.settings.title != blank %}<strong>{{ block.settings.title | escape }}</strong>{% endif %}
                  {% if block.settings.context != blank %}<span>{{ block.settings.context | escape }}</span>{% endif %}
                </div>
              {% endif %}
            </article>
          {% endfor %}
        </div>

        <button class="siwak-testimonials__arrow siwak-testimonials__arrow--next" type="button" data-carousel-next aria-label="Témoignage vidéo suivant">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg>
        </button>
      </div>
      <div class="siwak-testimonials__navigation" aria-label="Navigation des témoignages vidéo">
        <p class="siwak-testimonials__swipe-hint">GLISSE POUR DÉCOUVRIR <span aria-hidden="true">→</span></p>
        <div class="siwak-testimonials__dots">
          {% for block in video_blocks %}
            <button type="button" class="siwak-testimonials__dot" data-carousel-dot="{{ forloop.index0 }}" aria-label="Voir le témoignage vidéo {{ forloop.index }}" aria-controls="SiwakVideoTrack-{{ section.id }}" {% if forloop.first %}aria-current="true"{% endif %}><span></span></button>
          {% endfor %}
        </div>
      </div>
    {% endif %}

    {% if review_blocks.size > 0 %}
      <div class="siwak-testimonials__reviews" role="region" aria-label="Avis clients sur le Siwak">
        <div class="siwak-testimonials__review-grid">
          {% for block in review_blocks %}
            <article class="siwak-testimonials__review" {{ block.shopify_attributes }}>
              <div class="siwak-testimonials__stars" role="img" aria-label="{{ block.settings.rating }} étoiles sur 5">
                {% for index in (1..5) %}<span aria-hidden="true">{% if index <= block.settings.rating %}★{% else %}☆{% endif %}</span>{% endfor %}
              </div>
              {% if block.settings.review_title != blank %}<h3>{{ block.settings.review_title | escape }}</h3>{% endif %}
              {% if block.settings.review_text != blank %}<p>{{ block.settings.review_text | escape }}</p>{% endif %}
              <footer>
                <strong>{{ block.settings.author | escape }}</strong>
                
              </footer>
            </article>
          {% endfor %}
        </div>
      </div>
    {% endif %}
  </section>
</siwak-testimonial-carousel>

{% style %}
  .siwak-testimonials--{{ section.id }} { --optiz-red:#e52219; --optiz-ink:#171717; --optiz-paper:#fff; display:block; overflow:hidden; border-top:6px solid var(--optiz-red); background:var(--optiz-paper); color:var(--optiz-ink); }
  .siwak-testimonials--{{ section.id }} > section { padding:clamp(54px,7vw,104px) 0; }
  .siwak-testimonials--{{ section.id }} .siwak-testimonials__header { width:min(1120px,calc(100% - 40px)); margin:0 auto clamp(32px,5vw,62px); text-align:center; }
  .siwak-testimonials--{{ section.id }} .siwak-testimonials__eyebrow { width:fit-content; margin:0 auto 12px; padding:5px 10px; border:2px solid var(--optiz-ink); background:var(--optiz-red); color:#fff; font-size:.75rem; font-weight:800; letter-spacing:.14em; text-transform:uppercase; }
  .siwak-testimonials--{{ section.id }} h2 { max-width:980px; margin:0 auto; font-family:var(--font-heading--family); font-size:clamp(3rem,6.7vw,7rem); font-weight:var(--font-heading--weight); line-height:.86; letter-spacing:-.045em; text-transform:uppercase; }
  .siwak-testimonials--{{ section.id }} .siwak-testimonials__intro { max-width:660px; margin:20px auto 0; font-size:clamp(.96rem,1.3vw,1.1rem); line-height:1.55; }
  .siwak-testimonials--{{ section.id }} .siwak-testimonials__carousel { position:relative; width:min(1600px,100%); margin:0 auto; }
  .siwak-testimonials--{{ section.id }} .siwak-testimonials__track { display:grid; grid-auto-flow:column; grid-auto-columns:clamp(210px,18vw,250px); gap:clamp(12px,1.6vw,22px); overflow-x:auto; overscroll-behavior-inline:contain; padding:4px clamp(48px,5vw,76px) 18px; scroll-behavior:smooth; scroll-padding-inline:clamp(48px,5vw,76px); scroll-snap-type:inline mandatory; scrollbar-width:none; }
  .siwak-testimonials--{{ section.id }} .siwak-testimonials__track::-webkit-scrollbar { display:none; }
  .siwak-testimonials--{{ section.id }} .siwak-testimonials__video-card { min-width:0; scroll-snap-align:start; }
  .siwak-testimonials--{{ section.id }} .siwak-testimonials__media { position:relative; aspect-ratio:9/16; overflow:hidden; border:2px solid var(--optiz-ink); border-radius:12px; background:var(--optiz-ink); }
  .siwak-testimonials--{{ section.id }} .siwak-testimonials__media video,
  .siwak-testimonials--{{ section.id }} .siwak-testimonials__media img,
  .siwak-testimonials--{{ section.id }} .siwak-testimonials__media iframe { display:block; width:100%; height:100%; border:0; object-fit:cover; }
  .siwak-testimonials--{{ section.id }} .siwak-testimonials__native-video { cursor:pointer; }
  .siwak-testimonials--{{ section.id }} .siwak-testimonials__play-toggle,
  .siwak-testimonials--{{ section.id }} .siwak-testimonials__sound-toggle,
  .siwak-testimonials--{{ section.id }} .siwak-testimonials__arrow { display:grid; place-items:center; margin:0; padding:0; border:2px solid var(--optiz-ink); background:var(--optiz-red); color:#fff; cursor:pointer; }
  .siwak-testimonials--{{ section.id }} .siwak-testimonials__play-toggle { position:absolute; z-index:2; top:50%; left:50%; width:64px; height:64px; border-color:#fff; border-radius:50%; transform:translate(-50%,-50%); }
  .siwak-testimonials--{{ section.id }} .siwak-testimonials__sound-toggle { position:absolute; z-index:2; top:14px; right:14px; width:42px; height:42px; border-color:#fff; border-radius:50%; background:var(--optiz-ink); }
  .siwak-testimonials--{{ section.id }} .siwak-testimonials__play-toggle svg { width:25px; height:25px; fill:currentColor; }
  .siwak-testimonials--{{ section.id }} .siwak-testimonials__sound-toggle svg { width:21px; height:21px; fill:currentColor; stroke:currentColor; stroke-width:2; stroke-linecap:round; stroke-linejoin:round; }
  .siwak-testimonials--{{ section.id }} .siwak-testimonials__icon-pause,
  .siwak-testimonials--{{ section.id }} .siwak-testimonials__icon-sound,
  .siwak-testimonials--{{ section.id }} .is-playing .siwak-testimonials__icon-play,
  .siwak-testimonials--{{ section.id }} .has-sound .siwak-testimonials__icon-muted { display:none; }
  .siwak-testimonials--{{ section.id }} .is-playing .siwak-testimonials__icon-pause,
  .siwak-testimonials--{{ section.id }} .has-sound .siwak-testimonials__icon-sound { display:block; }
  .siwak-testimonials--{{ section.id }} .is-playing .siwak-testimonials__play-toggle { opacity:0; }
  .siwak-testimonials--{{ section.id }} .is-playing .siwak-testimonials__media:hover .siwak-testimonials__play-toggle,
  .siwak-testimonials--{{ section.id }} .is-playing .siwak-testimonials__play-toggle:focus-visible { opacity:1; }
  .siwak-testimonials--{{ section.id }} .siwak-testimonials__arrow { position:absolute; z-index:4; top:50%; width:52px; height:52px; border-radius:50%; transform:translateY(-50%); background:#fff; color:var(--optiz-ink); box-shadow:4px 4px 0 var(--optiz-red); }
  .siwak-testimonials--{{ section.id }} .siwak-testimonials__arrow--prev { left:14px; }
  .siwak-testimonials--{{ section.id }} .siwak-testimonials__arrow--next { right:14px; }
  .siwak-testimonials--{{ section.id }} .siwak-testimonials__arrow svg { width:25px; height:25px; fill:none; stroke:currentColor; stroke-width:2.5; }
  .siwak-testimonials--{{ section.id }} .siwak-testimonials__arrow:disabled { opacity:.28; cursor:default; box-shadow:none; }
  .siwak-testimonials--{{ section.id }} button:focus-visible,
  .siwak-testimonials--{{ section.id }} .siwak-testimonials__track:focus-visible { outline:3px solid var(--optiz-red); outline-offset:3px; }
  .siwak-testimonials--{{ section.id }} .siwak-testimonials__video-caption { display:grid; gap:2px; padding:12px 2px 0; }
  .siwak-testimonials--{{ section.id }} .siwak-testimonials__video-caption strong { font-family:var(--font-heading--family); font-size:1.15rem; line-height:1; text-transform:uppercase; }
  .siwak-testimonials--{{ section.id }} .siwak-testimonials__video-caption span { font-size:.78rem; opacity:.68; }
  .siwak-testimonials--{{ section.id }} .siwak-testimonials__placeholder { display:grid; place-items:center; align-content:center; gap:12px; width:100%; height:100%; padding:22px; background:repeating-linear-gradient(-45deg,#171717 0,#171717 18px,#211f1f 18px,#211f1f 36px); color:#fff; text-align:center; }
  .siwak-testimonials--{{ section.id }} .siwak-testimonials__placeholder span { display:grid; place-items:center; width:62px; height:62px; margin-bottom:22px; border:2px solid #fff; border-radius:50%; background:var(--optiz-red); }
  .siwak-testimonials--{{ section.id }} .siwak-testimonials__placeholder strong { font-size:.9rem; letter-spacing:.1em; }
  .siwak-testimonials--{{ section.id }} .siwak-testimonials__placeholder small { font-size:.65rem; letter-spacing:.1em; opacity:.68; }
  .siwak-testimonials--{{ section.id }} .siwak-testimonials__editor-error { position:absolute; inset:auto 10px 10px; z-index:3; margin:0; padding:9px; background:#fff; color:var(--optiz-ink); font-size:.72rem; line-height:1.35; }
  .siwak-testimonials--{{ section.id }} .siwak-testimonials__reviews { width:min(1320px,calc(100% - 40px)); margin:clamp(52px,7vw,92px) auto 0; border-top:3px solid var(--optiz-ink); }
  .siwak-testimonials--{{ section.id }} .siwak-testimonials__review-grid { display:grid; grid-template-columns:repeat(3,1fr); }
  .siwak-testimonials--{{ section.id }} .siwak-testimonials__review { display:flex; flex-direction:column; min-width:0; padding:clamp(24px,3vw,38px); border-right:1px solid var(--optiz-ink); }
  .siwak-testimonials--{{ section.id }} .siwak-testimonials__review:last-child { border-right:0; }
  .siwak-testimonials--{{ section.id }} .siwak-testimonials__stars { color:var(--optiz-red); font-size:1.15rem; letter-spacing:.08em; }
  .siwak-testimonials--{{ section.id }} .siwak-testimonials__review h3 { margin:14px 0 8px; font-family:var(--font-heading--family); font-size:clamp(1.5rem,2.3vw,2.15rem); line-height:1; text-transform:uppercase; }
  .siwak-testimonials--{{ section.id }} .siwak-testimonials__review > p { margin:0 0 26px; line-height:1.55; }
  .siwak-testimonials--{{ section.id }} .siwak-testimonials__review footer { display:flex; flex-wrap:wrap; gap:8px 14px; align-items:center; margin-top:auto; font-size:.76rem; letter-spacing:.06em; text-transform:uppercase; }
  .siwak-testimonials--{{ section.id }} .siwak-testimonials__review footer span { color:var(--optiz-red); font-weight:800; }
  @media (max-width:749px) {
    .siwak-testimonials--{{ section.id }} > section { padding-block:48px; }
    .siwak-testimonials--{{ section.id }} .siwak-testimonials__header { text-align:left; }
    .siwak-testimonials--{{ section.id }} .siwak-testimonials__eyebrow { margin-left:0; }
    .siwak-testimonials--{{ section.id }} h2 { margin-left:0; font-size:clamp(2.8rem,15vw,4.8rem); }
    .siwak-testimonials--{{ section.id }} .siwak-testimonials__intro { margin-left:0; }
    .siwak-testimonials--{{ section.id }} .siwak-testimonials__track { grid-auto-columns:74vw; padding-inline:20px; scroll-padding-inline:20px; }
    .siwak-testimonials--{{ section.id }} .siwak-testimonials__arrow { display:none; }
    .siwak-testimonials--{{ section.id }} .siwak-testimonials__review-grid { display:flex; overflow-x:auto; scroll-snap-type:x mandatory; scrollbar-width:none; }
    .siwak-testimonials--{{ section.id }} .siwak-testimonials__review-grid::-webkit-scrollbar { display:none; }
    .siwak-testimonials--{{ section.id }} .siwak-testimonials__review { flex:0 0 86%; border-right:1px solid var(--optiz-ink); scroll-snap-align:start; }
  }
  @media (prefers-reduced-motion:reduce) { .siwak-testimonials--{{ section.id }} .siwak-testimonials__track { scroll-behavior:auto; } }

  /* Portrait story rail inspired by the reference, with Optiz's printed accents. */
  .siwak-testimonials--{{ section.id }} { --optiz-paper:#fdf3f1; border-top:0; }
  .siwak-testimonials--{{ section.id }} > section { padding:clamp(36px,5vw,64px) 0; }
  .siwak-testimonials--{{ section.id }} .siwak-testimonials__header { margin-bottom:28px; }
  .siwak-testimonials--{{ section.id }} .siwak-testimonials__eyebrow { padding:0; border:0; background:none; color:var(--optiz-red); font-family:'Courier New',monospace; font-size:12px; letter-spacing:.12em; }
  .siwak-testimonials--{{ section.id }} h2 { max-width:850px; font-size:clamp(40px,5vw,66px); line-height:1; letter-spacing:-.025em; }
  .siwak-testimonials--{{ section.id }} .siwak-testimonials__intro { margin-top:14px; font-size:15px; color:#62605c; }
  .siwak-testimonials--{{ section.id }} .siwak-testimonials__carousel { max-width:1400px; }
  .siwak-testimonials--{{ section.id }} .siwak-testimonials__track { grid-auto-columns:clamp(220px,22vw,270px); gap:16px; padding:4px 64px 12px; scroll-padding-inline:64px; }
  .siwak-testimonials--{{ section.id }} .siwak-testimonials__video-card { border:1px solid #292724; border-radius:18px; overflow:hidden; background:#fffdf9; box-shadow:3px 3px 0 #ddcec8; }
  .siwak-testimonials--{{ section.id }} .siwak-testimonials__media { border:0; border-radius:0; }
  .siwak-testimonials--{{ section.id }} .siwak-testimonials__video-caption { padding:12px 14px 14px; gap:4px; border-top:3px solid var(--optiz-red); }
  .siwak-testimonials--{{ section.id }} .siwak-testimonials__video-caption strong { font-size:21px; }
  .siwak-testimonials--{{ section.id }} .siwak-testimonials__video-caption span { font-size:11px; color:#62605c; opacity:1; }
  .siwak-testimonials--{{ section.id }} .siwak-testimonials__play-toggle { width:56px; height:56px; border:1px solid #fffdf9; background:var(--optiz-red); box-shadow:0 0 0 5px rgb(255 253 249 / 18%); }
  .siwak-testimonials--{{ section.id }} .is-playing .siwak-testimonials__play-toggle { top:auto; left:12px; bottom:12px; width:44px; height:44px; transform:none; opacity:1; box-shadow:none; background:rgb(23 23 23 / 75%); }
  .siwak-testimonials--{{ section.id }} .siwak-testimonials__sound-toggle { top:12px; right:12px; width:44px; height:44px; border-width:1px; background:rgb(23 23 23 / 75%); }
  .siwak-testimonials--{{ section.id }} .siwak-testimonials__arrow { width:44px; height:44px; border-width:1px; background:#fffdf9; box-shadow:2px 2px 0 var(--optiz-red); }
  .siwak-testimonials--{{ section.id }} .siwak-testimonials__navigation { display:none; justify-content:center; align-items:center; gap:18px; width:min(1120px,calc(100% - 40px)); margin:4px auto 0; }
  .siwak-testimonials--{{ section.id }} .siwak-testimonials__swipe-hint { display:none; margin:0; font:700 10px/1.4 'Courier New',monospace; letter-spacing:.06em; color:#62605c; }
  .siwak-testimonials--{{ section.id }} .siwak-testimonials__swipe-hint span { color:var(--optiz-red); font-size:18px; }
  .siwak-testimonials--{{ section.id }} .siwak-testimonials__dots { display:flex; flex-wrap:wrap; justify-content:center; }
  .siwak-testimonials--{{ section.id }} .siwak-testimonials__dot { display:grid; place-items:center; width:44px; height:44px; padding:0; border:0; background:transparent; cursor:pointer; }
