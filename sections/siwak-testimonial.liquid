<script>
  if (!customElements.get('siwak-testimonial-carousel')) {
    customElements.define('siwak-testimonial-carousel', class SiwakTestimonialCarousel extends HTMLElement {
      connectedCallback() {
        if (this.dataset.ready === 'true') return;
        this.dataset.ready = 'true';
        this.controller = new AbortController();
        const signal = this.controller.signal;
        this.track = this.querySelector('[data-carousel-track]');
        this.previous = this.querySelector('[data-carousel-prev]');
        this.next = this.querySelector('[data-carousel-next]');
        this.dots = [...this.querySelectorAll('[data-carousel-dot]')];
        this.reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

        this.querySelectorAll('.has-native-video').forEach((card) => {
          const video = card.querySelector('video');
          const playButton = card.querySelector('[data-video-toggle]');
          const soundButton = card.querySelector('[data-sound-toggle]');
          if (!video || !playButton || !soundButton) return;

          const sync = () => {
            card.classList.toggle('is-playing', !video.paused);
            card.classList.toggle('has-sound', !video.muted);
            playButton.setAttribute('aria-label', video.paused ? 'Lire le témoignage' : 'Mettre le témoignage en pause');
            soundButton.setAttribute('aria-label', video.muted ? 'Activer le son' : 'Couper le son');
          };
          const togglePlayback = () => {
            if (video.paused) {
              this.querySelectorAll('video').forEach((other) => { if (other !== video) other.pause(); });
              video.play().catch(() => {});
            } else video.pause();
          };

          playButton.addEventListener('click', togglePlayback, { signal });
          video.addEventListener('click', togglePlayback, { signal });
          soundButton.addEventListener('click', () => { video.muted = !video.muted; sync(); }, { signal });
          video.addEventListener('play', sync, { signal });
          video.addEventListener('pause', sync, { signal });
          video.addEventListener('volumechange', sync, { signal });
          sync();
        });

        if (this.track && this.previous && this.next) {
          const updateArrows = () => {
            const maximum = this.track.scrollWidth - this.track.clientWidth;
            this.previous.disabled = this.track.scrollLeft <= 2;
            this.next.disabled = this.track.scrollLeft >= maximum - 2;
            const cards = [...this.track.querySelectorAll('.siwak-testimonials__video-card')];
            const first = cards[0];
            const step = (first?.getBoundingClientRect().width || 1) + (parseFloat(getComputedStyle(this.track).columnGap) || 0);
            const index = Math.min(cards.length - 1, Math.max(0, Math.round(this.track.scrollLeft / step)));
            this.dots.forEach((dot, i) => { if (i === index) dot.setAttribute('aria-current', 'true'); else dot.removeAttribute('aria-current'); });
          };
          const move = (direction) => {
            const card = this.track.querySelector('.siwak-testimonials__video-card');
            const gap = parseFloat(getComputedStyle(this.track).columnGap) || 0;
            this.track.scrollBy({ left: direction * ((card?.getBoundingClientRect().width || this.track.clientWidth) + gap), behavior: this.reducedMotion.matches ? 'auto' : 'smooth' });
          };
          this.previous.addEventListener('click', () => move(-1), { signal });
          this.next.addEventListener('click', () => move(1), { signal });
          this.dots.forEach((dot, index) => dot.addEventListener('click', () => {
            const card = this.track.querySelector('.siwak-testimonials__video-card');
            const step = (card?.getBoundingClientRect().width || this.track.clientWidth) + (parseFloat(getComputedStyle(this.track).columnGap) || 0);
            this.track.scrollTo({ left: index * step, behavior: this.reducedMotion.matches ? 'auto' : 'smooth' });
          }, { signal }));
          this.track.addEventListener('keydown', (event) => {
            if (event.target !== this.track || !['ArrowLeft', 'ArrowRight'].includes(event.key)) return;
            event.preventDefault();
            move(event.key === 'ArrowRight' ? 1 : -1);
          }, { signal });
          this.track.addEventListener('scroll', updateArrows, { passive: true, signal });
          window.addEventListener('resize', updateArrows, { passive: true, signal });
          this.resizeObserver = new ResizeObserver(updateArrows);
          this.resizeObserver.observe(this.track);
          updateArrows();
        }
        this.visibilityObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => { if (!entry.isIntersecting) entry.target.querySelector('video')?.pause(); });
        }, { threshold: 0.3 });
        this.querySelectorAll('.has-native-video').forEach((card) => this.visibilityObserver.observe(card));
        document.addEventListener('visibilitychange', () => {
          if (document.hidden) this.querySelectorAll('video').forEach((video) => video.pause());
        }, { signal });
      }
      disconnectedCallback() {
        this.controller?.abort();
        this.resizeObserver?.disconnect();
        this.visibilityObserver?.disconnect();
        this.querySelectorAll('video').forEach((video) => video.pause());
        delete this.dataset.ready;
      }
    });
  }
</script>

