<section class="siwak-testimonial" aria-labelledby="SiwakTestimonialTitle-{{ section.id }}">
  <div class="siwak-testimonial__media">
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 1600 | image_tag: widths: '480, 720, 960, 1200, 1600', sizes: '(min-width: 800px) 42vw, 100vw', loading: 'lazy', alt: section.settings.image.alt | default: section.settings.image_alt }}
    {% else %}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'siwak-testimonial__placeholder' }}
    {% endif %}
  </div>
  <div class="siwak-testimonial__copy">
    <p class="siwak-testimonial__index">05 / PAROLE CLIENT</p>
    <h2 id="SiwakTestimonialTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
    <blockquote>
      <p>« {{ section.settings.quote | escape }} »</p>
      {% if section.settings.author != blank %}<cite>{{ section.settings.author | escape }}</cite>{% endif %}
    </blockquote>
    {% if section.settings.note != blank %}<p class="siwak-testimonial__note">{{ section.settings.note | escape }}</p>{% endif %}
  </div>
</section>

{% stylesheet %}
  .siwak-testimonial { display: grid; grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.22fr); background: #e10600; color: #fff; }
  .siwak-testimonial__media { min-height: 640px; border-right: 2px solid #171717; }
  .siwak-testimonial__media img, .siwak-testimonial__placeholder { width: 100%; height: 100%; display: block; object-fit: cover; background: #e5ded2; }
  .siwak-testimonial__copy { display: flex; flex-direction: column; justify-content: center; padding: clamp(42px, 7vw, 110px); }
  .siwak-testimonial__index { margin: 0 0 40px; font-size: 0.75rem; font-weight: 800; letter-spacing: 0.12em; }
  .siwak-testimonial h2 { margin: 0 0 38px; max-width: 750px; font-size: clamp(2.5rem, 5.4vw, 6rem); line-height: 0.93; letter-spacing: -0.05em; }
  .siwak-testimonial blockquote { margin: 0; padding: 30px 0 0; border-top: 2px solid currentColor; }
  .siwak-testimonial blockquote p { margin: 0 0 18px; max-width: 760px; font-size: clamp(1.25rem, 2.4vw, 2.25rem); line-height: 1.3; }
  .siwak-testimonial cite { font-style: normal; font-size: 0.78rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; }
  .siwak-testimonial__note { margin: 28px 0 0; max-width: 650px; padding: 14px; border: 1px solid currentColor; font-size: 0.82rem; line-height: 1.45; }
  @media (max-width: 799px) {
    .siwak-testimonial { grid-template-columns: 1fr; }
    .siwak-testimonial__media { min-height: 0; aspect-ratio: 4 / 5; border-right: 0; border-bottom: 2px solid #171717; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Siwak — témoignage",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Portrait ou contenu UGC" },
    { "type": "text", "id": "image_alt", "label": "Texte alternatif", "default": "Client utilisant un siwak Optiz" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Le prochain mot doit venir d’un vrai client." },
    { "type": "textarea", "id": "quote", "label": "Témoignage", "default": "Ajoute ici un témoignage vérifié, avec les mots exacts du client." },
    { "type": "text", "id": "author", "label": "Auteur et contexte", "default": "Prénom — durée d’utilisation à préciser" },
    { "type": "textarea", "id": "note", "label": "Note provisoire", "default": "Emplacement réservé : vérifier le témoignage et l’autorisation de diffusion avant publication." }
  ],
  "presets": [{ "name": "Siwak — témoignage" }]
}
{% endschema %}
