<section class="siwak-testimonials" aria-labelledby="SiwakTestimonialsTitle-{{ section.id }}">
  <header class="siwak-testimonials__header">
    <h2 id="SiwakTestimonialsTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
    {% if section.settings.text != blank %}<p>{{ section.settings.text | escape }}</p>{% endif %}
  </header>

  <div class="siwak-testimonials__videos">
    {% for block in section.blocks %}
      <article class="siwak-testimonials__video" {{ block.shopify_attributes }}>
        <div class="siwak-testimonials__media">
          {% if block.settings.video != blank %}
            {{ block.settings.video | video_tag: controls: true, image_size: '900x', preload: 'metadata' }}
          {% elsif block.settings.poster != blank %}
            {{ block.settings.poster | image_url: width: 1000 | image_tag: widths: '400, 600, 800, 1000', sizes: '(min-width: 800px) 33vw, 82vw', loading: 'lazy', alt: block.settings.poster.alt | default: block.settings.title }}
            <span class="siwak-testimonials__play" aria-hidden="true">▶</span>
          {% else %}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'siwak-testimonials__placeholder' }}
            <span class="siwak-testimonials__play" aria-hidden="true">▶</span>
          {% endif %}
        </div>
        {% if block.settings.title != blank %}<h3>{{ block.settings.title | escape }}</h3>{% endif %}
        {% if block.settings.context != blank %}<p>{{ block.settings.context | escape }}</p>{% endif %}
      </article>
    {% endfor %}
  </div>

  {% if request.design_mode and section.settings.editor_warning != blank %}
    <p class="siwak-testimonials__warning">{{ section.settings.editor_warning | escape }}</p>
  {% endif %}
</section>

{% stylesheet %}
  .siwak-testimonials { background: #e52219; color: #fff; padding: clamp(58px, 8vw, 112px) max(20px, calc((100vw - 1320px) / 2)); }
  .siwak-testimonials__header { display: grid; grid-template-columns: 1.25fr 0.75fr; gap: 36px; align-items: end; margin-bottom: 42px; }
  .siwak-testimonials h2 { max-width: 900px; margin: 0; font-size: clamp(2.6rem, 6vw, 6.4rem); line-height: 0.9; letter-spacing: -0.055em; }
  .siwak-testimonials__header p { margin: 0; padding-top: 14px; border-top: 2px solid currentcolor; line-height: 1.5; }
  .siwak-testimonials__videos { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(14px, 2.5vw, 30px); }
  .siwak-testimonials__media { position: relative; aspect-ratio: 9 / 16; overflow: hidden; border: 2px solid #171717; background: #171717; }
  .siwak-testimonials__media video, .siwak-testimonials__media img, .siwak-testimonials__placeholder { width: 100%; height: 100%; display: block; object-fit: cover; }
  .siwak-testimonials__play { position: absolute; left: 50%; top: 50%; display: grid; place-items: center; width: 62px; height: 62px; border: 2px solid #fff; border-radius: 50%; transform: translate(-50%, -50%); background: #e52219; color: #fff; font-size: 1.15rem; }
  .siwak-testimonials__video h3 { margin: 14px 0 3px; font-size: 1.1rem; text-transform: uppercase; }
  .siwak-testimonials__video > p { margin: 0; font-size: 0.84rem; opacity: 0.8; }
  .siwak-testimonials__warning { margin: 30px 0 0; padding: 11px 13px; border: 1px dashed currentcolor; font-size: 0.78rem; }
  @media (max-width: 749px) {
    .siwak-testimonials__header { grid-template-columns: 1fr; }
    .siwak-testimonials__videos { display: flex; gap: 16px; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 10px; }
    .siwak-testimonials__video { flex: 0 0 82%; scroll-snap-align: start; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Siwak — avis vidéo",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Voici ce que nos clients pensent du Siwak d’Optiz" },
    { "type": "textarea", "id": "text", "label": "Introduction", "default": "Trois expériences, racontées directement par ceux qui ont intégré le siwak à leur routine." },
    { "type": "textarea", "id": "editor_warning", "label": "Avertissement dans l’éditeur", "default": "Ajouter uniquement des témoignages authentiques dont la diffusion a été autorisée." }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Témoignage vidéo",
      "settings": [
        { "type": "video", "id": "video", "label": "Vidéo verticale" },
        { "type": "image_picker", "id": "poster", "label": "Affiche provisoire" },
        { "type": "text", "id": "title", "label": "Prénom", "default": "Témoignage client" },
        { "type": "text", "id": "context", "label": "Contexte", "default": "Durée d’utilisation à préciser" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Siwak — avis vidéo",
      "blocks": [
        { "type": "testimonial" }, { "type": "testimonial" }, { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}
