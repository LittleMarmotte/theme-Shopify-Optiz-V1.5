        </div>

      </div><!-- /.op-offer__body -->
    </div><!-- /.op-offer -->
  </div><!-- /.op-container -->
</div><!-- /.op-pdp -->

<script>
(function () {
  'use strict';

  var sid = '{{ section.id }}';
  var offer = document.getElementById('op-pdp-' + sid);
  if (!offer) return;

  var tiers = Array.from(offer.querySelectorAll('.op-tier'));
  var gifts = Array.from(offer.querySelectorAll('.op-gift'));
  var currentCode = 'MASTIC10'; /* code du palier actif par défaut (palier 2) */

  /* Formate un nombre en prix FR (ex: 35,90€) */
  function fmt(n) {
    return Number(n).toLocaleString('fr-FR', {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2
    }) + '€';
  }

  /* Date dynamique — aujourd'hui + 4 jours */
  (function setGiftDate() {
    var jours   = ['dim.','lun.','mar.','mer.','jeu.','ven.','sam.'];
    var mois    = ['janv.','févr.','mars','avr.','mai','juin','juil.','août','sept.','oct.','nov.','déc.'];
    var cible   = new Date();
    cible.setDate(cible.getDate() + 4);
    var label   = "jusqu'au " + jours[cible.getDay()] + ' ' + cible.getDate() + ' ' + mois[cible.getMonth()];
    var el      = document.getElementById('op-gift-date-' + sid);
    if (el) el.textContent = label;
  })();

  /* Sélection d'un palier */
  function selectTier(tierEl) {
    if (!tierEl) return;

    tiers.forEach(function (t) {
      t.classList.remove('is-active');
      t.setAttribute('aria-checked', 'false');
    });
    tierEl.classList.add('is-active');
    tierEl.setAttribute('aria-checked', 'true');

    var tier     = parseInt(tierEl.dataset.tier, 10);
    var price    = parseFloat(tierEl.dataset.price);
    var strike   = parseFloat(tierEl.dataset.strike);
    var discount = parseInt(tierEl.dataset.discount, 10);
    var giftCnt  = parseInt(tierEl.dataset.gifts, 10);
    var unit     = parseFloat(tierEl.dataset.unit);
    currentCode  = tierEl.dataset.code || '';

    /* Cadeaux : verrouillé si palier insuffisant */
    gifts.forEach(function (g) {
      var min = parseInt(g.dataset.minTier, 10);
      g.classList.toggle('is-locked', tier < min);
    });

    /* Mise à jour du CTA */
    var ctaNow    = document.getElementById('op-cta-now-'    + sid);
    var ctaStrike = document.getElementById('op-cta-strike-' + sid);
    if (ctaNow)    ctaNow.textContent    = fmt(price);
    if (ctaStrike) {
      ctaStrike.style.display = discount > 0 ? 'inline' : 'none';
      if (discount > 0) ctaStrike.textContent = fmt(strike);
    }

    /* Mise à jour du récap */
    var rUnit     = document.getElementById('op-unit-'     + sid);
    var rDiscount = document.getElementById('op-discount-' + sid);
    var rGifts    = document.getElementById('op-gifts-'    + sid);
    if (rUnit)     rUnit.textContent     = fmt(unit);
    if (rDiscount) rDiscount.textContent = discount > 0 ? ('-' + discount + '%') : 'sans réduc.';
    if (rGifts)    rGifts.textContent    = giftCnt + (giftCnt > 1 ? ' cadeaux' : ' cadeau');

    /* Lien achat unique : affiche le prix unitaire du palier 1 */
    var singleBtn = document.getElementById('op-singlebuy-' + sid);
    if (singleBtn) singleBtn.textContent = 'Achat unique — 22,50€';
  }

  /* Bind clics sur les paliers */
  tiers.forEach(function (t) {
    t.addEventListener('click', function () { selectTier(t); });
    t.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); selectTier(t); }
    });
  });

  /* Ajout au panier via Shopify Cart API */
  function addToCart(variantId, qty) {
    var btn   = document.getElementById('op-cta-' + sid);
    var label = document.getElementById('op-cta-label-' + sid);

    if (btn)   btn.disabled = true;
    if (label) label.textContent = 'Ajout en cours…';

    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: variantId, quantity: qty })
    })
    .then(function (res) { return res.json(); })
    .then(function (data) {
      if (data.status && data.status >= 400) {
        /* Erreur serveur (rupture de stock, etc.) */
        if (label) label.textContent = data.message || 'Erreur — réessaie';
        setTimeout(function () {
          if (btn)   btn.disabled = false;
          if (label) label.textContent = 'Ajouter au panier';
        }, 3000);
        return;
      }

      /* Succès — applique le code promo puis ouvre le drawer */
      function openDrawer() {
        document.dispatchEvent(new CustomEvent('cart:update', {
          bubbles: true,
          detail: { data: {} }
        }));
        if (label) label.textContent = 'Ajouté ✓';
        setTimeout(function () {
          if (btn)   btn.disabled = false;
          if (label) label.textContent = 'Ajouter au panier';
        }, 2200);
      }

      if (currentCode) {
        fetch('/discount/' + currentCode, { redirect: 'follow' })
          .then(openDrawer)
          .catch(openDrawer);
      } else {
        openDrawer();
      }
    })
    .catch(function (err) {
      console.error('[Optiz] Cart error:', err);
      if (btn)   btn.disabled = false;
      if (label) label.textContent = 'Ajouter au panier';
    });
  }

  /* CTA click */
  var ctaBtn = document.getElementById('op-cta-' + sid);
  if (ctaBtn) {
    ctaBtn.addEventListener('click', function () {
      var active    = offer.querySelector('.op-tier.is-active');
      if (!active)  return;
      var variantId = ctaBtn.dataset.variantId;
      var qty       = parseInt(active.dataset.qty, 10);
      addToCart(variantId, qty);
    });
  }

  /* Lien achat unique → revient au palier 1 */
  var singleBtn = document.getElementById('op-singlebuy-' + sid);
  if (singleBtn) {
    singleBtn.addEventListener('click', function () {
      selectTier(tiers[0]);
      if (ctaBtn) ctaBtn.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
  }

})();
</script>

