{% liquid
  assign hero_link = section.settings.button_link | default: routes.all_products_collection_url
  assign fallback_image = 'https://cdn.shopify.com/s/files/1/0961/2355/2126/files/optiz-banniere-panoramique-v3.png?v=1789184680'
%}

<section class="optiz-home-hero optiz-home-hero--{{ section.id }}">
  <div class="optiz-home-hero__media" aria-hidden="true">
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 2400 | image_tag:
        widths: '750, 1100, 1500, 1942, 2400',
        sizes: '100vw',
        loading: 'eager',
        fetchpriority: 'high',
        class: 'optiz-home-hero__image'
      }}
    {% else %}
      <img
        class="optiz-home-hero__image"
        src="{{ fallback_image }}"
        alt=""
        width="1942"
        height="809"
        fetchpriority="high"
      >
    {% endif %}
  </div>

  <div class="optiz-home-hero__shade"></div>

  <div class="optiz-home-hero__content page-width">
    {% if section.settings.eyebrow != blank %}
      <p class="optiz-home-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {% endif %}
    <h1 class="optiz-home-hero__title">{{ section.settings.heading | escape }}</h1>
    {% if section.settings.text != blank %}
      <div class="optiz-home-hero__text rte">{{ section.settings.text }}</div>
    {% endif %}
    {% if section.settings.button_label != blank %}
      <a class="optiz-home-hero__button" href="{{ hero_link }}">
        {{ section.settings.button_label | escape }}
      </a>
    {% endif %}
  </div>
</section>

{% style %}
  .optiz-home-hero--{{ section.id }} {
    --optiz-red: #e52219;
    --optiz-ink: #171717;
    position: relative;
    min-height: clamp(520px, 56vw, 760px);
    display: grid;
    align-items: center;
    overflow: hidden;
    background: var(--optiz-ink);
    color: #fff;
  }

  .optiz-home-hero--{{ section.id }} .optiz-home-hero__media,
  .optiz-home-hero--{{ section.id }} .optiz-home-hero__shade {
    position: absolute;
    inset: 0;
  }

  .optiz-home-hero--{{ section.id }} .optiz-home-hero__image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center;
  }

  .optiz-home-hero--{{ section.id }} .optiz-home-hero__shade {
    background: linear-gradient(90deg, rgba(13, 13, 13, .96) 0%, rgba(13, 13, 13, .83) 34%, rgba(13, 13, 13, .12) 67%, rgba(13, 13, 13, 0) 100%);
  }

  .optiz-home-hero--{{ section.id }} .optiz-home-hero__content {
    position: relative;
    z-index: 1;
    width: 100%;
    padding-block: clamp(64px, 9vw, 118px);
    padding-inline: clamp(20px, 4vw, 64px);
  }

  .optiz-home-hero--{{ section.id }} .optiz-home-hero__content > * {
    max-width: 650px;
  }

  .optiz-home-hero--{{ section.id }} .optiz-home-hero__eyebrow {
    margin: 0 0 12px;
    font-family: var(--font-subheading--family);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: .13em;
    text-transform: uppercase;
    color: var(--optiz-red);
  }

  .optiz-home-hero--{{ section.id }} .optiz-home-hero__title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(3.15rem, 6.2vw, 6.8rem);
    font-weight: 700;
    line-height: .88;
    letter-spacing: -.025em;
    text-transform: uppercase;
    text-wrap: balance;
    color: #fff;
  }

  .optiz-home-hero--{{ section.id }} .optiz-home-hero__text {
    margin-top: 22px;
    max-width: 560px;
    font-size: clamp(1.04rem, 1.4vw, 1.25rem);
    line-height: 1.55;
    color: rgba(255, 255, 255, .9);
  }

  .optiz-home-hero--{{ section.id }} .optiz-home-hero__text p { margin: 0; }

  .optiz-home-hero--{{ section.id }} .optiz-home-hero__button {
    display: inline-flex;
    min-height: 52px;
    align-items: center;
    justify-content: center;
    margin-top: 30px;
    padding: 13px 22px;
    border: 2px solid var(--optiz-red);
    background: var(--optiz-red);
    color: #fff;
    font-family: var(--font-accent--family);
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: .035em;
    text-transform: uppercase;
    text-decoration: none;
    box-shadow: 5px 5px 0 #fff;
    transition: transform .16s ease, box-shadow .16s ease;
  }

  .optiz-home-hero--{{ section.id }} .optiz-home-hero__button:hover {
    transform: translate(2px, 2px);
    box-shadow: 3px 3px 0 #fff;
  }

  .optiz-home-hero--{{ section.id }} .optiz-home-hero__button:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 4px;
  }

  @media (max-width: 749px) {
    .optiz-home-hero--{{ section.id }} {
      min-height: 690px;
      align-items: end;
    }

    .optiz-home-hero--{{ section.id }} .optiz-home-hero__image {
      object-position: 68% center;
    }

    .optiz-home-hero--{{ section.id }} .optiz-home-hero__shade {
      background: linear-gradient(0deg, rgba(13, 13, 13, .98) 0%, rgba(13, 13, 13, .9) 38%, rgba(13, 13, 13, .2) 76%, rgba(13, 13, 13, .08) 100%);
    }

    .optiz-home-hero--{{ section.id }} .optiz-home-hero__content {
      padding-block: 48px;
    }

    .optiz-home-hero--{{ section.id }} .optiz-home-hero__title {
      font-size: clamp(3rem, 14vw, 4.6rem);
    }

    .optiz-home-hero--{{ section.id }} .optiz-home-hero__button {
      width: 100%;
      max-width: 390px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .optiz-home-hero--{{ section.id }} .optiz-home-hero__button { transition: none; }
  }
{% endstyle %}

{% schema %}
{
  "name": "Optiz — Hero home",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Bannière" },
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "La mission Optiz" },
    { "type": "textarea", "id": "heading", "label": "Titre", "default": "Moins d’indésirables. Plus de contrôle." },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Des alternatives simples pour réduire la place des microplastiques et des substances controversées dans ta routine quotidienne.</p>" },
    { "type": "text", "id": "button_label", "label": "Libellé du bouton", "default": "Remplacer ma routine avec Optiz" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton" }
  ],
  "presets": [{ "name": "Optiz — Hero home" }]
}
{% endschema %}
