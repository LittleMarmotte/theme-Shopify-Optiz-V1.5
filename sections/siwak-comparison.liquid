{% liquid
  assign siwak_image_alt = section.settings.siwak_image.alt | default: section.settings.siwak_image_alt
  assign strips_image_alt = section.settings.strips_image.alt | default: section.settings.strips_image_alt
%}
<siwak-comparison-motion>
<section class="siwak-comparison" aria-labelledby="SiwakComparisonTitle-{{ section.id }}">
  <div class="siwak-comparison__inner">
    <header class="siwak-comparison__header">
      {% if section.settings.eyebrow != blank %}<p class="siwak-comparison__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      <h2 id="SiwakComparisonTitle-{{ section.id }}" class="siwak-comparison__heading">
        {{ section.settings.heading | escape }}
        {% if section.settings.heading_accent != blank %}<span>{{ section.settings.heading_accent | escape }}</span>{% endif %}
      </h2>
      {% if section.settings.text != blank %}<p class="siwak-comparison__intro">{{ section.settings.text | escape }}</p>{% endif %}
    </header>
    <div class="siwak-comparison__panels">
      <article class="siwak-comparison__panel siwak-comparison__panel--strips" aria-labelledby="SiwakStripsTitle-{{ section.id }}">
        <div class="siwak-comparison__media siwak-comparison__media--strips">
          {% if section.settings.strips_image != blank %}
            {{ section.settings.strips_image | image_url: width: 1000 | image_tag: class: 'siwak-comparison__image', widths: '360, 540, 720, 1000', sizes: '(min-width: 1100px) 420px, (min-width: 750px) 34vw, 64vw', loading: 'lazy', alt: strips_image_alt }}
          {% else %}
            <img class="siwak-comparison__image" src="{{ 'optiz-drdent-purple-strips-cutout-v4.png' | file_url }}" width="1024" height="1536" loading="lazy" alt="{{ strips_image_alt | escape }}">
          {% endif %}
        </div>
        <div class="siwak-comparison__content">
          <header class="siwak-comparison__product-heading">
            <h3 id="SiwakStripsTitle-{{ section.id }}">{{ section.settings.strips_heading | escape }}</h3>
            {% if section.settings.strips_subheading != blank %}<p>{{ section.settings.strips_subheading | escape }}</p>{% endif %}
          </header>
          <dl class="siwak-comparison__criteria">
            {% for block in section.blocks %}
              <div class="siwak-comparison__criterion">
                <span class="siwak-comparison__mark" aria-hidden="true"><svg viewBox="0 0 20 20" fill="none"><path d="m6 6 8 8m0-8-8 8" stroke="currentColor" stroke-width="2.5" stroke-linecap="square"/></svg></span>
                <dt{% if block.settings.criterion == blank %} class="siwak-comparison__visually-hidden"{% endif %}>{{ block.settings.criterion | default: section.settings.strips_heading | escape }}</dt>
                <dd>{{ block.settings.strips | escape }}</dd>
              </div>
            {% endfor %}
          </dl>
        </div>
      </article>
      <span class="siwak-comparison__versus" aria-hidden="true">{{ section.settings.versus_label | escape }}</span>
      <article class="siwak-comparison__panel siwak-comparison__panel--siwak" aria-labelledby="SiwakNaturalTitle-{{ section.id }}">
        <div class="siwak-comparison__media siwak-comparison__media--siwak{% if section.settings.siwak_image == blank or section.settings.siwak_image.src contains 'optiz-siwak-cutout' %} siwak-comparison__media--cutout{% endif %}">
          {% if section.settings.siwak_image != blank %}
            {{ section.settings.siwak_image | image_url: width: 900 | image_tag: class: 'siwak-comparison__image', widths: '240, 360, 540, 720, 900', sizes: '(min-width: 1100px) 230px, (min-width: 750px) 18vw, 31vw', loading: 'lazy', alt: siwak_image_alt }}
          {% else %}
            <img class="siwak-comparison__image" src="{{ 'optiz-siwak-cutout.png' | file_url }}" width="941" height="1672" loading="lazy" alt="{{ siwak_image_alt | escape }}">
          {% endif %}
        </div>
        <div class="siwak-comparison__content">
          <header class="siwak-comparison__product-heading">
            <h3 id="SiwakNaturalTitle-{{ section.id }}">{{ section.settings.siwak_heading | escape }}</h3>
            {% if section.settings.siwak_subheading != blank %}<p>{{ section.settings.siwak_subheading | escape }}</p>{% endif %}
          </header>
          <dl class="siwak-comparison__criteria">
            {% for block in section.blocks %}
              <div class="siwak-comparison__criterion" {{ block.shopify_attributes }}>
                <span class="siwak-comparison__mark" aria-hidden="true"><svg viewBox="0 0 20 20" fill="none"><path d="m4 10 4 4 8-8" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" stroke-linejoin="miter"/></svg></span>
                <dt{% if block.settings.criterion == blank %} class="siwak-comparison__visually-hidden"{% endif %}>{{ block.settings.criterion | default: section.settings.siwak_heading | escape }}</dt>
                <dd>{{ block.settings.siwak | escape }}</dd>
              </div>
            {% endfor %}
          </dl>
        </div>
      </article>
    </div>
    {% if section.settings.button_label != blank %}
      <div class="siwak-comparison__action">
        <a class="siwak-comparison__button" href="#siwak-buy"><span>{{ section.settings.button_label | escape }}</span><svg viewBox="0 0 24 24" aria-hidden="true" fill="none"><path d="M4 12h15m-6-6 6 6-6 6" stroke="currentColor" stroke-width="2"/></svg></a>
      </div>
    {% endif %}
    {% if section.settings.note != blank %}<p class="siwak-comparison__note">{{ section.settings.note | escape }}</p>{% endif %}
  </div>
</section>
</siwak-comparison-motion>
{% stylesheet %}
  siwak-comparison-motion { display: block; }
  .siwak-comparison { --siwak-red: #e52219; --siwak-ink: #171717; --siwak-paper: #f5f1e9; background: var(--siwak-paper); color: var(--siwak-ink); padding: clamp(58px, 7.5vw, 108px) 24px clamp(58px, 7vw, 96px); overflow: clip; }
  .siwak-comparison *, .siwak-comparison *::before, .siwak-comparison *::after { box-sizing: border-box; }
  .siwak-comparison__inner { max-width: 1320px; margin-inline: auto; }
  .siwak-comparison__header { max-width: 1100px; margin: 0 auto 76px; text-align: center; }
  .siwak-comparison__eyebrow { margin: 0 0 18px; font: 700 12px/1.4 "Courier New", monospace; letter-spacing: .18em; text-transform: uppercase; }
  .siwak-comparison__eyebrow::before { content: ""; display: inline-block; width: 32px; height: 3px; margin: 0 12px 3px 0; background: var(--siwak-red); }
  .siwak-comparison .siwak-comparison__heading { margin: 0; font-family: "Barlow Condensed", var(--font-heading--family), sans-serif; font-size: clamp(48px, 6.5vw, 98px); font-weight: 800; line-height: .93; letter-spacing: -.025em; text-transform: uppercase; text-wrap: balance; overflow-wrap: anywhere; color: inherit; }
  .siwak-comparison__heading span { display: block; color: var(--siwak-red); }
  .siwak-comparison__intro { max-width: 550px; margin: 22px auto 0; font-size: 16px; line-height: 1.6; }
  .siwak-comparison__panels { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 40px; align-items: stretch; }
  .siwak-comparison__panel { position: relative; min-width: 0; border: 2px solid var(--siwak-ink); }
  .siwak-comparison__panel--strips { background: #fff; padding: 36px 28px 38px 38%; }
  .siwak-comparison__panel--siwak { background: var(--siwak-ink); color: var(--siwak-paper); padding: 36px 32% 38px 34px; box-shadow: 9px 9px 0 var(--siwak-red); }
  .siwak-comparison__panel--siwak::before { content: ""; position: absolute; top: -2px; left: -2px; right: -2px; height: 9px; background: var(--siwak-red); }
  .siwak-comparison__content { position: relative; z-index: 1; min-width: 0; }
  .siwak-comparison__product-heading { min-height: 125px; }
  .siwak-comparison .siwak-comparison__product-heading h3 { margin: 0; color: inherit; font-family: "Barlow Condensed", var(--font-heading--family), sans-serif; font-size: clamp(28px, 3.05vw, 44px); font-weight: 800; line-height: .98; letter-spacing: -.015em; text-transform: uppercase; overflow-wrap: anywhere; }
  .siwak-comparison__product-heading p { margin: 12px 0 24px; font: 700 11px/1.5 "Courier New", monospace; letter-spacing: .08em; }
  .siwak-comparison__panel--strips .siwak-comparison__product-heading p { color: #68615a; }
  .siwak-comparison__panel--siwak .siwak-comparison__product-heading p { color: #efb4ae; }
  .siwak-comparison__criteria { display: grid; gap: 25px; margin: 0; }
  .siwak-comparison__criterion { position: relative; min-width: 0; padding-left: 40px; }
  .siwak-comparison__criterion dt { margin: 0 0 5px; font: 700 10px/1.5 "Courier New", monospace; letter-spacing: .05em; text-transform: uppercase; }
  .siwak-comparison__panel--strips .siwak-comparison__criterion dt { color: #6b645d; }
  .siwak-comparison__panel--siwak .siwak-comparison__criterion dt { color: #c0b9b2; }
  .siwak-comparison__criterion dd { margin: 0; font-size: clamp(14px, 1.3vw, 18px); font-weight: 600; line-height: 1.45; overflow-wrap: anywhere; }
  .siwak-comparison__mark { position: absolute; left: 0; top: 19px; display: grid; place-items: center; width: 27px; height: 27px; border: 1.5px solid currentColor; color: var(--siwak-ink); }
  .siwak-comparison__mark svg { display: block; width: 19px; height: 19px; }
  .siwak-comparison__panel--strips .siwak-comparison__mark {
    border-color: var(--siwak-red);
    background: #fce3df;
    color: var(--siwak-red);
  }
  .siwak-comparison__panel--strips .siwak-comparison__product-heading p {
    color: #b5231b;
  }
  .siwak-comparison__media--strips::after {
    content: "×";
    position: absolute;
    z-index: 2;
    top: 8%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border: 2px solid var(--siwak-ink);
    background: var(--siwak-red);
    color: #fff;
    box-shadow: 3px 3px 0 var(--siwak-ink);
    font-family: var(--font-body--family);
    font-size: 30px;
    font-weight: 700;
    line-height: 1;
    transform: rotate(-8deg);
  }
  .siwak-comparison__panel--siwak .siwak-comparison__mark { border-color: var(--siwak-red); background: var(--siwak-red); color: #fff; }
  .siwak-comparison__media { position: absolute; pointer-events: none; transform: translate3d(var(--comparison-scroll-x, 0px), 0, 0); }
  .siwak-comparison__media--strips { left: -2%; top: 6%; bottom: 6%; width: 32%; }
  .siwak-comparison__media--siwak { top: -45px; bottom: -12px; right: 12px; width: 33%; }
  .siwak-comparison__image { display: block; width: 100%; height: 100%; object-fit: contain; }
  /* Fade only the bottom of each product image into its card background. */
  .siwak-comparison__media .siwak-comparison__image {
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 80%, rgb(0 0 0 / 20%) 88%, transparent 94%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 0%, #000 80%, rgb(0 0 0 / 20%) 88%, transparent 94%, transparent 100%);
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
  }
  .siwak-comparison__media--strips .siwak-comparison__image {
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 68%, rgb(0 0 0 / 92%) 74%, rgb(0 0 0 / 68%) 80%, rgb(0 0 0 / 32%) 86%, rgb(0 0 0 / 6%) 92%, transparent 97%);
    mask-image: linear-gradient(to bottom, #000 0%, #000 68%, rgb(0 0 0 / 92%) 74%, rgb(0 0 0 / 68%) 80%, rgb(0 0 0 / 32%) 86%, rgb(0 0 0 / 6%) 92%, transparent 97%);
  }
  /* The transparent canvas extends beyond the narrow product silhouette. */
  .siwak-comparison__media--strips .siwak-comparison__image { position: absolute; left: 50%; width: 200%; max-width: none; height: 100%; transform: translateX(-50%); filter: drop-shadow(0 4px 6px rgb(23 23 23 / 8%)); }
  .siwak-comparison__media--siwak .siwak-comparison__image { object-position: center bottom; }
  .siwak-comparison__media--cutout .siwak-comparison__image { position: absolute; left: 50%; width: auto; max-width: none; height: 100%; transform: translateX(-50%) rotate(7deg); transform-origin: center bottom; }
  .siwak-comparison__versus { position: absolute; z-index: 3; left: 50%; top: 50%; transform: translate(-50%, -50%) rotate(-5deg); display: grid; place-items: center; width: 88px; min-height: 88px; padding: 6px; border: 3px solid var(--siwak-ink); background: var(--siwak-red); color: #fff; box-shadow: 4px 4px 0 var(--siwak-ink); font-family: "Barlow Condensed", var(--font-heading--family), sans-serif; font-size: 44px; font-weight: 800; line-height: 1; text-align: center; overflow-wrap: anywhere; }
  .siwak-comparison__action { margin-top: 43px; text-align: center; }
  .siwak-comparison__button { display: inline-flex; align-items: center; justify-content: space-between; gap: 30px; min-height: 60px; max-width: 100%; padding: 14px 22px; border: 2px solid var(--siwak-ink); box-shadow: 5px 5px 0 var(--siwak-ink); background: var(--siwak-red); color: #fff; text-decoration: none; font-family: "Barlow Condensed", var(--font-heading--family), sans-serif; font-size: 24px; font-weight: 800; line-height: 1.15; letter-spacing: .02em; text-transform: uppercase; transition: background-color 160ms ease, color 160ms ease; }
  .siwak-comparison__button span { overflow-wrap: anywhere; }
  .siwak-comparison__button svg { flex: 0 0 26px; width: 26px; height: 26px; }
  .siwak-comparison__button:hover { background: var(--siwak-ink); color: #fff; }
  .siwak-comparison__button:focus-visible { outline: 3px solid var(--siwak-red); outline-offset: 8px; }
  .siwak-comparison__note { max-width: 680px; margin: 25px auto 0; font-size: 12px; line-height: 1.6; text-align: center; }
  .siwak-comparison__visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media (min-width: 750px) and (max-width: 1099px) {
    .siwak-comparison__panels { gap: 26px; }
    .siwak-comparison__panel--strips { padding: 28px 20px 32px 38%; }
    .siwak-comparison__panel--siwak { padding: 28px 31% 32px 25px; }
    .siwak-comparison__media--strips { width: 32%; }
    .siwak-comparison__criterion { padding-left: 32px; }
    .siwak-comparison__mark { width: 23px; height: 23px; }
    .siwak-comparison__versus { width: 66px; min-height: 66px; font-size: 36px; }
  }
  @media (max-width: 749px) {
    .siwak-comparison { padding-inline: 18px; }
    .siwak-comparison__header { margin-bottom: 44px; }
    .siwak-comparison__eyebrow { font-size: 10px; margin-bottom: 14px; }
    .siwak-comparison .siwak-comparison__heading { font-size: clamp(42px, 10.6vw, 72px); line-height: .97; }
    .siwak-comparison__intro { max-width: 350px; margin-top: 18px; font-size: 14px; }
    .siwak-comparison__panels { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0; max-width: 510px; margin-inline: auto; }
    .siwak-comparison__panel--strips { padding: 28px 21px 32px 38%; }
    .siwak-comparison__panel--siwak { padding: 31px 31% 34px 23px; box-shadow: 6px 6px 0 var(--siwak-red); }
    .siwak-comparison__product-heading { min-height: 0; }
    .siwak-comparison .siwak-comparison__product-heading h3 { font-size: clamp(28px, 7.6vw, 38px); }
    .siwak-comparison__product-heading p { margin: 11px 0 27px; font-size: 10px; letter-spacing: .03em; }
    .siwak-comparison__criteria { gap: 22px; }
    .siwak-comparison__criterion { padding-left: 33px; }
    .siwak-comparison__criterion dt { font-size: 9px; margin-bottom: 4px; }
    .siwak-comparison__criterion dd { font-size: 14px; line-height: 1.5; }
    .siwak-comparison__mark { width: 23px; height: 23px; top: 17px; }
    .siwak-comparison__mark svg { width: 16px; height: 16px; }
    .siwak-comparison__media--strips { top: 6%; bottom: 6%; width: 32%; }
    .siwak-comparison__media--siwak { top: -30px; right: 10px; bottom: -7px; width: 32%; }
    .siwak-comparison__versus { position: relative; justify-self: center; left: auto; top: auto; width: 74px; min-height: 74px; margin-block: -10px; font-size: 39px; transform: rotate(-5deg); }
    .siwak-comparison__action { margin-top: 35px; }
    .siwak-comparison__button { min-height: 58px; font-size: 23px; gap: 24px; }
  }
  @media (max-width: 359px) {
    .siwak-comparison { padding-inline: 14px; }
    .siwak-comparison__panel--strips { padding-right: 14px; padding-left: 38%; }
    .siwak-comparison__panel--siwak { padding-left: 17px; padding-right: 27%; }
    .siwak-comparison__media--strips { width: 32%; }
    .siwak-comparison__media--siwak { right: 10px; width: 32%; }
    .siwak-comparison__criterion { padding-left: 29px; }
    .siwak-comparison__criterion dd { font-size: 13px; }
  }
  @media (prefers-reduced-motion: reduce) { .siwak-comparison__button { transition: none; } }
{% endstylesheet %}

{% javascript %}
if (!customElements.get('siwak-comparison-motion')) {
  customElements.define('siwak-comparison-motion', class extends HTMLElement {
    connectedCallback() {
      this.controller?.abort();
      this.controller = new AbortController();
      const { signal } = this.controller;
      this.panels = [...this.querySelectorAll('.siwak-comparison__panel')];
      this.motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
      this.visible = true;
      const update = () => {
        this.frame = 0;
        if (this.motionPreference.matches) {
          this.panels.forEach(panel => panel.style.removeProperty('--comparison-scroll-x'));
          return;
        }
        const height = window.innerHeight || document.documentElement.clientHeight;
        const positions = this.panels.map(panel => {
          const rect = panel.getBoundingClientRect();
          const progress = Math.min(1, Math.max(0, (height - rect.top) / (height + rect.height)));
          // Double the lateral scroll movement, capped at 48px.
          const distance = Math.min(48, rect.width * .10);
          const direction = panel.classList.contains('siwak-comparison__panel--strips') ? 1 : -1;
          return direction * distance * progress;
        });
        this.panels.forEach((panel, index) =>
          panel.style.setProperty('--comparison-scroll-x', positions[index].toFixed(2) + 'px'));
      };
      this.schedule = () => {
        if (this.frame || !this.visible) return;
        this.frame = requestAnimationFrame(update);
      };
      window.addEventListener('scroll', this.schedule, { passive: true, signal });
      window.addEventListener('resize', this.schedule, { passive: true, signal });
      document.querySelector('.page-wrapper')?.addEventListener('scroll', this.schedule, { passive: true, signal });
      this.motionPreference.addEventListener('change', this.schedule, { signal });
      this.observer = new IntersectionObserver(([entry]) => {
        this.visible = entry.isIntersecting;
        if (this.visible) this.schedule();
      }, { rootMargin: '100px' });
      this.observer.observe(this);
      this.schedule();
    }
    disconnectedCallback() {
      this.controller?.abort();
      this.observer?.disconnect();
      cancelAnimationFrame(this.frame);
      this.frame = 0;
      this.panels?.forEach(panel => panel.style.removeProperty('--comparison-scroll-x'));
    }
  });
}
{% endjavascript %}

{% schema %}
{
  "name": "Siwak — comparaison",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "LE FACE-À-FACE" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "LES BANDES, TU CONNAIS." },
    { "type": "text", "id": "heading_accent", "label": "Suite du titre en rouge", "default": "ESSAIE LE GESTE SIWAK." },
    { "type": "textarea", "id": "text", "label": "Introduction", "default": "Tu cherches un sourire plus clair. Choisis aussi le geste qui va avec ta routine." },
    { "type": "text", "id": "versus_label", "label": "Séparateur", "default": "VS" },
    { "type": "header", "content": "Siwak Optiz" },
    { "type": "text", "id": "siwak_heading", "label": "Titre du panneau Siwak", "default": "SIWAK OPTIZ" },
    { "type": "text", "id": "siwak_subheading", "label": "Sous-titre Siwak", "default": "UN GESTE AU QUOTIDIEN" },
    { "type": "image_picker", "id": "siwak_image", "label": "Image Siwak Optiz", "info": "Le bâton détouré enregistré dans les fichiers de la boutique est utilisé si aucune image n’est sélectionnée." },
    { "type": "text", "id": "siwak_image_alt", "label": "Description de l’image Siwak", "default": "Bâton de siwak Optiz et ses fibres préparées" },
    { "type": "header", "content": "Bandes blanchissantes" },
    { "type": "text", "id": "strips_heading", "label": "Titre du panneau bandes", "default": "BANDES BLANCHISSANTES" },
    { "type": "text", "id": "strips_subheading", "label": "Sous-titre bandes", "default": "UN TEMPS DE POSE" },
    { "type": "image_picker", "id": "strips_image", "label": "Image bandes blanchissantes", "info": "Photo verticale détourée. Le visuel violet DR DENT est utilisé si aucune image n’est sélectionnée." },
    { "type": "text", "id": "strips_image_alt", "label": "Description de l’image bandes", "default": "Bandes blanchissantes violettes DR DENT" },
    { "type": "header", "content": "Action" },
    { "type": "text", "id": "button_label", "label": "Bouton vers l’offre", "default": "CHOISIR MON SIWAK" },
    { "type": "text", "id": "note", "label": "Note facultative" }
  ],
  "blocks": [
    {
      "type": "criterion",
      "name": "Critère",
      "settings": [
        { "type": "text", "id": "criterion", "label": "Critère", "default": "Geste" },
        { "type": "textarea", "id": "siwak", "label": "Siwak", "default": "Des fibres végétales à préparer" },
        { "type": "textarea", "id": "strips", "label": "Bandes", "default": "Des bandes à placer sur les dents" }
      ]
    }
  ],
  "presets": [
    { "name": "Siwak — comparaison", "blocks": [
      { "type": "criterion", "settings": { "criterion": "Geste", "siwak": "Des fibres végétales à préparer", "strips": "Des bandes à placer sur les dents" } },
      { "type": "criterion", "settings": { "criterion": "Temps d’usage", "siwak": "5 min par jour dans ta routine", "strips": "Un temps de pose à respecter" } },
      { "type": "criterion", "settings": { "criterion": "Routine", "siwak": "Un bâtonnet à emporter", "strips": "Un protocole selon la formule" } }
    ] }
  ]
}
{% endschema %}
