<section class="optiz-mission optiz-mission--{{ section.id }}">
  <div class="optiz-mission__inner page-width">
    <div class="optiz-mission__media">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 1200 | image_tag:
          widths: '480, 720, 960, 1200',
          sizes: '(min-width: 750px) 46vw, 100vw',
          loading: 'lazy',
          class: 'optiz-mission__image'
        }}
      {% else %}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'optiz-mission__image optiz-mission__placeholder' }}
      {% endif %}
      <span class="optiz-mission__caption">{{ section.settings.caption | escape }}</span>
    </div>

    <div class="optiz-mission__copy">
      <p class="optiz-mission__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h2>{{ section.settings.heading | escape }}</h2>
      <div class="optiz-mission__text rte">{{ section.settings.text }}</div>
      {% if section.settings.button_label != blank and section.settings.button_link != blank %}
        <a class="optiz-mission__link" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }} <span aria-hidden="true">→</span></a>
      {% endif %}
    </div>
  </div>
</section>

{% style %}
  .optiz-mission--{{ section.id }} {
    --optiz-red: #e52219;
    --optiz-ink: #212121;
    --optiz-paper: #f4f0e8;
    padding: clamp(66px, 8vw, 112px) 0;
    background: var(--optiz-paper);
    color: var(--optiz-ink);
  }
  .optiz-mission--{{ section.id }} .optiz-mission__inner {
    padding-inline: clamp(20px, 4vw, 64px);
  }
  .optiz-mission--{{ section.id }} .optiz-mission__inner {
    display: grid;
    grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr);
    gap: clamp(38px, 7vw, 104px);
    align-items: center;
  }
  .optiz-mission--{{ section.id }} .optiz-mission__media {
    position: relative;
    min-height: 560px;
    border: 2px solid var(--optiz-ink);
    background: #d7d0c5;
    box-shadow: 11px 11px 0 var(--optiz-red);
  }
  .optiz-mission--{{ section.id }} .optiz-mission__image {
    width: 100%;
    height: 100%;
    min-height: 560px;
    display: block;
    object-fit: cover;
  }
  .optiz-mission--{{ section.id }} .optiz-mission__placeholder { fill: #777; }
  .optiz-mission--{{ section.id }} .optiz-mission__caption {
    position: absolute;
    right: -12px;
    bottom: 18px;
    max-width: calc(100% - 20px);
    padding: 10px 14px;
    border: 2px solid var(--optiz-ink);
    background: #fff;
    color: var(--optiz-ink);
    font-family: var(--font-subheading--family);
    font-weight: 700;
    text-transform: uppercase;
    transform: rotate(-1deg);
  }
  .optiz-mission--{{ section.id }} .optiz-mission__eyebrow {
    margin: 0 0 10px;
    color: var(--optiz-red);
    font-family: var(--font-subheading--family);
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .optiz-mission--{{ section.id }} h2 {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(3.2rem, 6vw, 6.5rem);
    line-height: .88;
    text-transform: uppercase;
  }
  .optiz-mission--{{ section.id }} .optiz-mission__text {
    margin-top: 26px;
    max-width: 62ch;
    font-size: clamp(1.03rem, 1.4vw, 1.18rem);
    line-height: 1.65;
  }
  .optiz-mission--{{ section.id }} .optiz-mission__text p { margin: 0 0 16px; }
  .optiz-mission--{{ section.id }} .optiz-mission__link {
    display: inline-flex;
    gap: 12px;
    align-items: center;
    margin-top: 12px;
    padding-bottom: 5px;
    border-bottom: 3px solid var(--optiz-red);
    color: inherit;
    font-family: var(--font-accent--family);
    font-weight: 700;
    text-transform: uppercase;
    text-decoration: none;
  }
  .optiz-mission--{{ section.id }} .optiz-mission__link:focus-visible { outline: 3px solid var(--optiz-red); outline-offset: 5px; }
  @media (max-width: 749px) {
    .optiz-mission--{{ section.id }} .optiz-mission__inner { grid-template-columns: 1fr; }
    .optiz-mission--{{ section.id }} .optiz-mission__media,
    .optiz-mission--{{ section.id }} .optiz-mission__image { min-height: 420px; }
  }
{% endstyle %}

{% schema %}
{
  "name": "Optiz — Notre mission",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Photo d’Hakim" },
    { "type": "text", "id": "caption", "label": "Légende photo", "default": "Hakim — à l’origine d’Optiz" },
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Notre mission" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Il était temps de proposer une alternative." },
    { "type": "richtext", "id": "text", "label": "Histoire", "default": "<p>En regardant de plus près les produits qui remplissent notre quotidien, Hakim a découvert à quel point le plastique, les fibres synthétiques et certaines substances controversées étaient devenus difficiles à éviter.</p><p>Il a créé Optiz avec une idée simple : proposer des alternatives concrètes, zone par zone, sans transformer ta routine en parcours du combattant.</p>" },
    { "type": "text", "id": "button_label", "label": "Lien — libellé", "default": "Découvrir l’histoire d’Optiz" },
    { "type": "url", "id": "button_link", "label": "Lien — destination" }
  ],
  "presets": [{ "name": "Optiz — Notre mission" }]
}
{% endschema %}
