{% comment %}
  Section: Short Video (<= 25 chars)
  - YouTube embed from any of these:
    https://www.youtube.com/shorts/VIDEO_ID
    https://www.youtube.com/watch?v=VIDEO_ID
    https://youtu.be/VIDEO_ID
    https://www.youtube.com/embed/VIDEO_ID
{% endcomment %}

<section class="sv-section sv-section--{{ section.id }}">
  <div class="sv-inner page-width">
    {% if section.settings.heading != blank %}
      <h2 class="sv-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.text != blank %}
      <div class="sv-text rte">{{ section.settings.text }}</div>
    {% endif %}

    {% assign raw = section.settings.youtube_url | strip %}

    {% if raw != blank %}
      {% comment %} Extract YouTube video id safely {% endcomment %}
      {% assign id = '' %}

      {% if raw contains 'youtube.com/shorts/' %}
        {% assign id = raw | split: 'youtube.com/shorts/' | last | split: '?' | first | split: '&' | first | split: '/' | first %}
      {% elsif raw contains 'youtu.be/' %}
        {% assign id = raw | split: 'youtu.be/' | last | split: '?' | first | split: '&' | first | split: '/' | first %}
      {% elsif raw contains 'youtube.com/watch' and raw contains 'v=' %}
        {% assign id = raw | split: 'v=' | last | split: '&' | first | split: '?' | first | split: '/' | first %}
      {% elsif raw contains 'youtube.com/embed/' %}
        {% assign id = raw | split: 'youtube.com/embed/' | last | split: '?' | first | split: '&' | first | split: '/' | first %}
      {% endif %}

      {% if id != blank %}
        <div class="sv-video-wrap" aria-label="YouTube video">
          <div class="sv-video">
            <iframe
              class="sv-iframe"
              src="https://www.youtube.com/embed/{{ id }}?playsinline=1&rel=0&modestbranding=1"
              title="{{ section.settings.heading | escape }}"
              frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen>
            </iframe>
          </div>
        </div>
      {% else %}
        <div class="sv-error">
          Lien YouTube non reconnu. Utilise un lien de type youtube.com/shorts/… ou youtu.be/…
        </div>
      {% endif %}
    {% endif %}
  </div>
</section>

<style>
  .sv-section--{{ section.id }}{
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
    text-align: center;
  }

  .sv-section--{{ section.id }} .sv-inner{
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }

  .sv-section--{{ section.id }} .sv-heading{
    margin: 0;
  }

  .sv-section--{{ section.id }} .sv-text{
    margin: 0;
    max-width: 720px;
  }

  /* Centered video container */
  .sv-section--{{ section.id }} .sv-video-wrap{
    width: 100%;
    display: flex;
    justify-content: center;
  }

  /* Fixed width (editable) + 9:16 aspect ratio */
  .sv-section--{{ section.id }} .sv-video{
    width: {{ section.settings.width_desktop }}px;
    max-width: 100%;
    aspect-ratio: 9 / 16;
    border-radius: {{ section.settings.radius }}px;
    overflow: hidden;
    background: rgba(0,0,0,0.04);
  }

  .sv-section--{{ section.id }} .sv-iframe{
    width: 100%;
    height: 100%;
    display: block;
    border: 0;
  }

  .sv-section--{{ section.id }} .sv-error{
    max-width: 720px;
    padding: 12px 14px;
    border-radius: 10px;
    background: rgba(255, 0, 0, 0.06);
  }

  @media screen and (max-width: 768px){
    .sv-section--{{ section.id }} .sv-video{
      width: {{ section.settings.width_mobile }}px;
    }
  }
</style>

{% schema %}
{
  "name": "Short Video",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Regardez la vidéo"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texte",
      "default": "<p>Ajoutez un lien YouTube Short et la vidéo s’affiche ici.</p>"
    },
    {
      "type": "text",
      "id": "youtube_url",
      "label": "Lien YouTube (Short / Watch / youtu.be / embed)",
      "default": "https://www.youtube.com/shorts/VIDEO_ID"
    },
    {
      "type": "range",
      "id": "width_desktop",
      "label": "Largeur desktop (px)",
      "min": 220,
      "max": 720,
      "step": 10,
      "default": 360
    },
    {
      "type": "range",
      "id": "width_mobile",
      "label": "Largeur mobile (px)",
      "min": 180,
      "max": 460,
      "step": 10,
      "default": 280
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Arrondi (px)",
      "min": 0,
      "max": 28,
      "step": 2,
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding haut (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bas (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Short Video"
    }
  ]
}
{% endschema %}
