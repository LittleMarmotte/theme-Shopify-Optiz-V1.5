{% liquid
  assign products_link = section.settings.all_products_link | default: routes.all_products_collection_url
%}

<section id="OptizZones-{{ section.id }}" class="optiz-zones optiz-zones--{{ section.id }}" data-optiz-zones>
  <div class="optiz-zones__inner page-width">
    <header class="optiz-zones__header">
      <div class="optiz-zones__heading">
        {% if section.settings.eyebrow != blank %}
          <p class="optiz-zones__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}
        <h2>{{ section.settings.heading | escape }}</h2>
      </div>

      <a class="optiz-zones__all-link" href="{{ products_link }}">
        {{ section.settings.all_products_label | escape }}
        <span aria-hidden="true">→</span>
      </a>
    </header>

    {% if section.settings.text != blank %}
      <div class="optiz-zones__intro rte">{{ section.settings.text }}</div>
    {% endif %}

    <div class="optiz-zones__filters" aria-label="Filtrer les produits par zone du corps">
      <button class="optiz-zones__filter is-active" type="button" data-zone-filter="all" aria-pressed="true">
        Tous les produits
      </button>
      <button class="optiz-zones__filter" type="button" data-zone-filter="mouth" aria-pressed="false">
        Bouche & mâchoire
      </button>
      <button class="optiz-zones__filter" type="button" data-zone-filter="hair" aria-pressed="false">
        Cheveux
      </button>
      <button class="optiz-zones__filter" type="button" data-zone-filter="body" aria-pressed="false">
        Peau & corps
      </button>
      <button class="optiz-zones__filter" type="button" data-zone-filter="underwear" aria-pressed="false">
        Sous-vêtements
      </button>
    </div>

    <p class="visually-hidden" aria-live="polite" data-zone-status></p>

    <div class="optiz-zones__products" data-zone-products>
      {% for block in section.blocks %}
        {% liquid
          assign product = block.settings.product
          assign variant = product.selected_or_first_available_variant
        %}

        {% if product != blank %}
          <article
            class="optiz-zones__product"
            data-zone-card="{{ block.settings.zone }}{% if block.settings.secondary_zone != 'none' %} {{ block.settings.secondary_zone }}{% endif %}"
            {{ block.shopify_attributes }}
          >
            <a class="optiz-zones__product-media" href="{{ product.url }}" aria-label="Voir {{ product.title | escape }}">
              {% if product.featured_image != blank %}
                {{ product.featured_image | image_url: width: 900 | image_tag:
                  widths: '320, 480, 640, 900',
                  sizes: '(min-width: 990px) 25vw, 78vw',
                  loading: 'lazy',
                  alt: product.featured_image.alt | default: product.title,
                  class: 'optiz-zones__product-image'
                }}
              {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'optiz-zones__product-image optiz-zones__placeholder' }}
              {% endif %}

              <span class="optiz-zones__product-zone">
                {% case block.settings.zone %}
                  {% when 'mouth' %}Bouche & mâchoire
                  {% when 'hair' %}Cheveux
                  {% when 'body' %}Peau & corps
                  {% when 'underwear' %}Sous-vêtements
                {% endcase %}
              </span>

              {% unless product.available %}
                <span class="optiz-zones__sold-out">Épuisé</span>
              {% endunless %}
            </a>

            <div class="optiz-zones__product-info">
              <div class="optiz-zones__product-topline">
                <h3><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
                <span class="optiz-zones__index" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              </div>

              {% if block.settings.note != blank %}
                <p class="optiz-zones__product-note">{{ block.settings.note | escape }}</p>
              {% endif %}

              <div class="optiz-zones__price">
                <span>{{ product.price | money }}</span>
                {% if product.compare_at_price > product.price %}
                  <s>{{ product.compare_at_price | money }}</s>
                {% endif %}
              </div>

              {% if product.available and product.has_only_default_variant %}
                {% form 'product', product, class: 'optiz-zones__product-form' %}
                  <input type="hidden" name="id" value="{{ variant.id }}">
                  <input type="hidden" name="quantity" value="1">
                  <button class="optiz-zones__product-action" type="submit">
                    Ajouter au panier <span aria-hidden="true">→</span>
                  </button>
                {% endform %}
              {% elsif product.available %}
                <a class="optiz-zones__product-action" href="{{ product.url }}">
                  Choisir mon format <span aria-hidden="true">→</span>
                </a>
              {% else %}
                <a class="optiz-zones__product-action optiz-zones__product-action--outline" href="{{ product.url }}">
                  Voir le produit <span aria-hidden="true">→</span>
                </a>
              {% endif %}
            </div>
          </article>
        {% elsif request.design_mode %}
          <article class="optiz-zones__product" data-zone-card="{{ block.settings.zone }}{% if block.settings.secondary_zone != 'none' %} {{ block.settings.secondary_zone }}{% endif %}" {{ block.shopify_attributes }}>
            <div class="optiz-zones__product-media">
              {{ 'product-1' | placeholder_svg_tag: 'optiz-zones__product-image optiz-zones__placeholder' }}
            </div>
            <div class="optiz-zones__product-info">
              <h3>Choisis un produit</h3>
              <p class="optiz-zones__product-note">Configure ce bloc dans l’éditeur de thème.</p>
            </div>
          </article>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<script>
  (() => {
    const root = document.getElementById('OptizZones-{{ section.id }}');
    if (!root || root.dataset.filtersReady === 'true') return;
    root.dataset.filtersReady = 'true';

    const buttons = [...root.querySelectorAll('[data-zone-filter]')];
    const cards = [...root.querySelectorAll('[data-zone-card]')];
    const status = root.querySelector('[data-zone-status]');

    buttons.forEach((button) => {
      const filter = button.dataset.zoneFilter;
      if (filter !== 'all' && !cards.some((card) => card.dataset.zoneCard.split(' ').includes(filter))) {
        button.hidden = true;
      }

      button.addEventListener('click', () => {
        buttons.forEach((item) => {
          const selected = item === button;
          item.classList.toggle('is-active', selected);
          item.setAttribute('aria-pressed', selected ? 'true' : 'false');
        });

        let visibleCount = 0;
        cards.forEach((card) => {
          const visible = filter === 'all' || card.dataset.zoneCard.split(' ').includes(filter);
          card.hidden = !visible;
          if (visible) visibleCount += 1;
        });

        if (status) status.textContent = `${visibleCount} produit${visibleCount > 1 ? 's' : ''} affiché${visibleCount > 1 ? 's' : ''}.`;
      });
    });
  })();
</script>

{% style %}
  .optiz-zones--{{ section.id }} {
    --optiz-red: #e52219;
    --optiz-ink: #212121;
    --optiz-paper: #f4f0e8;
    padding: clamp(64px, 8vw, 108px) 0;
    background: var(--optiz-paper);
    color: var(--optiz-ink);
    overflow: hidden;
  }

  .optiz-zones--{{ section.id }} .optiz-zones__inner {
    padding-inline: clamp(20px, 4vw, 64px);
  }

  .optiz-zones--{{ section.id }} .optiz-zones__header {
    display: flex;
    justify-content: space-between;
    gap: 30px;
    align-items: end;
  }

  .optiz-zones--{{ section.id }} .optiz-zones__eyebrow {
    margin: 0 0 8px;
    color: var(--optiz-red);
    font-family: var(--font-subheading--family);
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .optiz-zones--{{ section.id }} h2 {
    margin: 0;
    max-width: 900px;
    font-family: var(--font-heading--family);
    font-size: clamp(3.2rem, 6vw, 6.5rem);
    line-height: .88;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .optiz-zones--{{ section.id }} .optiz-zones__all-link {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding-bottom: 5px;
    border-bottom: 3px solid var(--optiz-red);
    color: inherit;
    font-family: var(--font-accent--family);
    font-weight: 700;
    text-transform: uppercase;
    text-decoration: none;
  }

  .optiz-zones--{{ section.id }} .optiz-zones__all-link:focus-visible,
  .optiz-zones--{{ section.id }} .optiz-zones__product a:focus-visible,
  .optiz-zones--{{ section.id }} .optiz-zones__product button:focus-visible {
    outline: 3px solid var(--optiz-red);
    outline-offset: 4px;
  }

  .optiz-zones--{{ section.id }} .optiz-zones__intro {
    max-width: 650px;
    margin-top: 22px;
    font-size: 1.06rem;
    line-height: 1.55;
  }

  .optiz-zones--{{ section.id }} .optiz-zones__intro p { margin: 0; }

  .optiz-zones--{{ section.id }} .optiz-zones__filters {
    display: flex;
    gap: 10px;
    margin-top: 34px;
    padding: 0 0 14px;
    overflow-x: auto;
    scrollbar-width: thin;
  }

  .optiz-zones--{{ section.id }} .optiz-zones__filter {
    flex: 0 0 auto;
    min-height: 46px;
    padding: 10px 18px;
    border: 2px solid var(--optiz-ink);
    border-radius: 0;
    background: transparent;
    color: var(--optiz-ink);
    font-family: var(--font-accent--family);
    font-size: .95rem;
    font-weight: 700;
    letter-spacing: .03em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .optiz-zones--{{ section.id }} .optiz-zones__filter:hover,
  .optiz-zones--{{ section.id }} .optiz-zones__filter.is-active {
    background: var(--optiz-ink);
    color: #fff;
    box-shadow: 4px 4px 0 var(--optiz-red);
  }

  .optiz-zones--{{ section.id }} .optiz-zones__filter:focus-visible {
    outline: 3px solid var(--optiz-red);
    outline-offset: 3px;
  }

  .optiz-zones--{{ section.id }} .optiz-zones__products {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(16px, 2.2vw, 28px);
    margin-top: 26px;
  }

  .optiz-zones--{{ section.id }} .optiz-zones__product {
    min-width: 0;
    display: flex;
    flex-direction: column;
    border: 2px solid var(--optiz-ink);
    background: #fff;
    box-shadow: 7px 7px 0 var(--optiz-red);
  }

  .optiz-zones--{{ section.id }} .optiz-zones__product[hidden] { display: none; }

  .optiz-zones--{{ section.id }} .optiz-zones__product-media {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1.04;
    overflow: hidden;
    border-bottom: 2px solid var(--optiz-ink);
    background: #e8e2d8;
  }

  .optiz-zones--{{ section.id }} .optiz-zones__product-image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform .24s ease;
  }

  .optiz-zones--{{ section.id }} .optiz-zones__product:hover .optiz-zones__product-image {
    transform: scale(1.025);
  }

  .optiz-zones--{{ section.id }} .optiz-zones__placeholder { fill: #777; }

  .optiz-zones--{{ section.id }} .optiz-zones__product-zone,
  .optiz-zones--{{ section.id }} .optiz-zones__sold-out {
    position: absolute;
    z-index: 1;
    padding: 7px 9px;
    border: 2px solid var(--optiz-ink);
    font-family: var(--font-subheading--family);
    font-size: .75rem;
    font-weight: 700;
    letter-spacing: .06em;
    line-height: 1;
    text-transform: uppercase;
  }

  .optiz-zones--{{ section.id }} .optiz-zones__product-zone {
    left: 10px;
    bottom: 10px;
    background: var(--optiz-paper);
    color: var(--optiz-ink);
  }

  .optiz-zones--{{ section.id }} .optiz-zones__sold-out {
    top: 10px;
    right: 10px;
    background: var(--optiz-red);
    color: #fff;
  }

  .optiz-zones--{{ section.id }} .optiz-zones__product-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 18px;
  }

  .optiz-zones--{{ section.id }} .optiz-zones__product-topline {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 10px;
    align-items: start;
  }

  .optiz-zones--{{ section.id }} .optiz-zones__product h3 {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(1.5rem, 2.2vw, 2.1rem);
    line-height: 1;
    text-transform: uppercase;
  }

  .optiz-zones--{{ section.id }} .optiz-zones__product h3 a {
    color: inherit;
    text-decoration: none;
  }

  .optiz-zones--{{ section.id }} .optiz-zones__index {
    color: var(--optiz-red);
    font-family: var(--font-heading--family);
    font-size: 1.25rem;
    font-weight: 700;
  }

  .optiz-zones--{{ section.id }} .optiz-zones__product-note {
    margin: 10px 0 0;
    color: rgba(33, 33, 33, .66);
    font-size: .9rem;
    line-height: 1.35;
  }

  .optiz-zones--{{ section.id }} .optiz-zones__price {
    display: flex;
    gap: 10px;
    align-items: baseline;
    margin-top: 18px;
    font-family: var(--font-heading--family);
    font-size: 1.55rem;
    font-weight: 700;
  }

  .optiz-zones--{{ section.id }} .optiz-zones__price s {
    color: rgba(33, 33, 33, .55);
    font-size: 1rem;
  }

  .optiz-zones--{{ section.id }} .optiz-zones__product-form { margin-top: auto; }

  .optiz-zones--{{ section.id }} .optiz-zones__product-action {
    width: 100%;
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 20px;
    padding: 12px 15px;
    border: 2px solid var(--optiz-ink);
    border-radius: 0;
    background: var(--optiz-red);
    color: #fff;
    font-family: var(--font-accent--family);
    font-size: .9rem;
    font-weight: 700;
    letter-spacing: .02em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
  }

  .optiz-zones--{{ section.id }} .optiz-zones__product-action:hover {
    background: var(--optiz-ink);
  }

  .optiz-zones--{{ section.id }} .optiz-zones__product-action--outline {
    background: transparent;
    color: var(--optiz-ink);
  }

  @media (max-width: 989px) {
    .optiz-zones--{{ section.id }} .optiz-zones__products {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 749px) {
    .optiz-zones--{{ section.id }} .optiz-zones__header {
      display: grid;
      align-items: start;
    }

    .optiz-zones--{{ section.id }} .optiz-zones__all-link { width: fit-content; }

    .optiz-zones--{{ section.id }} .optiz-zones__filters {
      margin-inline-end: -20px;
      padding-inline-end: 20px;
    }

    .optiz-zones--{{ section.id }} .optiz-zones__products {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: min(82vw, 340px);
      gap: 18px;
      margin-inline-end: -20px;
      padding: 0 20px 12px 0;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: thin;
    }

    .optiz-zones--{{ section.id }} .optiz-zones__product { scroll-snap-align: start; }
    .optiz-zones--{{ section.id }} .optiz-zones__product h3 { font-size: 1.85rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .optiz-zones--{{ section.id }} .optiz-zones__product-image { transition: none; }
  }
{% endstyle %}

{% schema %}
{
  "name": "Optiz — Produits par zone",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Choisis ta zone" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Remplace ta routine, produit par produit." },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Filtre la sélection selon la zone que tu veux repenser en premier.</p>" },
    { "type": "text", "id": "all_products_label", "label": "Lien — libellé", "default": "Voir tous les produits" },
    { "type": "url", "id": "all_products_link", "label": "Lien — destination" }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Produit",
      "settings": [
        { "type": "product", "id": "product", "label": "Produit" },
        {
          "type": "select",
          "id": "zone",
          "label": "Zone du corps",
          "default": "mouth",
          "options": [
            { "value": "mouth", "label": "Bouche et mâchoire" },
            { "value": "hair", "label": "Cheveux" },
            { "value": "body", "label": "Peau et corps" },
            { "value": "underwear", "label": "Sous-vêtements" }
          ]
        },
        {
          "type": "select",
          "id": "secondary_zone",
          "label": "Deuxième zone (optionnelle)",
          "default": "none",
          "options": [
            { "value": "none", "label": "Aucune" },
            { "value": "mouth", "label": "Bouche et mâchoire" },
            { "value": "hair", "label": "Cheveux" },
            { "value": "body", "label": "Peau et corps" },
            { "value": "underwear", "label": "Sous-vêtements" }
          ]
        },
        { "type": "text", "id": "note", "label": "Précision courte (optionnelle)" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Optiz — Produits par zone",
      "blocks": [
        { "type": "product", "settings": { "zone": "mouth" } },
        { "type": "product", "settings": { "zone": "mouth" } },
        { "type": "product", "settings": { "zone": "hair" } },
        { "type": "product", "settings": { "zone": "body" } }
      ]
    }
  ]
}
{% endschema %}
