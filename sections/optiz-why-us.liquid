<section class="optiz-why optiz-why--{{ section.id }}">
  <div class="optiz-why__inner page-width">
    <header class="optiz-why__header">
      <p>{{ section.settings.eyebrow | escape }}</p>
      <h2>{{ section.settings.heading | escape }}</h2>
    </header>

    <div class="optiz-why__reasons" role="list">
      {% for block in section.blocks %}
        <div class="optiz-why__reason" role="listitem" {{ block.shopify_attributes }}>
          <span aria-hidden="true">{{ block.settings.symbol | escape }}</span>
          <strong>{{ block.settings.heading | escape }}</strong>
          {% if block.settings.text != blank %}<p>{{ block.settings.text | escape }}</p>{% endif %}
        </div>
      {% endfor %}
    </div>

    {% liquid
      assign final_link = section.settings.button_link | default: routes.all_products_collection_url
    %}
    <div class="optiz-why__action">
      <p>{{ section.settings.action_text | escape }}</p>
      <a href="{{ final_link }}">{{ section.settings.button_label | escape }}</a>
    </div>
  </div>
</section>

{% style %}
  .optiz-why--{{ section.id }} {
    --optiz-red: #e52219;
    --optiz-ink: #212121;
    --optiz-paper: #f4f0e8;
    padding: clamp(66px, 8vw, 110px) 0;
    background: var(--optiz-ink);
    color: #fff;
  }
  .optiz-why--{{ section.id }} .optiz-why__inner {
    padding-inline: clamp(20px, 4vw, 64px);
  }
  .optiz-why--{{ section.id }} .optiz-why__header {
    display: grid;
    grid-template-columns: 210px minmax(0, 1fr);
    gap: 24px;
    align-items: start;
    padding-bottom: 32px;
    border-bottom: 2px solid #fff;
  }
  .optiz-why--{{ section.id }} .optiz-why__header p {
    margin: 8px 0 0;
    color: var(--optiz-red);
    font-family: var(--font-subheading--family);
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .optiz-why--{{ section.id }} h2 {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(3.2rem, 6vw, 6.5rem);
    line-height: .88;
    text-transform: uppercase;
  }
  .optiz-why--{{ section.id }} .optiz-why__reasons {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-left: 1px solid rgba(255,255,255,.35);
  }
  .optiz-why--{{ section.id }} .optiz-why__reason {
    min-height: 210px;
    padding: clamp(24px, 3vw, 40px);
    border-right: 1px solid rgba(255,255,255,.35);
    border-bottom: 1px solid rgba(255,255,255,.35);
  }
  .optiz-why--{{ section.id }} .optiz-why__reason > span {
    display: block;
    margin-bottom: 30px;
    color: var(--optiz-red);
    font-family: var(--font-heading--family);
    font-size: 2.6rem;
    line-height: 1;
  }
  .optiz-why--{{ section.id }} .optiz-why__reason strong {
    display: block;
    font-family: var(--font-heading--family);
    font-size: clamp(1.7rem, 2.4vw, 2.4rem);
    line-height: 1;
    text-transform: uppercase;
  }
  .optiz-why--{{ section.id }} .optiz-why__reason p {
    margin: 12px 0 0;
    color: rgba(255,255,255,.7);
    line-height: 1.45;
  }
  .optiz-why--{{ section.id }} .optiz-why__action {
    display: flex;
    justify-content: space-between;
    gap: 28px;
    align-items: center;
    margin-top: 42px;
    padding: 22px;
    border: 2px solid #fff;
    background: var(--optiz-red);
    box-shadow: 8px 8px 0 #fff;
  }
  .optiz-why--{{ section.id }} .optiz-why__action p {
    margin: 0;
    max-width: 560px;
    font-family: var(--font-heading--family);
    font-size: clamp(1.6rem, 3vw, 2.8rem);
    line-height: 1;
    text-transform: uppercase;
  }
  .optiz-why--{{ section.id }} .optiz-why__action a {
    flex: 0 0 auto;
    display: inline-flex;
    min-height: 52px;
    align-items: center;
    justify-content: center;
    padding: 13px 20px;
    border: 2px solid var(--optiz-ink);
    background: var(--optiz-ink);
    color: #fff;
    font-family: var(--font-accent--family);
    font-weight: 700;
    text-transform: uppercase;
    text-decoration: none;
  }
  .optiz-why--{{ section.id }} .optiz-why__action a:focus-visible { outline: 3px solid #fff; outline-offset: 4px; }
  @media (max-width: 749px) {
    .optiz-why--{{ section.id }} .optiz-why__header { grid-template-columns: 1fr; gap: 8px; }
    .optiz-why--{{ section.id }} .optiz-why__reasons { grid-template-columns: 1fr; }
    .optiz-why--{{ section.id }} .optiz-why__reason { min-height: 0; }
    .optiz-why--{{ section.id }} .optiz-why__action { align-items: stretch; flex-direction: column; }
    .optiz-why--{{ section.id }} .optiz-why__action a { width: 100%; }
  }
{% endstyle %}

{% schema %}
{
  "name": "Optiz — Pourquoi nous",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Pourquoi choisir Optiz" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Des produits physiques. Une équipe accessible." },
    { "type": "text", "id": "action_text", "label": "Texte final", "default": "Prêt à reprendre le contrôle de ta routine ?" },
    { "type": "text", "id": "button_label", "label": "Libellé du bouton", "default": "Remplacer ma routine avec Optiz" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton" }
  ],
  "blocks": [
    {
      "type": "reason",
      "name": "Argument",
      "settings": [
        { "type": "text", "id": "symbol", "label": "Symbole court", "default": "FR" },
        { "type": "text", "id": "heading", "label": "Titre", "default": "Créé en France" },
        { "type": "text", "id": "text", "label": "Précision", "default": "Une marque française, proche de ses produits et de sa communauté." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Optiz — Pourquoi nous",
      "blocks": [
        { "type": "reason", "settings": { "symbol": "FR", "heading": "Créé en France", "text": "Une marque française, proche de ses produits et de sa communauté." } },
        { "type": "reason", "settings": { "symbol": "↗", "heading": "Livraison internationale", "text": "Optiz expédie ses produits dans les pays desservis par la boutique." } },
        { "type": "reason", "settings": { "symbol": "24/7", "heading": "Service client", "text": "Une équipe disponible pour répondre à tes questions." } },
        { "type": "reason", "settings": { "symbol": "✓", "heading": "Sélection exigeante", "text": "Des produits choisis pour remplacer une habitude précise." } },
        { "type": "reason", "settings": { "symbol": "🔒", "heading": "Paiement sécurisé", "text": "Tes paiements passent par l’infrastructure sécurisée de la boutique." } },
        { "type": "reason", "settings": { "symbol": "↩", "heading": "Retours clairs", "text": "Les conditions applicables sont accessibles avant ta commande." } }
      ]
    }
  ]
}
{% endschema %}
