<section class="siwak-customer-marquee" aria-label="Clients Optiz avec leur boîte de siwaks">
  <div class="siwak-customer-marquee__track">
    {% for repeat in (1..2) %}
      <div class="siwak-customer-marquee__group" {% if repeat == 2 %}aria-hidden="true"{% endif %}>
        {% for block in section.blocks %}
          <figure class="siwak-customer-marquee__photo" {% if repeat == 1 %}{{ block.shopify_attributes }}{% endif %}>
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 700 | image_tag: widths: '240, 360, 520, 700', sizes: '220px', loading: 'lazy', alt: block.settings.image.alt | default: block.settings.alt }}
            {% else %}
              <div class="siwak-customer-marquee__placeholder" aria-hidden="true">
                <svg viewBox="0 0 64 64" focusable="false">
                  <circle cx="32" cy="23" r="10" fill="currentColor" opacity=".28"/>
                  <path d="M14 57c1-13 8-21 18-21s17 8 18 21" fill="currentColor" opacity=".28"/>
                  <rect x="37" y="30" width="14" height="23" rx="1" fill="currentColor"/>
                  <path d="M40 35h8M40 39h8M40 43h5" stroke="#f5f1e9" stroke-width="1.5"/>
                </svg>
                <span>PHOTO CLIENT</span>
              </div>
            {% endif %}
          </figure>
        {% endfor %}
      </div>
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .siwak-customer-marquee { overflow: hidden; padding: clamp(28px, 4vw, 52px) 0; background: #fff; }
  .siwak-customer-marquee__track { display: flex; width: max-content; animation: siwak-customer-scroll 34s linear infinite; will-change: transform; }
  .siwak-customer-marquee__group { display: flex; gap: clamp(14px, 1.8vw, 26px); padding-right: clamp(14px, 1.8vw, 26px); }
  .siwak-customer-marquee__photo { width: clamp(190px, 20vw, 310px); aspect-ratio: 1; flex: 0 0 auto; margin: 0; overflow: hidden; border-radius: clamp(14px, 1.8vw, 26px); background: #f5f1e9; }
  .siwak-customer-marquee__photo img { width: 100%; height: 100%; display: block; object-fit: cover; }
  .siwak-customer-marquee__placeholder { width: 100%; height: 100%; display: grid; place-items: center; align-content: center; gap: 14px; background: #f5f1e9; color: #e52219; }
  .siwak-customer-marquee__placeholder svg { width: 42%; max-width: 112px; }
  .siwak-customer-marquee__placeholder span { color: #171717; font-size: .72rem; font-weight: 800; letter-spacing: .12em; }
  .siwak-customer-marquee:hover .siwak-customer-marquee__track, .siwak-customer-marquee:focus-within .siwak-customer-marquee__track { animation-play-state: paused; }
  @keyframes siwak-customer-scroll { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) {
    .siwak-customer-marquee { overflow-x: auto; }
    .siwak-customer-marquee__track { animation: none; }
    .siwak-customer-marquee__group[aria-hidden='true'] { display: none; }
  }
  @media (max-width: 749px) {
    .siwak-customer-marquee__photo { width: 46vw; max-width: 210px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Siwak — photos clients",
  "max_blocks": 12,
  "blocks": [
    {
      "type": "photo",
      "name": "Photo client",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo carrée" },
        { "type": "text", "id": "alt", "label": "Texte alternatif", "default": "Client Optiz tenant une boîte de siwaks" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Siwak — photos clients",
      "blocks": [
        { "type": "photo" }, { "type": "photo" }, { "type": "photo" },
        { "type": "photo" }, { "type": "photo" }, { "type": "photo" }
      ]
    }
  ]
}
{% endschema %}
