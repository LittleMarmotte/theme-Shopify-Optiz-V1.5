<section class="siwak-faq" aria-labelledby="SiwakFaqTitle-{{ section.id }}">
  <div class="siwak-faq__inner">
    <h2 id="SiwakFaqTitle-{{ section.id }}" class="siwak-faq__title">{{ section.settings.heading | escape }}</h2>
    <div class="siwak-faq__items">
      {% for block in section.blocks limit: 7 %}
        <details class="siwak-faq__item" name="SiwakFaq-{{ section.id }}" {{ block.shopify_attributes }}>
          <summary class="siwak-faq__question">
            <span>{{ block.settings.question | escape }}</span>
            <span class="siwak-faq__toggle" aria-hidden="true"></span>
          </summary>
          <div class="siwak-faq__answer rte">{{ block.settings.answer }}</div>
        </details>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
.siwak-faq { background: #fdf3f1; color: #171717; padding: clamp(32px, 4vw, 56px) 24px; }
.siwak-faq__inner { width: min(100%, 920px); margin-inline: auto; }
.siwak-faq__title { margin: 0 0 24px; font-family: 'Barlow Condensed', var(--font-heading-family), sans-serif; font-size: clamp(34px, 4.5vw, 52px); font-weight: 700; line-height: 1.05; letter-spacing: 0; text-transform: uppercase; text-align: center; text-wrap: balance; }
.siwak-faq__items { display: grid; gap: 10px; }
.siwak-faq__item { min-width: 0; border: 2px solid #eadbd6; border-radius: 44px; background: #fff; transition: border-color 160ms; }
.siwak-faq__item[open] { border-color: #e52219; border-radius: 30px; }
.siwak-faq__question { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 68px; padding: 14px 18px 14px 24px; list-style: none; cursor: pointer; font-family: 'Barlow Condensed', var(--font-heading-family), sans-serif; font-size: 21px; font-weight: 600; line-height: 1.2; }
.siwak-faq__question::-webkit-details-marker { display: none; }
.siwak-faq__question::marker { content: ''; }
.siwak-faq__question > span:first-child { min-width: 0; overflow-wrap: break-word; }
.siwak-faq__question:focus-visible { outline: 2px solid #e52219; outline-offset: 4px; border-radius: 40px; }
.siwak-faq__toggle { position: relative; flex: 0 0 32px; width: 32px; height: 32px; border-radius: 50%; background: #e52219; box-shadow: 0 3px 0 #af2018; }
.siwak-faq__toggle::before, .siwak-faq__toggle::after { content: ''; position: absolute; inset: 15px 9px; border-radius: 2px; background: #fff; }
.siwak-faq__toggle::after { inset: 9px 15px; transition: transform 160ms; }
.siwak-faq__item[open] .siwak-faq__toggle::after { transform: scaleY(0); }
.siwak-faq__answer { max-width: 780px; padding: 0 66px 20px 24px; color: #57534e; font-family: Inter, var(--font-body-family), sans-serif; font-size: 15px; line-height: 1.65; overflow-wrap: anywhere; }
.siwak-faq__answer p { margin: 0; }
.siwak-faq__answer p + p { margin-top: 12px; }
.siwak-faq__answer strong { color: #171717; }
@media (max-width: 749px) {
  .siwak-faq { padding: 32px 20px; }
  .siwak-faq__title { font-size: 36px; text-align: left; margin-bottom: 20px; }
  .siwak-faq__items { gap: 10px; }
  .siwak-faq__question { min-height: 62px; gap: 12px; padding: 13px 15px 13px 18px; font-size: 18px; }
  .siwak-faq__answer { padding: 0 18px 18px; font-size: 14px; }
}
@media (prefers-reduced-motion: reduce) {
  .siwak-faq__item, .siwak-faq__toggle::after { transition: none; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Siwak — FAQ",
  "max_blocks": 7,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Questions fréquentes"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
