<section class="optiz-potential optiz-potential--{{ section.id }}">
  <div class="optiz-potential__inner page-width">
    <header class="optiz-potential__header">
      <p>{{ section.settings.eyebrow | escape }}</p>
      <h2>{{ section.settings.heading | escape }}</h2>
    </header>

    <div class="optiz-potential__chain" role="list">
      {% for block in section.blocks %}
        <div class="optiz-potential__step" role="listitem" {{ block.shopify_attributes }}>
          <span class="optiz-potential__number" aria-hidden="true">{{ forloop.index }}</span>
          <strong>{{ block.settings.heading | escape }}</strong>
          {% if block.settings.text != blank %}<span>{{ block.settings.text | escape }}</span>{% endif %}
        </div>
        {% unless forloop.last %}<span class="optiz-potential__connector" aria-hidden="true">→</span>{% endunless %}
      {% endfor %}
    </div>

    {% if section.settings.note != blank %}
      <div class="optiz-potential__note rte">{{ section.settings.note }}</div>
    {% endif %}
  </div>
</section>

{% style %}
  .optiz-potential--{{ section.id }} {
    --optiz-red: #e52219;
    --optiz-paper: #f4f0e8;
    padding: clamp(66px, 8vw, 112px) 0;
    background: #212121;
    color: #fff;
    overflow: hidden;
  }

  .optiz-potential--{{ section.id }} .optiz-potential__inner {
    padding-inline: clamp(20px, 4vw, 64px);
  }

  .optiz-potential--{{ section.id }} .optiz-potential__header {
    display: grid;
    grid-template-columns: 210px minmax(0, 1fr);
    gap: 24px;
    align-items: start;
    margin-bottom: clamp(40px, 6vw, 70px);
  }

  .optiz-potential--{{ section.id }} .optiz-potential__header p {
    margin: 8px 0 0;
    color: var(--optiz-red);
    font-family: var(--font-subheading--family);
    font-weight: 600;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .optiz-potential--{{ section.id }} h2 {
    margin: 0;
    max-width: 950px;
    font-family: var(--font-heading--family);
    font-size: clamp(3rem, 6vw, 6.4rem);
    line-height: .9;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .optiz-potential--{{ section.id }} .optiz-potential__chain {
    display: grid;
    grid-template-columns: repeat({{ section.blocks.size | at_least: 1 | times: 2 | minus: 1 }}, auto);
    align-items: stretch;
    overflow-x: auto;
    padding: 8px 5px 18px;
    scrollbar-width: thin;
  }

  .optiz-potential--{{ section.id }} .optiz-potential__step {
    position: relative;
    width: clamp(220px, 21vw, 290px);
    min-height: 210px;
    padding: 54px 20px 22px;
    border: 2px solid var(--optiz-paper);
    background: var(--optiz-paper);
    color: #212121;
    box-shadow: 6px 6px 0 var(--optiz-red);
  }

  .optiz-potential--{{ section.id }} .optiz-potential__step:nth-of-type(even) {
    background: var(--optiz-red);
    color: #fff;
    box-shadow: 6px 6px 0 var(--optiz-paper);
  }

  .optiz-potential--{{ section.id }} .optiz-potential__number {
    position: absolute;
    top: 14px;
    right: 16px;
    font-family: var(--font-heading--family);
    font-size: 2.2rem;
    line-height: 1;
    opacity: .42;
  }

  .optiz-potential--{{ section.id }} .optiz-potential__step strong {
    display: block;
    font-family: var(--font-heading--family);
    font-size: clamp(1.8rem, 2.8vw, 2.7rem);
    line-height: .98;
    text-transform: uppercase;
  }

  .optiz-potential--{{ section.id }} .optiz-potential__step > span:last-child {
    display: block;
    margin-top: 16px;
    font-size: .96rem;
    line-height: 1.4;
  }

  .optiz-potential--{{ section.id }} .optiz-potential__connector {
    display: grid;
    place-items: center;
    width: clamp(54px, 6vw, 94px);
    color: var(--optiz-red);
    font-size: 2.8rem;
    font-weight: 800;
  }

  .optiz-potential--{{ section.id }} .optiz-potential__note {
    max-width: 820px;
    margin: 32px 0 0 auto;
    padding-left: 18px;
    border-left: 4px solid var(--optiz-red);
    color: rgba(255, 255, 255, .78);
    line-height: 1.55;
  }

  .optiz-potential--{{ section.id }} .optiz-potential__note p { margin: 0; }

  @media (max-width: 749px) {
    .optiz-potential--{{ section.id }} .optiz-potential__header { grid-template-columns: 1fr; gap: 8px; }
    .optiz-potential--{{ section.id }} .optiz-potential__chain {
      grid-auto-flow: row;
      grid-template-columns: 1fr;
      overflow: visible;
      padding: 6px;
    }
    .optiz-potential--{{ section.id }} .optiz-potential__step { width: 100%; min-height: 170px; }
    .optiz-potential--{{ section.id }} .optiz-potential__connector {
      width: 100%;
      height: 62px;
      transform: rotate(90deg);
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Optiz — Schéma potentiel",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "L’effet cumulé" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Ton environnement influence ton potentiel." },
    { "type": "richtext", "id": "note", "label": "Note", "default": "<p>L’équilibre hormonal participe notamment à l’énergie, à la concentration, à la composition corporelle et aux performances. Les effets varient selon les personnes et leur environnement global.</p>" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Étape",
      "settings": [
        { "type": "text", "id": "heading", "label": "Titre", "default": "Moins d’exposition inutile" },
        { "type": "text", "id": "text", "label": "Précision", "default": "Réduire la place des substances et matières que tu veux éviter." }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Optiz — Schéma potentiel",
      "blocks": [
        { "type": "step", "settings": { "heading": "Moins d’exposition inutile", "text": "Réduire la place des substances et matières que tu veux éviter." } },
        { "type": "step", "settings": { "heading": "Préserver son équilibre", "text": "Faire des choix plus cohérents avec son corps." } },
        { "type": "step", "settings": { "heading": "Plus d’énergie disponible", "text": "L’équilibre hormonal joue un rôle dans la vitalité." } },
        { "type": "step", "settings": { "heading": "Performance · apparence · focus", "text": "Plus de ressources pour s’entraîner, travailler et avancer." } }
      ]
    }
  ]
}
{% endschema %}
