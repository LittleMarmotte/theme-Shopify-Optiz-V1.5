{% comment %}
  Section : Optiz Men Blade
  Description : Section immersive rouge/noir avec animation et 3D — adaptée à ton univers cosmétique masculin.
  Auteur : ChatGPT (2025)
{% endcomment %}

<section id="optiz-men-blade" class="optiz">
  <style>
    .optiz{
      --red: {{ section.settings.main_color }};
      --blk:#212121; --bg:#0f0f10; --white:#f6f6f6;
      font-family: system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial;
      color:var(--white); background:var(--bg); position:relative; isolate:isolate;
      overflow:hidden; border-radius:20px; 
      box-shadow: 0 20px 60px rgba(0,0,0,.35);
    }
    .optiz .wrap{max-width:1100px;margin:auto;padding:clamp(18px,4vw,48px);position:relative;z-index:2}
    .optiz::before{
      content:""; position:absolute; inset:-20% -10%;
      background:
        radial-gradient(1200px 600px at 80% -10%, rgba(255,0,0,.18), transparent 60%),
        radial-gradient(800px 400px at 10% 110%, rgba(255,0,0,.25), transparent 60%),
        repeating-linear-gradient(135deg, rgba(255,255,255,.04) 0 2px, transparent 2px 16px);
      animation: bgshift 16s linear infinite;
      z-index:0;
    }
    @keyframes bgshift { 0%{transform:translate3d(0,0,0) rotate(0deg)} 100%{transform:translate3d(-4%,2%,0) rotate(.5deg)} }

    .optiz .blade{
      position:absolute; inset:auto -10% 40% -10%; height:16rem; z-index:1;
      background:linear-gradient( to bottom, rgba(255,0,0,.0), rgba(255,0,0,.2) 40%, rgba(255,0,0,.0));
      mask: linear-gradient( to bottom, transparent 0, black 18%, black 82%, transparent 100%);
      transform: skewY(-6deg) translateY(30%) scale(1.1); opacity:.0;
    }
    .optiz.in .blade{ animation: sliceIn .9s cubic-bezier(.2,.9,.2,1) forwards }
    .optiz.out .blade{ animation: sliceOut .5s ease forwards }
    @keyframes sliceIn { 0%{opacity:0; transform:skewY(-6deg) translateY(40%) scale(1.08)} 100%{opacity:1; transform:skewY(-6deg) translateY(0%) scale(1.08)} }
    @keyframes sliceOut { to{opacity:0; transform:skewY(-6deg) translateY(-40%) scale(1.08)} }

    .optiz h2{
      margin:0 0 .6rem; letter-spacing:.02em; font-weight:900; line-height:1;
      font-size: clamp(28px, 6vw, 68px); text-transform:uppercase;
      background: linear-gradient( to right, var(--white), #ddd 40%, var(--red) 60% );
      -webkit-background-clip: text; background-clip:text; color:transparent;
      filter: drop-shadow(0 6px 24px rgba(255,0,0,.18));
    }
    .optiz .kicker{
      display:inline-block; font-size:clamp(12px,1.6vw,14px); 
      background:linear-gradient(90deg, var(--red), #b30000);
      color:#fff; padding:.35rem .6rem; border-radius:999px; font-weight:700; letter-spacing:.12em;
      text-transform:uppercase; margin-bottom:10px;
    }
    .optiz p.lead{ color:#e9e9e9; font-size:clamp(14px,2.2vw,18px); line-height:1.6; max-width:70ch; margin:.4rem 0 1.1rem }
    .optiz .features{ display:grid; gap:10px; grid-template-columns:repeat(2,minmax(0,1fr)); margin:18px 0 24px }
    @media (max-width:720px){ .optiz .features{ grid-template-columns:1fr } }
    .optiz .feat{ display:flex; align-items:center; gap:10px; background:#141416; border:1px solid rgba(255,255,255,.06);
      padding:10px 12px; border-radius:14px; transition: transform .2s ease, border-color .2s ease;}
    .optiz .feat:hover{ transform: translateY(-2px); border-color: rgba(255,0,0,.45) }
    .optiz .feat svg{ width:22px; height:22px; flex:0 0 22px; }
    .optiz .feat span{ font-weight:700; color:#f5f5f5 }
    .optiz .feat small{ display:block; color:#bfbfbf; font-weight:500 }
    .optiz .cta{ display:flex; gap:12px; flex-wrap:wrap; align-items:center; }
    .optiz .btn{
      border:none; cursor:pointer; font-weight:900; letter-spacing:.04em;
      text-transform:uppercase; padding:14px 18px; border-radius:14px; position:relative;
      transition: transform .15s ease;
    }
    .optiz .btn-primary{ background:linear-gradient(90deg, var(--red), #b30000); color:#fff; }
    .optiz .btn-ghost{ background:#161616; color:#fff; border:1px solid rgba(255,255,255,.12) }
    .optiz .grid{ display:grid; gap:clamp(16px,3vw,32px); grid-template-columns: 1.2fr .8fr; align-items:center; }
    @media (max-width:960px){ .optiz .grid{ grid-template-columns:1fr } }
    .optiz .card{ background: conic-gradient(from 180deg at 50% 50%, #121214, #17171b, #121214);
      border:1px solid rgba(255,255,255,.08); border-radius:20px;
      padding:18px; perspective:1000px; transform-style:preserve-3d; position:relative; overflow:hidden;
    }
    .optiz .card::after{
      content:""; position:absolute; inset:-40% -10% auto -10%; height:80%;
      background: linear-gradient( to right, rgba(255,0,0,.0), rgba(255,0,0,.25), rgba(255,0,0,.0) );
      transform: rotate(10deg) translateY(-10%);
      animation: shine 2.4s ease-in-out infinite; opacity:.5;
    }
    @keyframes shine { 0%,100%{transform:rotate(10deg) translateY(-10%)} 50%{transform:rotate(10deg) translateY(40%)} }
    .optiz .chips{ display:flex; flex-wrap:wrap; gap:8px; margin-top:6px }
    .optiz .chip{ display:inline-flex; align-items:center; gap:8px; padding:8px 10px; border-radius:999px;
      background:#0f0f11; border:1px solid rgba(255,255,255,.08); font-weight:700; font-size:13px;}
    .optiz [data-reveal] .line{ display:inline-block; transform:translateY(110%); }
    .optiz.in [data-reveal] .line{ animation: rise .7s cubic-bezier(.2,.9,.2,1) forwards; }
    .optiz.out [data-reveal] .line{ animation: drop .35s ease forwards; }
    @keyframes rise{ to{ transform:translateY(0) } }
    @keyframes drop{ to{ transform:translateY(110%) } }
  </style>

  <div class="blade"></div>
  <div class="wrap">
    <div class="grid">
      <div>
        <span class="kicker">{{ section.settings.kicker }}</span>
        <h2>
          <span data-reveal>
            <span class="line">{{ section.settings.title_line1 }}</span><br>
            <span class="line">{{ section.settings.title_line2 }}</span><br>
            <span class="line">{{ section.settings.title_line3 }}</span>
          </span>
        </h2>
        <p class="lead">{{ section.settings.description }}</p>

        <div class="cta">
          <a href="{{ section.settings.primary_link }}" class="btn btn-primary">{{ section.settings.primary_label }}</a>
          <a href="{{ section.settings.secondary_link }}" class="btn btn-ghost">{{ section.settings.secondary_label }}</a>
        </div>
      </div>

      <div class="card" id="optiz-card">
        <div class="chips">
          {% for item in section.blocks %}
            <span class="chip">{{ item.settings.text }}</span>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>

  <script>
    (function(){
      const root = document.currentScript.closest('.optiz');
      const reveal = root.querySelector('[data-reveal]');
      reveal.innerHTML = reveal.innerHTML.replace(/([^\n<][^<]*)/g, '<span class="line">$1</span>');

      const io = new IntersectionObserver((entries)=>{
        entries.forEach(entry=>{
          if(entry.isIntersecting){
            root.classList.remove('out');
            root.classList.add('in');
          }else{
            root.classList.remove('in');
            root.classList.add('out');
          }
        });
      }, {threshold: .35});
      io.observe(root);

      const card = root.querySelector('#optiz-card');
      let rAF = null;
      function tilt(e){
        const rect = card.getBoundingClientRect();
        const x = (e.clientX - rect.left) / rect.width - .5;
        const y = (e.clientY - rect.top) / rect.height - .5;
        cancelAnimationFrame(rAF);
        rAF = requestAnimationFrame(()=>{
          card.style.transform = `rotateX(${(-y*6).toFixed(2)}deg) rotateY(${(x*8).toFixed(2)}deg) translateZ(0)`;
        });
      }
      card.addEventListener('mousemove', tilt);
      card.addEventListener('mouseleave', ()=>{ card.style.transform = 'rotateX(0) rotateY(0)'; });
    })();
  </script>
</section>

{% schema %}
{
  "name": "Optiz Men Blade",
  "settings": [
    {
      "type": "color",
      "id": "main_color",
      "label": "Couleur principale",
      "default": "#FF0000"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Sous-titre",
      "default": "Hygiène & Style masculins"
    },
    {
      "type": "text",
      "id": "title_line1",
      "label": "Titre ligne 1",
      "default": "OPTIZ MEN"
    },
    {
      "type": "text",
      "id": "title_line2",
      "label": "Titre ligne 2",
      "default": "RED // BLACK"
    },
    {
      "type": "text",
      "id": "title_line3",
      "label": "Titre ligne 3",
      "default": "HYGIÈNE PUISSANTE"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Des essentiels de soin pensés 100 % pour les hommes : savon corps, siwak, ghassoul marocain, mastic de Chios et dentifrice au charbon actif. Zéro superflu, tout pour un corps net, ferme et propre."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Texte du bouton principal",
      "default": "Voir les essentiels"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Lien du bouton principal"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Texte du second bouton",
      "default": "Découvrir la philosophie"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Lien du second bouton"
    }
  ],
  "blocks": [
    {
      "type": "chip",
      "name": "Étiquette produit",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texte de l’étiquette",
          "default": "Savon corps"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Optiz Men Blade",
      "category": "Accueil"
    }
  ]
}
{% endschema %}
