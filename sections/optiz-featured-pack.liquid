{% liquid
  assign featured_product = section.settings.product
  assign pack_link = section.settings.button_link
  if pack_link == blank and featured_product != blank
    assign pack_link = featured_product.url
  endif
  if pack_link == blank
    assign pack_link = routes.all_products_collection_url
  endif
%}

<section class="optiz-pack optiz-pack--{{ section.id }}">
  <div class="optiz-pack__inner page-width">
    <div class="optiz-pack__visual">
      <span class="optiz-pack__stamp">{{ section.settings.stamp | escape }}</span>
      {% if featured_product != blank and featured_product.featured_image != blank %}
        {{ featured_product.featured_image | image_url: width: 1100 | image_tag:
          widths: '400, 600, 800, 1100',
          sizes: '(min-width: 750px) 48vw, 100vw',
          loading: 'lazy',
          alt: featured_product.featured_image.alt | default: featured_product.title,
          class: 'optiz-pack__image'
        }}
      {% elsif section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 1100 | image_tag:
          widths: '400, 600, 800, 1100',
          sizes: '(min-width: 750px) 48vw, 100vw',
          loading: 'lazy',
          class: 'optiz-pack__image'
        }}
      {% else %}
        {{ 'product-1' | placeholder_svg_tag: 'optiz-pack__placeholder' }}
      {% endif %}
    </div>

    <div class="optiz-pack__copy">
      <p class="optiz-pack__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h2>{{ section.settings.heading | escape }}</h2>
      {% if section.settings.text != blank %}<div class="optiz-pack__text rte">{{ section.settings.text }}</div>{% endif %}

      {% if section.blocks.size > 0 %}
        <ul class="optiz-pack__list" role="list">
          {% for block in section.blocks %}
            <li {{ block.shopify_attributes }}><span aria-hidden="true">✓</span>{{ block.settings.text | escape }}</li>
          {% endfor %}
        </ul>
      {% endif %}

      {% if featured_product != blank %}
        <div class="optiz-pack__price">
          <span>{{ featured_product.price | money }}</span>
          {% if featured_product.compare_at_price > featured_product.price %}
            <s>{{ featured_product.compare_at_price | money }}</s>
          {% endif %}
        </div>
      {% endif %}

      <a class="optiz-pack__button" href="{{ pack_link }}">{{ section.settings.button_label | escape }}</a>
    </div>
  </div>
</section>

{% style %}
  .optiz-pack--{{ section.id }} {
    --optiz-red: #e52219;
    --optiz-ink: #212121;
    --optiz-paper: #f4f0e8;
    padding: clamp(66px, 8vw, 112px) 0;
    background: var(--optiz-red);
    color: #fff;
  }
  .optiz-pack--{{ section.id }} .optiz-pack__inner {
    padding-inline: clamp(20px, 4vw, 64px);
  }
  .optiz-pack--{{ section.id }} .optiz-pack__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, .92fr);
    gap: clamp(34px, 6vw, 86px);
    align-items: center;
  }
  .optiz-pack--{{ section.id }} .optiz-pack__visual {
    position: relative;
    min-height: 480px;
    display: grid;
    place-items: center;
    padding: clamp(20px, 4vw, 52px);
    border: 3px solid var(--optiz-ink);
    background: var(--optiz-paper);
    box-shadow: 12px 12px 0 var(--optiz-ink);
  }
  .optiz-pack--{{ section.id }} .optiz-pack__image,
  .optiz-pack--{{ section.id }} .optiz-pack__placeholder {
    width: 100%;
    max-height: 570px;
    object-fit: contain;
  }
  .optiz-pack--{{ section.id }} .optiz-pack__stamp {
    position: absolute;
    z-index: 1;
    top: 16px;
    left: -10px;
    padding: 9px 15px;
    border: 2px solid var(--optiz-ink);
    background: var(--optiz-ink);
    color: #fff;
    font-family: var(--font-subheading--family);
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    transform: rotate(-2deg);
  }
  .optiz-pack--{{ section.id }} .optiz-pack__eyebrow {
    margin: 0 0 12px;
    color: var(--optiz-ink);
    font-family: var(--font-subheading--family);
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .optiz-pack--{{ section.id }} h2 {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(3.2rem, 6vw, 6.4rem);
    line-height: .88;
    text-transform: uppercase;
    text-wrap: balance;
  }
  .optiz-pack--{{ section.id }} .optiz-pack__text {
    margin-top: 22px;
    max-width: 54ch;
    font-size: 1.08rem;
    line-height: 1.55;
  }
  .optiz-pack--{{ section.id }} .optiz-pack__text p { margin: 0; }
  .optiz-pack--{{ section.id }} .optiz-pack__list {
    display: grid;
    gap: 0;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid rgba(255,255,255,.72);
  }
  .optiz-pack--{{ section.id }} .optiz-pack__list li {
    display: grid;
    grid-template-columns: 24px 1fr;
    gap: 10px;
    padding: 13px 0;
    border-bottom: 1px solid rgba(255,255,255,.72);
  }
  .optiz-pack--{{ section.id }} .optiz-pack__list li span { color: var(--optiz-ink); font-weight: 900; }
  .optiz-pack--{{ section.id }} .optiz-pack__price {
    display: flex;
    gap: 14px;
    align-items: baseline;
    margin-top: 24px;
    font-family: var(--font-heading--family);
    font-size: 2.6rem;
    font-weight: 700;
  }
  .optiz-pack--{{ section.id }} .optiz-pack__price s { font-size: 1.3rem; opacity: .7; }
  .optiz-pack--{{ section.id }} .optiz-pack__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 54px;
    margin-top: 26px;
    padding: 14px 22px;
    border: 2px solid var(--optiz-ink);
    background: var(--optiz-ink);
    box-shadow: 6px 6px 0 #fff;
    color: #fff;
    font-family: var(--font-accent--family);
    font-weight: 700;
    text-transform: uppercase;
    text-decoration: none;
    transition: transform .16s ease, box-shadow .16s ease;
  }
  .optiz-pack--{{ section.id }} .optiz-pack__button:hover { transform: translate(2px, 2px); box-shadow: 4px 4px 0 #fff; }
  .optiz-pack--{{ section.id }} .optiz-pack__button:focus-visible { outline: 3px solid #fff; outline-offset: 4px; }
  @media (max-width: 749px) {
    .optiz-pack--{{ section.id }} .optiz-pack__inner { grid-template-columns: 1fr; }
    .optiz-pack--{{ section.id }} .optiz-pack__visual { min-height: 340px; box-shadow: 8px 8px 0 var(--optiz-ink); }
    .optiz-pack--{{ section.id }} .optiz-pack__button { width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .optiz-pack--{{ section.id }} .optiz-pack__button { transition: none; }
  }
{% endstyle %}

{% schema %}
{
  "name": "Optiz — Pack vedette",
  "settings": [
    { "type": "product", "id": "product", "label": "Pack" },
    { "type": "image_picker", "id": "image", "label": "Image de remplacement" },
    { "type": "text", "id": "stamp", "label": "Étiquette", "default": "Commence ici" },
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "La routine essentielle" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Le pack pour changer de routine." },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Une sélection de produits Optiz réunis pour remplacer plusieurs habitudes du quotidien en une seule fois.</p>" },
    { "type": "text", "id": "button_label", "label": "Libellé du bouton", "default": "Remplacer ma routine avec Optiz" },
    { "type": "url", "id": "button_link", "label": "Lien personnalisé" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Point du pack",
      "settings": [{ "type": "text", "id": "text", "label": "Texte", "default": "Plusieurs essentiels réunis dans un seul pack" }]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Optiz — Pack vedette",
      "blocks": [
        { "type": "benefit", "settings": { "text": "Plusieurs essentiels réunis dans un seul pack" } },
        { "type": "benefit", "settings": { "text": "Une façon simple de commencer" } },
        { "type": "benefit", "settings": { "text": "Chaque produit remplace une habitude précise" } }
      ]
    }
  ]
}
{% endschema %}
